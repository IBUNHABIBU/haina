<% content_for :title, "TV Size #{@tv_size.size}\"" %>

<div class="mx-auto max-w-3xl px-4 sm:px-6 lg:px-8 py-8 space-y-6">
  

  <!-- Back link -->
  <div>
    <%= link_to tv_sizes_path, class: "inline-flex items-center gap-1.5 text-sm font-medium text-slate-500 transition hover:text-slate-900" do %>
      <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor">
        <path stroke-linecap="round" stroke-linejoin="round" d="M15.75 19.5 8.25 12l7.5-7.5" />
      </svg>
      Back to TV sizes
    <% end %>
  </div>

  <!-- Header -->
  <div class="flex flex-wrap items-start justify-between gap-4">
    <div class="flex items-start gap-4">
      <div class="flex h-14 w-14 shrink-0 items-center justify-center rounded-xl bg-indigo-100 text-indigo-700">
        <svg class="h-7 w-7" fill="none" viewBox="0 0 24 24" stroke-width="1.8" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" d="M6 20.25h12m-7.5-3v3m3-3v3m-10.125-3h17.25c.621 0 1.125-.504 1.125-1.125V4.875c0-.621-.504-1.125-1.125-1.125H3.375c-.621 0-1.125.504-1.125 1.125v11.25c0 .621.504 1.125 1.125 1.125Z" />
        </svg>
      </div>
      <div>
        <div class="flex items-baseline gap-1.5">
          <h1 class="text-3xl font-semibold tracking-tight text-slate-900">
            <%= @tv_size.size.presence || "—" %>
          </h1>
          <span class="text-lg font-medium text-slate-400">in</span>
        </div>
        <p class="mt-1 text-sm text-slate-500">
          TV screen size configuration.
        </p>
      </div>
    </div>

    <div class="flex flex-wrap items-center gap-2">
      <%= link_to edit_tv_size_path(@tv_size),
          class: "inline-flex items-center gap-1.5 rounded-lg border border-slate-200 bg-white px-4 py-2.5 text-sm font-medium text-slate-700 shadow-sm transition hover:bg-slate-50" do %>
        <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke-width="1.8" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" d="m16.862 4.487 1.687-1.688a1.875 1.875 0 1 1 2.652 2.652L10.582 16.07a4.5 4.5 0 0 1-1.897 1.13L6 18l.8-2.685a4.5 4.5 0 0 1 1.13-1.897l8.932-8.931Z" />
        </svg>
        Edit
      <% end %>
    </div>
  </div>

  <%# ============================================================
      KPI CARDS
      ============================================================ %>
  <div class="grid gap-4 sm:grid-cols-2">
    <!-- Activities count -->
    <div class="rounded-xl border border-slate-200 bg-white p-5 shadow-sm">
      <div class="flex items-center justify-between">
        <p class="text-xs font-medium uppercase tracking-wider text-slate-500">Repair Activities</p>
        <div class="flex h-8 w-8 items-center justify-center rounded-lg bg-amber-50 text-amber-600">
          <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke-width="1.8" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" d="M11.42 15.17 17.25 21A2.652 2.652 0 0 0 21 17.25l-5.877-5.877M11.42 15.17l2.496-3.03c.317-.384.74-.626 1.208-.766M11.42 15.17l-4.655 5.653a2.548 2.548 0 1 1-3.586-3.586l6.837-5.63m5.108-.233c.55-.164 1.163-.188 1.743-.14a4.5 4.5 0 0 0 4.486-6.336l-3.276 3.277a3.004 3.004 0 0 1-2.25-2.25l3.276-3.276a4.5 4.5 0 0 0-6.336 4.486c.091 1.076-.071 2.264-.904 2.95l-.102.085m-1.745 1.437L5.909 7.5H4.5L2.25 3.75l1.5-1.5L7.5 4.5v1.409l4.26 4.26m-1.745 1.437 1.745-1.437m6.615 8.206L15.75 15.75M4.867 19.125h.008v.008h-.008v-.008Z" />
          </svg>
        </div>
      </div>
      <p class="mt-3 text-2xl font-semibold tabular-nums text-slate-900">
        <%= @tv_size.activities.count if @tv_size.respond_to?(:activities) %>
      </p>
      <p class="mt-1 text-xs text-slate-400">Repairs linked to this size</p>
    </div>

    <!-- TV Brands count -->
    <div class="rounded-xl border border-slate-200 bg-white p-5 shadow-sm">
      <div class="flex items-center justify-between">
        <p class="text-xs font-medium uppercase tracking-wider text-slate-500">TV Brands</p>
        <div class="flex h-8 w-8 items-center justify-center rounded-lg bg-blue-50 text-blue-600">
          <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke-width="1.8" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" d="M9.568 3H5.25A2.25 2.25 0 0 0 3 5.25v4.318c0 .597.237 1.17.659 1.591l9.581 9.581c.699.699 1.78.872 2.607.33a18.095 18.095 0 0 0 5.223-5.223c.542-.827.369-1.908-.33-2.607L11.16 3.66A2.25 2.25 0 0 0 9.568 3Z" />
            <path stroke-linecap="round" stroke-linejoin="round" d="M6 6h.008v.008H6V6Z" />
          </svg>
        </div>
      </div>
      <p class="mt-3 text-2xl font-semibold tabular-nums text-slate-900">
        <%= @tv_size.respond_to?(:tv_brands) ? @tv_size.tv_brands.count : 0 %>
      </p>
      <p class="mt-1 text-xs text-slate-400">Brands available in this size</p>
    </div>
  </div>

  <%# ============================================================
      DETAILS
      ============================================================ %>
  <section class="overflow-hidden rounded-xl border border-slate-200 bg-white shadow-sm">
    <header class="flex items-center gap-3 border-b border-slate-100 px-6 py-4">
      <div class="flex h-8 w-8 items-center justify-center rounded-lg bg-slate-100 text-slate-600">
        <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke-width="1.8" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" d="M8.25 6.75h12M8.25 12h12m-12 5.25h12M3.75 6.75h.007v.008H3.75V6.75Zm.375 0a.375.375 0 1 1-.75 0 .375.375 0 0 1 .75 0ZM3.75 12h.007v.008H3.75V12Zm.375 0a.375.375 0 1 1-.75 0 .375.375 0 0 1 .75 0Zm-.375 5.25h.007v.008H3.75v-.008Zm.375 0a.375.375 0 1 1-.75 0 .375.375 0 0 1 .75 0Z" />
        </svg>
      </div>
      <div>
        <h2 class="text-sm font-semibold text-slate-900">Size Details</h2>
        <p class="text-xs text-slate-500">Information about this TV size.</p>
      </div>
    </header>

    <dl class="divide-y divide-slate-100">
      <div class="flex items-center justify-between px-6 py-3.5 text-sm">
        <dt class="text-slate-500">Size</dt>
        <dd class="font-medium tabular-nums text-slate-900">
          <%= @tv_size.size.presence || "—" %>
          <span class="text-slate-400">in</span>
        </dd>
      </div>
      <div class="flex items-center justify-between px-6 py-3.5 text-sm">
        <dt class="text-slate-500">Created</dt>
        <dd class="font-medium text-slate-900">
          <%= @tv_size.created_at.strftime("%d %b %Y") if @tv_size.respond_to?(:created_at) && @tv_size.created_at %>
        </dd>
      </div>
      <div class="flex items-center justify-between px-6 py-3.5 text-sm">
        <dt class="text-slate-500">Last Updated</dt>
        <dd class="font-medium text-slate-900">
          <%= @tv_size.updated_at.strftime("%d %b %Y") if @tv_size.respond_to?(:updated_at) && @tv_size.updated_at %>
        </dd>
      </div>
    </dl>
  </section>

  <%# ============================================================
      DANGER ZONE
      ============================================================ %>
  <% if current_user&.super_admin? %>
    <div class="rounded-xl border border-rose-200 bg-rose-50/40 p-6 shadow-sm">
      <div class="flex flex-wrap items-center justify-between gap-4">
        <div>
          <h2 class="text-sm font-semibold text-rose-800">Delete this TV size</h2>
          <p class="mt-1 text-xs text-rose-600">
            Once deleted, this size will be removed from all activities and prices.
          </p>
        </div>

        <%= button_to @tv_size, method: :delete,
            data: { turbo_confirm: "Are you sure you want to delete this TV size?", turbo_frame: "_top" },
            class: "inline-flex items-center gap-1.5 rounded-lg bg-rose-600 px-4 py-2.5 text-sm font-semibold text-white shadow-sm transition hover:bg-rose-500 cursor-pointer" do %>
          <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke-width="1.8" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" d="m14.74 9-.346 9m-4.788 0L9.26 9m9.968-3.21c.342.052.682.107 1.022.166m-1.022-.165L18.16 19.673a2.25 2.25 0 0 1-2.244 2.077H8.084a2.25 2.25 0 0 1-2.244-2.077L4.772 5.79m14.456 0a48.108 48.108 0 0 0-3.478-.397m-12 .562c.34-.059.68-.114 1.022-.165m0 0a48.11 48.11 0 0 1 3.478-.397m7.5 0v-.916c0-1.18-.91-2.164-2.09-2.201a51.964 51.964 0 0 0-3.32 0c-1.18.037-2.09 1.022-2.09 2.201v.916m7.5 0a48.667 48.667 0 0 0-7.5 0" />
          </svg>
          Delete Size
        <% end %>
      </div>
    </div>
  <% end %>

</div>