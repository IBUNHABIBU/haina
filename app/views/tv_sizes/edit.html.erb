<% content_for :title, "Editing tv size" %>

<div class="md:w-2/3 w-full">
  <h1 class="font-bold text-4xl">Editing tv size</h1>

  <%= render "form", tv_size: @tv_size %>

  <%= link_to "Show this tv size", @tv_size, class: "w-full sm:w-auto text-center mt-2 sm:mt-0 sm:ml-2 rounded-md px-3.5 py-2.5 bg-gray-100 hover:bg-gray-50 inline-block font-medium" %>
  <%= link_to "Back to tv sizes", tv_sizes_path, class: "w-full sm:w-auto text-center mt-2 sm:mt-0 sm:ml-2 rounded-md px-3.5 py-2.5 bg-gray-100 hover:bg-gray-50 inline-block font-medium" %>
</div>
