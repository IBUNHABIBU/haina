<% content_for :title, @customer.name.presence || "Customer Details" %>

<div class="mx-auto max-w-4xl px-4 sm:px-6 lg:px-8 py-8 space-y-6">
  
  <% if notice.present? %>
    <div class="flex items-center gap-2 rounded-lg border border-emerald-200 bg-emerald-50 px-4 py-3 text-sm font-medium text-emerald-700 shadow-sm" id="notice">
      <svg class="h-5 w-5 text-emerald-500" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor">
        <path stroke-linecap="round" stroke-linejoin="round" d="M9 12.75 11.25 15 15 9.75M21 12a9 9 0 1 1-18 0 9 9 0 0 1 18 0Z" />
      </svg>
      <%= notice %>
    </div>
  <% end %>

  <!-- Back link -->
  <div>
    <%= link_to customers_path, class: "inline-flex items-center gap-1.5 text-sm font-medium text-slate-500 transition hover:text-slate-900" do %>
      <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor">
        <path stroke-linecap="round" stroke-linejoin="round" d="M15.75 19.5 8.25 12l7.5-7.5" />
      </svg>
      Back to customers
    <% end %>
  </div>

  <!-- Header -->
  <div class="flex flex-wrap items-start justify-between gap-4">
    <div class="flex items-start gap-4">
      <div class="flex h-14 w-14 shrink-0 items-center justify-center rounded-full bg-indigo-100 text-xl font-bold text-indigo-700 ring-4 ring-white shadow-sm">
        <%= @customer.name.to_s.first&.upcase || "?" %>
      </div>
      <div>
        <h1 class="text-2xl font-semibold tracking-tight text-slate-900"><%= @customer.name %></h1>
        <p class="mt-1 text-sm text-slate-500">
          Customer since
          <span class="font-medium text-slate-700"><%= @customer.created_at.strftime("%B %Y") if @customer.created_at %></span>
        </p>
      </div>
    </div>

    <div class="flex flex-wrap items-center gap-2">
      <%= link_to edit_customer_path(@customer),
          class: "inline-flex items-center gap-1.5 rounded-lg border border-slate-200 bg-white px-4 py-2.5 text-sm font-medium text-slate-700 shadow-sm transition hover:bg-slate-50" do %>
        <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke-width="1.8" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" d="m16.862 4.487 1.687-1.688a1.875 1.875 0 1 1 2.652 2.652L10.582 16.07a4.5 4.5 0 0 1-1.897 1.13L6 18l.8-2.685a4.5 4.5 0 0 1 1.13-1.897l8.932-8.931Z" />
        </svg>
        Edit
      <% end %>
      
      <% if current_user.super_admin? %>
        <%= button_to @customer, method: :delete,
            form_class: "inline-block",
            class: "inline-flex items-center gap-1.5 rounded-lg border border-rose-200 bg-white px-4 py-2.5 text-sm font-medium text-rose-600 shadow-sm transition hover:bg-rose-50 cursor-pointer",
            data: { turbo_confirm: "Are you sure you want to delete this customer?" } do %>
          <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke-width="1.8" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" d="m14.74 9-.346 9m-4.788 0L9.26 9m9.968-3.21c.342.052.682.107 1.022.166m-1.022-.165L18.16 19.673a2.25 2.25 0 0 1-2.244 2.077H8.084a2.25 2.25 0 0 1-2.244-2.077L4.772 5.79m14.456 0a48.108 48.108 0 0 0-3.478-.397m-12 .562c.34-.059.68-.114 1.022-.165m0 0a48.11 48.11 0 0 1 3.478-.397m7.5 0v-.916c0-1.18-.91-2.164-2.09-2.201a51.964 51.964 0 0 0-3.32 0c-1.18.037-2.09 1.022-2.09 2.201v.916m7.5 0a48.667 48.667 0 0 0-7.5 0" />
          </svg>
        <% end %>
      <% end %>
    </div>
  </div>

  <!-- Maelezo (Details) -->
  <div class="grid gap-6 md:grid-cols-3">
    
    <!-- Contact Info -->
    <div class="rounded-xl border border-slate-200 bg-white p-6 shadow-sm md:col-span-2">
      <h2 class="text-sm font-semibold text-slate-900 mb-4 flex items-center gap-2">
        <svg class="h-4 w-4 text-slate-400" fill="none" viewBox="0 0 24 24" stroke-width="1.8" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" d="M15 9h3.75M15 12h3.75M15 15h3.75M4.5 19.5h15a2.25 2.25 0 0 0 2.25-2.25V6.75A2.25 2.25 0 0 0 19.5 4.5h-15a2.25 2.25 0 0 0-2.25 2.25v10.5A2.25 2.25 0 0 0 4.5 19.5Zm6-10.125a1.875 1.875 0 1 1-3.75 0 1.875 1.875 0 0 1 3.75 0Zm1.294 6.336a6.721 6.721 0 0 1-3.17.789 6.721 6.721 0 0 1-3.168-.789 3.376 3.376 0 0 1 6.338 0Z" />
        </svg>
        Contact Details
      </h2>
      
      <dl class="grid grid-cols-1 gap-4 sm:grid-cols-2">
        <div class="rounded-lg bg-slate-50 p-4">
          <dt class="text-[11px] font-semibold uppercase tracking-wider text-slate-500">Phone Number</dt>
          <dd class="mt-1 text-sm font-medium text-slate-900">
            <% if @customer.phone.present? %>
              <a href="tel:<%= @customer.phone %>" class="inline-flex items-center gap-1.5 text-indigo-600 hover:underline">
                <svg class="h-3.5 w-3.5" fill="none" viewBox="0 0 24 24" stroke-width="1.8" stroke="currentColor">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M2.25 6.75c0 8.284 6.716 15 15 15h2.25a2.25 2.25 0 0 0 2.25-2.25v-1.372c0-.516-.351-.966-.852-1.091l-4.423-1.106c-.44-.11-.902.055-1.173.417l-.97 1.293c-2.896-1.596-5.48-4.18-7.076-7.076l1.293-.97c.363-.271.527-.734.417-1.173L6.963 3.102a1.125 1.125 0 0 0-1.091-.852H4.5A2.25 2.25 0 0 0 2.25 4.5v2.25Z" />
                </svg>
                <%= @customer.phone %>
              </a>
            <% else %>
              <span class="text-slate-400 font-normal italic">Not provided</span>
            <% end %>
          </dd>
        </div>

        <div class="rounded-lg bg-slate-50 p-4">
          <dt class="text-[11px] font-semibold uppercase tracking-wider text-slate-500">Location (Mahali)</dt>
          <dd class="mt-1 text-sm font-medium text-slate-900 flex items-center gap-1.5">
            <% if @customer.mahali.present? %>
              <svg class="h-3.5 w-3.5 text-slate-400" fill="none" viewBox="0 0 24 24" stroke-width="1.8" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" d="M15 10.5a3 3 0 1 1-6 0 3 3 0 0 1 6 0Z" />
                <path stroke-linecap="round" stroke-linejoin="round" d="M19.5 10.5c0 7.142-7.5 11.25-7.5 11.25S4.5 17.642 4.5 10.5a7.5 7.5 0 1 1 15 0Z" />
              </svg>
              <%= @customer.mahali %>
            <% else %>
              <span class="text-slate-400 font-normal italic">Not provided</span>
            <% end %>
          </dd>
        </div>
      </dl>
    </div>

    <!-- Quick Stats -->
    <div class="rounded-xl border border-slate-200 bg-white p-6 shadow-sm flex flex-col justify-between">
      <h2 class="text-sm font-semibold text-slate-900 mb-4 flex items-center gap-2">
        <svg class="h-4 w-4 text-slate-400" fill="none" viewBox="0 0 24 24" stroke-width="1.8" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" d="M3 13.125C3 12.504 3.504 12 4.125 12h2.25c.621 0 1.125.504 1.125 1.125v6.75C7.5 20.496 6.996 21 6.375 21h-2.25A1.125 1.125 0 0 1 3 19.875v-6.75ZM9.75 8.625c0-.621.504-1.125 1.125-1.125h2.25c.621 0 1.125.504 1.125 1.125v11.25c0 .621-.504 1.125-1.125 1.125h-2.25a1.125 1.125 0 0 1-1.125-1.125V8.625ZM16.5 4.125c0-.621.504-1.125 1.125-1.125h2.25C20.496 3 21 3.504 21 4.125v15.75c0 .621-.504 1.125-1.125 1.125h-2.25a1.125 1.125 0 0 1-1.125-1.125V4.125Z" />
        </svg>
        Overview
      </h2>
      
      <div class="space-y-4">
        <div>
          <p class="text-3xl font-bold tabular-nums text-slate-900"><%= @customer.activities.count if @customer.respond_to?(:activities) %></p>
          <p class="text-xs text-slate-500 mt-1">Total repair activities</p>
        </div>
        <!-- Unaweza kuongeza total revenue hapa kama una data -->
      </div>

      <div class="mt-6 pt-4 border-t border-slate-100">
        <%= link_to activities_path(customer_id: @customer.id), 
            class: "w-full inline-flex justify-center items-center gap-1.5 rounded-lg bg-indigo-50 px-4 py-2 text-sm font-medium text-indigo-700 transition hover:bg-indigo-100" do %>
          View all activities
          <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" d="M13.5 4.5 21 12m0 0-7.5 7.5M21 12H3" />
          </svg>
        <% end %>
      </div>
    </div>
  </div>

</div>