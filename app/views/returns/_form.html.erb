<%= form_with(model: return, class: "contents") do |form| %>
  <% if return.errors.any? %>
    <div id="error_explanation" class="bg-red-50 text-red-500 px-3 py-2 font-medium rounded-md mt-3">
      <h2><%= pluralize(return.errors.count, "error") %> prohibited this return from being saved:</h2>

      <ul class="list-disc ml-6">
        <% return.errors.each do |error| %>
          <li><%= error.full_message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <div class="my-5">
    <%= form.label :repair_job_id %>
    <%= form.text_field :repair_job_id, class: ["block shadow-sm rounded-md border px-3 py-2 mt-2 w-full", {"border-gray-400 focus:outline-blue-600": return.errors[:repair_job_id].none?, "border-red-400 focus:outline-red-600": return.errors[:repair_job_id].any?}] %>
  </div>

  <div class="my-5">
    <%= form.label :reason %>
    <%= form.text_field :reason, class: ["block shadow-sm rounded-md border px-3 py-2 mt-2 w-full", {"border-gray-400 focus:outline-blue-600": return.errors[:reason].none?, "border-red-400 focus:outline-red-600": return.errors[:reason].any?}] %>
  </div>

  <div class="my-5">
    <%= form.label :remarks %>
    <%= form.textarea :remarks, rows: 4, class: ["block shadow-sm rounded-md border px-3 py-2 mt-2 w-full", {"border-gray-400 focus:outline-blue-600": return.errors[:remarks].none?, "border-red-400 focus:outline-red-600": return.errors[:remarks].any?}] %>
  </div>

  <div class="inline">
    <%= form.submit class: "w-full sm:w-auto rounded-md px-3.5 py-2.5 bg-blue-600 hover:bg-blue-500 text-white inline-block font-medium cursor-pointer" %>
  </div>
<% end %>
