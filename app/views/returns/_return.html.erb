<div id="<%= dom_id return %>" class="w-full sm:w-auto my-5 space-y-5">
  <div>
    <strong class="block font-medium mb-1">Repair job:</strong>
    <%= return.repair_job_id %>
  </div>
  <div>
    <strong class="block font-medium mb-1">Reason:</strong>
    <%= return.reason %>
  </div>
  <div>
    <strong class="block font-medium mb-1">Remarks:</strong>
    <%= return.remarks %>
  </div>
</div>
