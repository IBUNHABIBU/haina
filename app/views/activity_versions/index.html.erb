<div class="max-w-5xl mx-auto px-4 py-6">

  <div class="flex items-center justify-between mb-6">
    <div>
      <h1 class="text-2xl font-bold text-gray-900">
        Edit History
      </h1>

      <p class="text-sm text-gray-500">
        Activity #<%= @activity.id %>
      </p>
    </div>

    <%= link_to "Back to Activity",
                activity_path(@activity),
                class: "px-4 py-2 rounded-lg bg-gray-100 hover:bg-gray-200" %>
  </div>

  <% if @versions.empty? %>

    <div class="bg-white rounded-xl border p-6 text-center">
      <p class="text-gray-500">
        No edits have been recorded for this activity.
      </p>
    </div>

  <% else %>

    <div class="space-y-4">

      <% @versions.each do |version| %>

        <div class="bg-white border rounded-xl p-5 shadow-sm">

          <div class="flex items-center justify-between mb-4">

            <div>
              <p class="font-semibold text-gray-900">
                <%= version.event.humanize %>
              </p>

              <p class="text-sm text-gray-500">
                <%= version.created_at.strftime("%d %b %Y, %H:%M") %>
              </p>
            </div>

            <div class="text-sm text-gray-600">
              User ID:
              <%= version.whodunnit || "System" %>
            </div>

          </div>

          <% changes = version.changeset %>

          <% changes.each do |attribute, values| %>

            <% next if attribute.in?(["updated_at", "created_at"]) %>

            <div class="border-t py-3">

              <p class="font-medium text-gray-700">
                <%= attribute.humanize %>
              </p>

              <div class="flex items-center gap-3 mt-1">

                <span class="px-3 py-1 rounded-lg bg-red-50 text-red-700">
                  <%= values[0].presence || "Empty" %>
                </span>

                <span class="text-gray-400">
                  →
                </span>

                <span class="px-3 py-1 rounded-lg bg-green-50 text-green-700">
                  <%= values[1].presence || "Empty" %>
                </span>

              </div>

            </div>

          <% end %>

        </div>

      <% end %>

    </div>

  <% end %>

</div>