<% content_for :title, "Showing tv brand" %>

<div class="md:w-2/3 w-full">
  
  <h1 class="font-bold text-4xl mb-6">Showing tv brand</h1>

  <div class="mb-6">
    <%= render @tv_brand %>
  </div>

  <div class="flex flex-wrap items-center gap-3">
    <%= link_to "Edit this tv brand", edit_tv_brand_path(@tv_brand), class: "w-full sm:w-auto text-center rounded-lg bg-indigo-600 px-4 py-2.5 text-sm font-semibold text-white shadow-sm hover:bg-indigo-500 transition inline-block font-medium" %>
    
    <%= link_to "Back to tv brands", tv_brands_path, class: "w-full sm:w-auto text-center mt-2 sm:mt-0 rounded-lg border border-slate-200 bg-white px-4 py-2.5 text-sm font-medium text-slate-700 shadow-sm hover:bg-slate-50 transition inline-block" %>
    
    <%= button_to "Destroy this tv brand", @tv_brand, method: :delete, form_class: "sm:inline-block mt-2 sm:mt-0", class: "w-full rounded-lg border border-rose-200 bg-white px-4 py-2.5 text-sm font-medium text-rose-600 shadow-sm hover:bg-rose-50 transition cursor-pointer", data: { turbo_confirm: "Are you sure?" } %>
  </div>
</div>