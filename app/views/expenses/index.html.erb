<% content_for :title, "Expenses" %>

<div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8 py-8 space-y-6">
 
  <!-- Page header -->
  <div class="flex flex-wrap items-end justify-between gap-4">
    <div>
      <h1 class="text-2xl font-semibold tracking-tight text-slate-900">Expenses</h1>
      <div class="mt-1 flex flex-wrap items-center gap-x-2 gap-y-1 text-sm text-slate-500">
        <span><%= pluralize(@expenses.size, "record") %></span>
        <span class="text-slate-300">·</span>
        <span>Electricity, rent, spares and other operating costs.</span>
      </div>
    </div>

    <div class="flex items-center gap-2">
      <%= link_to new_expense_path,
          class: "inline-flex items-center gap-1.5 rounded-lg bg-indigo-600 px-4 py-2.5 text-sm font-semibold text-white shadow-sm transition hover:bg-indigo-500 focus:outline-none focus:ring-2 focus:ring-indigo-500 focus:ring-offset-2" do %>
        <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" d="M12 4.5v15m7.5-7.5h-15" />
        </svg>
        Record Expense
      <% end %>
    </div>
  </div>

  <%# ============================================================
      FILTER BAR
      ============================================================ %>
  <div class="rounded-xl border border-slate-200 bg-white p-4 shadow-sm space-y-4">
    
    <!-- Quick Filters (Pills) -->
    <div class="flex flex-wrap items-center gap-2">
      <span class="text-sm font-medium text-slate-500 mr-2">Quick filters:</span>
      
      <!-- All Time -->
      <%= link_to "All Time", expenses_path, 
          data: { turbo_frame: "expenses_list", turbo_action: "advance" },
          class: "rounded-full border px-3.5 py-1.5 text-sm font-medium transition #{params[:filter].blank? && params[:month].blank? && params[:category].blank? ? 'bg-indigo-600 border-indigo-600 text-white shadow-sm' : 'bg-white border-slate-200 text-slate-600 hover:bg-slate-50'}" %>

      <!-- Q1 -->
      <%= link_to "Q1", expenses_path(filter: 'q1'), 
          data: { turbo_frame: "expenses_list", turbo_action: "advance" },
          class: "rounded-full border px-3.5 py-1.5 text-sm font-medium transition #{params[:filter] == 'q1' ? 'bg-indigo-600 border-indigo-600 text-white shadow-sm' : 'bg-white border-slate-200 text-slate-600 hover:bg-slate-50'}" %>

      <!-- Q2 -->
      <%= link_to "Q2", expenses_path(filter: 'q2'), 
          data: { turbo_frame: "expenses_list", turbo_action: "advance" },
          class: "rounded-full border px-3.5 py-1.5 text-sm font-medium transition #{params[:filter] == 'q2' ? 'bg-indigo-600 border-indigo-600 text-white shadow-sm' : 'bg-white border-slate-200 text-slate-600 hover:bg-slate-50'}" %>

      <!-- Q3 -->
      <%= link_to "Q3", expenses_path(filter: 'q3'), 
          data: { turbo_frame: "expenses_list", turbo_action: "advance" },
          class: "rounded-full border px-3.5 py-1.5 text-sm font-medium transition #{params[:filter] == 'q3' ? 'bg-indigo-600 border-indigo-600 text-white shadow-sm' : 'bg-white border-slate-200 text-slate-600 hover:bg-slate-50'}" %>

      <!-- Q4 -->
      <%= link_to "Q4", expenses_path(filter: 'q4'), 
          data: { turbo_frame: "expenses_list", turbo_action: "advance" },
          class: "rounded-full border px-3.5 py-1.5 text-sm font-medium transition #{params[:filter] == 'q4' ? 'bg-indigo-600 border-indigo-600 text-white shadow-sm' : 'bg-white border-slate-200 text-slate-600 hover:bg-slate-50'}" %>

      <!-- This Year -->
      <%= link_to "This Year", expenses_path(filter: 'this_year'), 
          data: { turbo_frame: "expenses_list", turbo_action: "advance" },
          class: "rounded-full border px-3.5 py-1.5 text-sm font-medium transition #{params[:filter] == 'this_year' ? 'bg-indigo-600 border-indigo-600 text-white shadow-sm' : 'bg-white border-slate-200 text-slate-600 hover:bg-slate-50'}" %>
    </div>

    <hr class="border-slate-100">

    <!-- Advanced Filters (Month + Category) -->
    <%= form_with url: expenses_path, method: :get, 
        data: { 
          controller: "search",
          turbo_frame: "expenses_list", 
          turbo_action: "advance",
          action: "change->search#submit"
        }, 
        class: "flex flex-wrap items-center gap-3" do |f| %>

      <!-- Month -->
      <div class="flex items-center gap-2">
        <label class="text-sm text-slate-500">Month:</label>
        <%= f.month_field :month, 
            value: params[:month], 
            class: "block rounded-lg border border-slate-200 bg-white px-3 py-1.5 text-sm text-slate-900 shadow-sm focus:border-indigo-500 focus:ring-indigo-500/20" %>
      </div>

      <!-- Category -->
      <div class="flex items-center gap-2">
        <label class="text-sm text-slate-500">Category:</label>
        <%= f.select :category, 
            options_for_select(@categories.map { |c| [c.humanize, c] }, params[:category]), 
            { include_blank: "All Categories" }, 
            class: "block rounded-lg border border-slate-200 bg-white px-3 py-1.5 text-sm text-slate-900 shadow-sm focus:border-indigo-500 focus:ring-indigo-500/20" %>
      </div>

      <!-- Clear All -->
      <% if params[:month].present? || params[:category].present? || params[:filter].present? %>
        <%= link_to "Clear All", expenses_path, 
            data: { turbo_frame: "expenses_list", turbo_action: "advance" },
            class: "text-sm font-medium text-indigo-600 hover:text-indigo-800 ml-auto" %>
      <% end %>
    <% end %>
  </div>

  <%# ============================================================
      TURBO FRAME: KPI + TABLE
      ============================================================ %>
  <%= turbo_frame_tag "expenses_list" do %>
    <%= render "expenses/list", expenses: @expenses %>
  <% end %>

</div>