<div class="mx-auto max-w-7xl"><div class="mb-6 flex flex-wrap items-center justify-between gap-3"><div><h1 class="text-2xl font-bold">Expenses</h1><p class="text-slate-500">Electricity, rent, spares and other operating costs.</p></div><%= link_to "Record Expense", new_expense_path, class: "rounded-lg bg-blue-600 px-4 py-2.5 font-medium text-white" %></div><div class="overflow-x-auto rounded-xl border bg-white shadow-sm"><table class="min-w-full divide-y"><thead class="bg-slate-50"><tr><th class="px-4 py-3 text-left text-xs uppercase">Date</th><th class="px-4 py-3 text-left text-xs uppercase">Category</th><th class="px-4 py-3 text-left text-xs uppercase">Description</th><th class="px-4 py-3 text-right text-xs uppercase">Amount</th><th></th></tr></thead><tbody class="divide-y"><% @expenses.each do |expense| %><tr><td class="px-4 py-3"><%= expense.spent_on %></td><td class="px-4 py-3"><%= expense.category.humanize %></td><td class="px-4 py-3"><%= expense.description %></td><td class="px-4 py-3 text-right font-semibold"><%= number_to_currency(expense.amount, unit: "TSh ", precision: 0) %></td><td class="px-4 py-3 text-right"><%= link_to "Edit", edit_expense_path(expense), class: "text-blue-600" %></td></tr><% end %></tbody></table></div></div>
