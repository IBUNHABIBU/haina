<% content_for :title, "Expenses" %>

<div class="grid gap-4 sm:grid-cols-2 lg:grid-cols-4">
  <!-- Total expenses -->
  <div class="rounded-xl border border-slate-200 bg-white p-5 shadow-sm">
    <div class="flex items-center justify-between">
      <p class="text-xs font-medium uppercase tracking-wider text-slate-500">Total</p>
      <div class="flex h-8 w-8 items-center justify-center rounded-lg bg-indigo-50 text-indigo-600">
        <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke-width="1.8" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" d="M2.25 8.25h19.5M2.25 9h19.5m-16.5 5.25h6m-6 2.25h3m-3.75 3h15a2.25 2.25 0 0 0 2.25-2.25V6.75A2.25 2.25 0 0 0 19.5 4.5h-15a2.25 2.25 0 0 0-2.25 2.25v10.5A2.25 2.25 0 0 0 4.5 19.5Z" />
        </svg>
      </div>
    </div>
    <p class="mt-3 text-2xl font-semibold tabular-nums text-slate-900">
      <%= number_to_currency(@expenses.sum(&:amount), unit: "TSh ", precision: 0) %>
    </p>
    <p class="mt-1 text-xs text-slate-400">All recorded expenses</p>
  </div>

  <!-- This month -->
  <% this_month = @expenses.select { |e| e.spent_on && e.spent_on.month == Date.today.month && e.spent_on.year == Date.today.year } %>
  <div class="rounded-xl border border-slate-200 bg-white p-5 shadow-sm">
    <div class="flex items-center justify-between">
      <p class="text-xs font-medium uppercase tracking-wider text-slate-500">This month</p>
      <div class="flex h-8 w-8 items-center justify-center rounded-lg bg-amber-50 text-amber-600">
        <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke-width="1.8" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" d="M6.75 3v2.25M17.25 3v2.25M3 18.75V7.5a2.25 2.25 0 0 1 2.25-2.25h13.5A2.25 2.25 0 0 1 21 7.5v11.25m-18 0A2.25 2.25 0 0 0 5.25 21h13.5A2.25 2.25 0 0 0 21 18.75m-18 0v-7.5A2.25 2.25 0 0 1 5.25 9h13.5A2.25 2.25 0 0 1 21 11.25v7.5" />
        </svg>
      </div>
    </div>
    <p class="mt-3 text-2xl font-semibold tabular-nums text-slate-900">
      <%= number_to_currency(this_month.sum(&:amount), unit: "TSh ", precision: 0) %>
    </p>
    <p class="mt-1 text-xs text-slate-400"><%= Date.today.strftime("%B %Y") %></p>
  </div>

  <!-- Records -->
  <div class="rounded-xl border border-slate-200 bg-white p-5 shadow-sm">
    <div class="flex items-center justify-between">
      <p class="text-xs font-medium uppercase tracking-wider text-slate-500">Records</p>
      <div class="flex h-8 w-8 items-center justify-center rounded-lg bg-slate-100 text-slate-600">
        <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke-width="1.8" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" d="M9 12h3.75M9 15h3.75M9 18h3.75m3 .75H18a2.25 2.25 0 0 0 2.25-2.25V6.108c0-1.135-.845-2.098-1.976-2.192a48.424 48.424 0 0 0-1.123-.08m-5.801 0c-.065.21-.1.433-.1.664 0 .414.336.75.75.75h4.5a.75.75 0 0 0 .75-.75 2.25 2.25 0 0 0-.1-.664m-5.8 0A2.251 2.251 0 0 1 13.5 2.25H15c1.012 0 1.867.668 2.15 1.586m-5.8 0c-.376.023-.75.05-1.124.08C9.095 4.01 8.25 4.973 8.25 6.108V8.25m0 0H4.875c-.621 0-1.125.504-1.125 1.125v11.25c0 .621.504 1.125 1.125 1.125h9.75c.621 0 1.125-.504 1.125-1.125V9.375c0-.621-.504-1.125-1.125-1.125H8.25ZM6.75 12h.008v.008H6.75V12Zm0 3h.008v.008H6.75V15Zm0 3h.008v.008H6.75V18Z" />
        </svg>
      </div>
    </div>
    <p class="mt-3 text-2xl font-semibold tabular-nums text-slate-900"><%= @expenses.size %></p>
    <p class="mt-1 text-xs text-slate-400">Total entries</p>
  </div>

  <!-- Top category -->
  <% top = @expenses.group_by(&:category).map { |cat, list| [cat, list.sum(&:amount)] }.max_by { |_, v| v } %>
  <div class="rounded-xl border border-slate-200 bg-white p-5 shadow-sm">
    <div class="flex items-center justify-between">
      <p class="text-xs font-medium uppercase tracking-wider text-slate-500">Top category</p>
      <div class="flex h-8 w-8 items-center justify-center rounded-lg bg-violet-50 text-violet-600">
        <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke-width="1.8" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" d="M2.25 18 9 11.25l4.306 4.306a11.95 11.95 0 0 1 5.814-5.518l2.74-1.22m0 0-5.94-2.281m5.94 2.28-2.28 5.941" />
        </svg>
      </div>
    </div>
    <p class="mt-3 text-sm font-semibold text-slate-900">
      <%= top&.first&.humanize || "—" %>
    </p>
    <p class="mt-1 text-xs text-slate-400">
      <%= top ? number_to_currency(top.last, unit: "TSh ", precision: 0) : "No data" %>
    </p>
  </div>
</div>

<div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8 py-8 space-y-6">
  <% if notice.present? %>
    <div class="flex items-center gap-2 rounded-lg border border-emerald-200 bg-emerald-50 px-4 py-3 text-sm font-medium text-emerald-700 shadow-sm" id="notice">
      <svg class="h-5 w-5 text-emerald-500" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor">
        <path stroke-linecap="round" stroke-linejoin="round" d="M9 12.75 11.25 15 15 9.75M21 12a9 9 0 1 1-18 0 9 9 0 0 1 18 0Z" />
      </svg>
      <%= notice %>
    </div>
  <% end %>

  <!-- Page header -->
  <div class="flex flex-wrap items-end justify-between gap-4">
    <div>
      <h1 class="text-2xl font-semibold tracking-tight text-slate-900">Expenses</h1>
      <div class="mt-1 flex flex-wrap items-center gap-x-2 gap-y-1 text-sm text-slate-500">
        <span><%= pluralize(@expenses.size, "record") %></span>
        <span class="text-slate-300">·</span>
        <span>Electricity, rent, spares and other operating costs.</span>
      </div>
    </div>

    <div class="flex items-center gap-2">
      <%= link_to new_expense_path,
          class: "inline-flex items-center gap-1.5 rounded-lg bg-indigo-600 px-4 py-2.5 text-sm font-semibold text-white shadow-sm transition hover:bg-indigo-500 focus:outline-none focus:ring-2 focus:ring-indigo-500 focus:ring-offset-2" do %>
        <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" d="M12 4.5v15m7.5-7.5h-15" />
        </svg>
        Record Expense
      <% end %>
    </div>
  </div>

  <!-- Table card -->
  <div class="overflow-hidden rounded-xl border border-slate-200 bg-white shadow-sm">
    <div class="overflow-x-auto">
      <table class="min-w-full divide-y divide-slate-200">
        <thead class="bg-slate-50">
          <tr>
            <th class="px-4 py-3 text-left text-xs font-semibold uppercase tracking-wider text-slate-500">Date</th>
            <th class="px-4 py-3 text-left text-xs font-semibold uppercase tracking-wider text-slate-500">Category</th>
            <th class="px-4 py-3 text-left text-xs font-semibold uppercase tracking-wider text-slate-500">Description</th>
            <th class="px-4 py-3 text-right text-xs font-semibold uppercase tracking-wider text-slate-500">Amount</th>
            <th class="relative px-4 py-3"><span class="sr-only">Actions</span></th>
          </tr>
        </thead>
        <tbody class="divide-y divide-slate-100">
          <% @expenses.each do |expense| %>
            <tr id="<%= dom_id expense %>" class="group transition hover:bg-slate-50/70">

              <!-- Date -->
              <td class="whitespace-nowrap px-4 py-3">
                <div class="flex items-center gap-2">
                  <div class="flex h-7 w-7 shrink-0 items-center justify-center rounded-md bg-slate-100 text-slate-500">
                    <svg class="h-3.5 w-3.5" fill="none" viewBox="0 0 24 24" stroke-width="1.8" stroke="currentColor">
                      <path stroke-linecap="round" stroke-linejoin="round" d="M6.75 3v2.25M17.25 3v2.25M3 18.75V7.5a2.25 2.25 0 0 1 2.25-2.25h13.5A2.25 2.25 0 0 1 21 7.5v11.25m-18 0A2.25 2.25 0 0 0 5.25 21h13.5A2.25 2.25 0 0 0 21 18.75m-18 0v-7.5A2.25 2.25 0 0 1 5.25 9h13.5A2.25 2.25 0 0 1 21 11.25v7.5" />
                    </svg>
                  </div>
                  <span class="text-sm text-slate-700 tabular-nums">
                    <%= expense.spent_on&.strftime("%d %b %Y") || "—" %>
                  </span>
                </div>
              </td>

              <!-- Category chip -->
              <td class="whitespace-nowrap px-4 py-3">
                <% cat = expense.category.to_s.downcase %>
                <% cat_style = case cat
                   when "electricity", "power", "utilities"
                     "bg-amber-50 text-amber-700 ring-amber-200"
                   when "rent", "rental", "lease"
                     "bg-violet-50 text-violet-700 ring-violet-200"
                   when "spares", "parts", "spare"
                     "bg-blue-50 text-blue-700 ring-blue-200"
                   when "salary", "salaries", "wages", "payroll"
                     "bg-emerald-50 text-emerald-700 ring-emerald-200"
                   when "transport", "fuel", "travel"
                     "bg-orange-50 text-orange-700 ring-orange-200"
                   when "internet", "phone", "communication"
                     "bg-cyan-50 text-cyan-700 ring-cyan-200"
                   else
                     "bg-slate-100 text-slate-700 ring-slate-200"
                   end %>
                <span class="inline-flex items-center rounded-md px-2 py-1 text-xs font-medium ring-1 ring-inset <%= cat_style %>">
                  <%= expense.category.humanize %>
                </span>
              </td>

              <!-- Description -->
              <td class="px-4 py-3">
                <p class="max-w-md truncate text-sm text-slate-700" title="<%= expense.description %>">
                  <%= expense.description.presence || "—" %>
                </p>
              </td>

              <!-- Amount -->
              <td class="whitespace-nowrap px-4 py-3 text-right">
                <span class="text-sm font-semibold tabular-nums text-slate-900">
                  <%= number_to_currency(expense.amount, unit: "TSh ", precision: 0) %>
                </span>
              </td>

              <!-- Actions -->
              <td class="whitespace-nowrap px-4 py-3 text-right">
                <div class="inline-flex items-center justify-end gap-1 opacity-70 transition group-hover:opacity-100">
                  <%= link_to edit_expense_path(expense),
                      class: "rounded-lg p-1.5 text-slate-500 transition hover:bg-slate-100 hover:text-slate-800",
                      title: "Edit" do %>
                    <span class="sr-only">Edit</span>
                    <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke-width="1.8" stroke="currentColor">
                      <path stroke-linecap="round" stroke-linejoin="round" d="m16.862 4.487 1.687-1.688a1.875 1.875 0 1 1 2.652 2.652L10.582 16.07a4.5 4.5 0 0 1-1.897 1.13L6 18l.8-2.685a4.5 4.5 0 0 1 1.13-1.897l8.932-8.931Z" />
                    </svg>
                  <% end %>

                  <%= button_to expense, method: :delete,
                      data: { turbo_confirm: "Are you sure?" },
                      class: "rounded-lg p-1.5 text-rose-500 transition hover:bg-rose-50 hover:text-rose-700 cursor-pointer",
                      title: "Delete" do %>
                    <span class="sr-only">Delete</span>
                    <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke-width="1.8" stroke="currentColor">
                      <path stroke-linecap="round" stroke-linejoin="round" d="m14.74 9-.346 9m-4.788 0L9.26 9m9.968-3.21c.342.052.682.107 1.022.166m-1.022-.165L18.16 19.673a2.25 2.25 0 0 1-2.244 2.077H8.084a2.25 2.25 0 0 1-2.244-2.077L4.772 5.79m14.456 0a48.108 48.108 0 0 0-3.478-.397m-12 .562c.34-.059.68-.114 1.022-.165m0 0a48.11 48.11 0 0 1 3.478-.397m7.5 0v-.916c0-1.18-.91-2.164-2.09-2.201a51.964 51.964 0 0 0-3.32 0c-1.18.037-2.09 1.022-2.09 2.201v.916m7.5 0a48.667 48.667 0 0 0-7.5 0" />
                    </svg>
                  <% end %>
                </div>
              </td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>

    <% if @expenses.empty? %>
      <div class="flex flex-col items-center justify-center px-6 py-16 text-center">
        <div class="flex h-12 w-12 items-center justify-center rounded-full bg-slate-100">
          <svg class="h-6 w-6 text-slate-400" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" d="M2.25 8.25h19.5M2.25 9h19.5m-16.5 5.25h6m-6 2.25h3m-3.75 3h15a2.25 2.25 0 0 0 2.25-2.25V6.75A2.25 2.25 0 0 0 19.5 4.5h-15a2.25 2.25 0 0 0-2.25 2.25v10.5A2.25 2.25 0 0 0 4.5 19.5Z" />
          </svg>
        </div>
        <h3 class="mt-4 text-sm font-semibold text-slate-900">No expenses recorded</h3>
        <p class="mt-1 text-sm text-slate-500">Start tracking your operating costs.</p>
        <%= link_to "Record Expense", new_expense_path,
            class: "mt-6 inline-flex items-center gap-2 rounded-lg bg-indigo-600 px-4 py-2 text-sm font-semibold text-white shadow-sm transition hover:bg-indigo-500" %>
      </div>
    <% end %>
  </div>
</div>