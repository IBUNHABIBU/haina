<%= form_with model: expense, class: "space-y-5" do |form| %>
  
  <%# Errors %>
  <% if expense.errors.any? %>
    <div class="rounded-lg border border-rose-200 bg-rose-50 p-4 text-sm text-rose-700">
      <p class="font-medium">Please correct the following:</p>
      <ul class="mt-1 list-disc pl-5">
        <% expense.errors.full_messages.each do |message| %>
          <li><%= message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <%# Category %>
  <div>
    <%= form.label :category, class: "label" %>
    <%= form.select :category, Expense::CATEGORIES.map { |c| [c.humanize, c] }, {}, class: "field" %>
  </div>

  <%# Description %>
  <div>
    <%= form.label :description, class: "label" %>
    <%= form.text_field :description, placeholder: "e.g. Electricity bill for October", class: "field" %>
  </div>

  <%# Amount + Spent On %>
  <div class="grid gap-5 md:grid-cols-2">
    <div>
      <%= form.label :amount, "Amount (TSh)", class: "label" %>
      <div class="relative">
        <span class="pointer-events-none absolute inset-y-0 left-3 flex items-center text-sm font-medium text-slate-400">TSh</span>
        <%= form.number_field :amount, step: 0.01, min: 0, class: "field pl-12", placeholder: "0" %>
      </div>
    </div>
    <div>
      <%= form.label :spent_on, class: "label" %>
      <%= form.date_field :spent_on, class: "field" %>
    </div>
  </div>

  <%# Reference %>
  <div>
    <%= form.label :reference, "Reference (optional)", class: "label" %>
    <%= form.text_field :reference, placeholder: "e.g. Receipt #123", class: "field" %>
  </div>

  <%# Notes %>
  <div>
    <%= form.label :notes, "Notes (optional)", class: "label" %>
    <%= form.text_area :notes, rows: 3, placeholder: "Any additional notes...", class: "field" %>
  </div>

  <%# Actions %>
  <div class="flex flex-wrap items-center justify-end gap-3 border-t border-slate-100 pt-4">
    <%= link_to "Cancel", expenses_path,
        class: "inline-flex items-center gap-1.5 rounded-lg border border-slate-200 bg-white px-4 py-2.5 text-sm font-medium text-slate-700 shadow-sm transition hover:bg-slate-50" %>
    
    <%= form.submit expense.persisted? ? "Update Expense" : "Create Expense",
        class: "inline-flex items-center gap-1.5 rounded-lg bg-indigo-600 px-5 py-2.5 text-sm font-semibold text-white shadow-sm transition hover:bg-indigo-500 focus:outline-none focus:ring-2 focus:ring-indigo-500 focus:ring-offset-2 cursor-pointer" %>
  </div>

<% end %>