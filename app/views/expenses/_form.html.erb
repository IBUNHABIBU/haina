<%= form_with model: expense, class: "space-y-5" do |form| %><% if expense.errors.any? %><div class="rounded-lg bg-red-50 p-4 text-red-700"><%= expense.errors.full_messages.to_sentence %></div><% end %><div><%= form.label :category, class: "label" %><%= form.select :category, Expense::CATEGORIES.map { |c| [c.humanize, c] }, {}, class: "field" %></div><div><%= form.label :description, class: "label" %><%= form.text_field :description, class: "field" %></div><div class="grid gap-5 md:grid-cols-2"><div><%= form.label :amount, "Amount (TSh)", class: "label" %><%= form.number_field :amount, step: 0.01, min: 0, class: "field" %></div><div><%= form.label :spent_on, class: "label" %><%= form.date_field :spent_on, class: "field" %></div></div><div><%= form.label :reference, class: "label" %><%= form.text_field :reference, class: "field" %></div><div><%= form.label :notes, class: "label" %><%= form.text_area :notes, rows: 3, class: "field" %></div><%= form.submit class: "rounded-lg bg-blue-600 px-5 py-2.5 font-medium text-white" %><% end %>
