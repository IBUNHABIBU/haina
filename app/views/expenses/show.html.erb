<div class="mx-auto max-w-2xl rounded-xl border bg-white p-6"><h1 class="text-2xl font-bold"><%= @expense.description %></h1><dl class="mt-5 grid grid-cols-2 gap-3"><dt class="text-slate-500">Category</dt><dd><%= @expense.category.humanize %></dd><dt class="text-slate-500">Amount</dt><dd><%= number_to_currency(@expense.amount, unit: "TSh ", precision: 0) %></dd><dt class="text-slate-500">Date</dt><dd><%= @expense.spent_on %></dd></dl></div>
