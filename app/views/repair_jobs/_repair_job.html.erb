<div id="<%= dom_id repair_job %>" class="w-full sm:w-auto my-5 space-y-5">
  <div>
    <strong class="block font-medium mb-1">Customer:</strong>
    <%= repair_job.customer_id %>
  </div>
  <div>
    <strong class="block font-medium mb-1">Tv brand:</strong>
    <%= repair_job.tv_brand_id %>
  </div>
  <div>
    <strong class="block font-medium mb-1">Tv size:</strong>
    <%= repair_job.tv_size_id %>
