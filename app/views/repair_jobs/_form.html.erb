    <%= form.label :cof_number %>
    <%= form.text_field :cof_number, class: ["block shadow-sm rounded-md border px-3 py-2 mt-2 w-full", {"border-gray-400 focus:outline-blue-600": repair_job.errors[:cof_number].none?, "border-red-400 focus:outline-red-600": repair_job.errors[:cof_number].any?}] %>
