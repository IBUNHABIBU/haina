<%= form_with model: [activity, repair_return], class: "space-y-5" do |form| %><% if repair_return.errors.any? %><div class="rounded-lg bg-red-50 p-4 text-red-700"><%= repair_return.errors.full_messages.to_sentence %></div><% end %><div class="grid gap-5 md:grid-cols-2"><div><%= form.label :returned_at, class: "label" %><%= form.datetime_local_field :returned_at, class: "field" %></div><div><%= form.label :location, class: "label" %><%= form.text_field :location, class: "field", placeholder: "Where was it returned?" %></div><div><%= form.label :reason, class: "label" %><%= form.text_field :reason, class: "field" %></div><div><%= form.label :condition, class: "label" %><%= form.text_field :condition, class: "field" %></div><div><%= form.label :status, class: "label" %><%= form.select :status, RepairReturn::STATUSES.map { |s| [s.humanize, s] }, {}, class: "field" %></div></div><div><%= form.label :notes, class: "label" %><%= form.text_area :notes, rows: 4, class: "field" %></div><%= form.submit class: "rounded-lg bg-amber-500 px-5 py-2.5 font-medium text-white" %><% end %>
