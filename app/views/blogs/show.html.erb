<% content_for :title, @blog.title.presence || "Blog" %>

<div class="mx-auto max-w-4xl px-4 sm:px-6 lg:px-8 py-8 space-y-6">
  <% if notice.present? %>
    <div class="flex items-center gap-2 rounded-lg border border-emerald-200 bg-emerald-50 px-4 py-3 text-sm font-medium text-emerald-700 shadow-sm" id="notice">
      <svg class="h-5 w-5 text-emerald-500" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor">
        <path stroke-linecap="round" stroke-linejoin="round" d="M9 12.75 11.25 15 15 9.75M21 12a9 9 0 1 1-18 0 9 9 0 0 1 18 0Z" />
      </svg>
      <%= notice %>
    </div>
  <% end %>

  <!-- Back link -->
  <div>
    <%= link_to blogs_path, class: "inline-flex items-center gap-1.5 text-sm font-medium text-slate-500 transition hover:text-slate-900" do %>
      <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor">
        <path stroke-linecap="round" stroke-linejoin="round" d="M15.75 19.5 8.25 12l7.5-7.5" />
      </svg>
      Back to blogs
    <% end %>
  </div>

  <!-- Article card -->
  <article class="overflow-hidden rounded-xl border border-slate-200 bg-white shadow-sm">

    <!-- Cover image -->
    <% if @blog.respond_to?(:cover_image) && @blog.cover_image.attached? %>
      <div class="aspect-[16/9] w-full overflow-hidden bg-slate-100">
        <%= image_tag @blog.cover_image, class: "h-full w-full object-cover" %>
      </div>
    <% end %>

    <!-- Header -->
    <header class="px-6 py-6 sm:px-8">
      <div class="flex flex-wrap items-center gap-2">
        <% if @blog.respond_to?(:status) && @blog.status.present? %>
          <% published = @blog.status.to_s.downcase == "published" %>
          <span class="inline-flex items-center gap-1.5 rounded-full px-2.5 py-1 text-xs font-medium ring-1 ring-inset
            <%= published ? 'bg-emerald-50 text-emerald-700 ring-emerald-200' : 'bg-amber-50 text-amber-700 ring-amber-200' %>">
            <span class="h-1.5 w-1.5 rounded-full <%= published ? 'bg-emerald-500' : 'bg-amber-500' %>"></span>
            <%= @blog.status.humanize %>
          </span>
        <% end %>

        <% if @blog.respond_to?(:category) && @blog.category.present? %>
          <span class="inline-flex items-center rounded-md bg-slate-100 px-2.5 py-1 text-xs font-medium text-slate-700">
            <%= @blog.category %>
          </span>
        <% end %>
      </div>

      <h1 class="mt-3 text-3xl font-semibold tracking-tight text-slate-900 sm:text-4xl">
        <%= @blog.title.presence || "Untitled" %>
      </h1>

      <!-- Metadata -->
      <div class="mt-4 flex flex-wrap items-center gap-x-4 gap-y-2 text-sm text-slate-500">
        <%# Created by %>
        <% author_name = @blog.try(:user)&.try(:name).presence || @blog.try(:author).presence %>
        <% if author_name.present? %>
          <div class="flex items-center gap-2">
            <div class="flex h-7 w-7 items-center justify-center rounded-full bg-indigo-100 text-xs font-semibold text-indigo-700">
              <%= author_name.to_s.first&.upcase || "?" %>
            </div>
            <span>
              <span class="text-slate-400">Created by</span>
              <span class="font-medium text-slate-700"><%= author_name %></span>
            </span>
          </div>
        <% end %>

        <% if @blog.respond_to?(:created_at) && @blog.created_at %>
          <span class="text-slate-300">·</span>
          <time datetime="<%= @blog.created_at.iso8601 %>" class="flex items-center gap-1.5">
            <svg class="h-4 w-4 text-slate-400" fill="none" viewBox="0 0 24 24" stroke-width="1.8" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" d="M6.75 3v2.25M17.25 3v2.25M3 18.75V7.5a2.25 2.25 0 0 1 2.25-2.25h13.5A2.25 2.25 0 0 1 21 7.5v11.25m-18 0A2.25 2.25 0 0 0 5.25 21h13.5A2.25 2.25 0 0 0 21 18.75m-18 0v-7.5A2.25 2.25 0 0 1 5.25 9h13.5A2.25 2.25 0 0 1 21 11.25v7.5" />
            </svg>
            <%= @blog.created_at.strftime("%d %b %Y") %>
          </time>
        <% end %>

        <% if @blog.respond_to?(:updated_at) && @blog.updated_at && @blog.updated_at != @blog.created_at %>
          <span class="text-slate-300">·</span>
          <span class="text-xs text-slate-400">
            Updated <%= time_ago_in_words(@blog.updated_at) %> ago
          </span>
        <% end %>
      </div>
    </header>

    <!-- Body -->
    <div class="border-t border-slate-100 px-6 py-6 sm:px-8">
      <% if @blog.respond_to?(:excerpt) && @blog.excerpt.present? %>
        <p class="mb-6 border-l-4 border-indigo-200 bg-indigo-50/40 px-4 py-3 text-base italic leading-7 text-slate-700">
          <%= @blog.excerpt %>
        </p>
      <% end %>

      <% body = @blog.try(:content).presence || @blog.try(:body).presence || @blog.try(:description).presence %>
      <% if body.present? %>
        <div class="prose prose-slate max-w-none prose-headings:font-semibold prose-a:text-indigo-600 prose-a:no-underline hover:prose-a:underline prose-img:rounded-lg prose-img:shadow-sm">
          <%= body %>
        </div>
      <% else %>
        <p class="text-sm italic text-slate-400">No content provided.</p>
      <% end %>
    </div>

    <!-- Footer meta -->
    <footer class="flex flex-wrap items-center justify-between gap-3 border-t border-slate-100 bg-slate-50/50 px-6 py-4 sm:px-8">
      <div class="text-xs text-slate-500">
        Blog ID: <span class="font-mono font-medium text-slate-700">#<%= @blog.id %></span>
      </div>

      <% if @blog.respond_to?(:user) && @blog.user.present? %>
        <div class="flex items-center gap-2 text-xs text-slate-500">
          <svg class="h-3.5 w-3.5 text-slate-400" fill="none" viewBox="0 0 24 24" stroke-width="1.8" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" d="M15.75 6a3.75 3.75 0 1 1-7.5 0 3.75 3.75 0 0 1 7.5 0ZM4.501 20.118a7.5 7.5 0 0 1 14.998 0A17.933 17.933 0 0 1 12 21.75c-2.676 0-5.216-.584-7.499-1.632Z" />
          </svg>
          Author : <span class="font-mono font-medium text-slate-700"><%= @blog.user.try(:first_name) || "Unknown" %></span>
        </div>
      <% end %>
    </footer>
  </article>

  <!-- Actions -->
  <div class="flex flex-wrap items-center gap-3">
    <%= link_to edit_blog_path(@blog),
        class: "inline-flex items-center gap-1.5 rounded-lg bg-indigo-600 px-4 py-2.5 text-sm font-semibold text-white shadow-sm transition hover:bg-indigo-500 focus:outline-none focus:ring-2 focus:ring-indigo-500 focus:ring-offset-2" do %>
      <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke-width="1.8" stroke="currentColor">
        <path stroke-linecap="round" stroke-linejoin="round" d="m16.862 4.487 1.687-1.688a1.875 1.875 0 1 1 2.652 2.652L10.582 16.07a4.5 4.5 0 0 1-1.897 1.13L6 18l.8-2.685a4.5 4.5 0 0 1 1.13-1.897l8.932-8.931Z" />
      </svg>
      Edit blog
    <% end %>

    <%= link_to blogs_path,
        class: "inline-flex items-center gap-1.5 rounded-lg border border-slate-200 bg-white px-4 py-2.5 text-sm font-medium text-slate-700 shadow-sm transition hover:bg-slate-50" do %>
      <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke-width="1.8" stroke="currentColor">
        <path stroke-linecap="round" stroke-linejoin="round" d="M15.75 19.5 8.25 12l7.5-7.5" />
      </svg>
      Back
    <% end %>

    <%= button_to @blog, method: :delete,
        form_class: "inline-block",
        class: "inline-flex items-center gap-1.5 rounded-lg border border-rose-200 bg-white px-4 py-2.5 text-sm font-medium text-rose-600 shadow-sm transition hover:bg-rose-50 cursor-pointer",
        data: { turbo_confirm: "Are you sure?" } do %>
      <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke-width="1.8" stroke="currentColor">
        <path stroke-linecap="round" stroke-linejoin="round" d="m14.74 9-.346 9m-4.788 0L9.26 9m9.968-3.21c.342.052.682.107 1.022.166m-1.022-.165L18.16 19.673a2.25 2.25 0 0 1-2.244 2.077H8.084a2.25 2.25 0 0 1-2.244-2.077L4.772 5.79m14.456 0a48.108 48.108 0 0 0-3.478-.397m-12 .562c.34-.059.68-.114 1.022-.165m0 0a48.11 48.11 0 0 1 3.478-.397m7.5 0v-.916c0-1.18-.91-2.164-2.09-2.201a51.964 51.964 0 0 0-3.32 0c-1.18.037-2.09 1.022-2.09 2.201v.916m7.5 0a48.667 48.667 0 0 0-7.5 0" />
      </svg>
      Delete blog
    <% end %>
  </div>
</div>