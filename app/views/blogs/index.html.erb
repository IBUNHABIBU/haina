<% content_for :title, "Blogs" %>

<div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8 py-8 space-y-6">
  <% if notice.present? %>
    <div class="flex items-center gap-2 rounded-lg border border-emerald-200 bg-emerald-50 px-4 py-3 text-sm font-medium text-emerald-700 shadow-sm" id="notice">
      <svg class="h-5 w-5 text-emerald-500" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor">
        <path stroke-linecap="round" stroke-linejoin="round" d="M9 12.75 11.25 15 15 9.75M21 12a9 9 0 1 1-18 0 9 9 0 0 1 18 0Z" />
      </svg>
      <%= notice %>
    </div>
  <% end %>

  <!-- Page header -->
  <div class="flex flex-wrap items-end justify-between gap-4">
    <div>
      <h1 class="text-2xl font-semibold tracking-tight text-slate-900">Blogs</h1>
      <p class="mt-1 text-sm text-slate-500">Manage articles, drafts and published posts.</p>
    </div>
    <div class="flex items-center gap-2">
      <%= link_to new_blog_path,
          class: "inline-flex items-center gap-1.5 rounded-lg bg-indigo-600 px-4 py-2.5 text-sm font-semibold text-white shadow-sm transition hover:bg-indigo-500 focus:outline-none focus:ring-2 focus:ring-indigo-500 focus:ring-offset-2" do %>
        <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" d="M12 4.5v15m7.5-7.5h-15" />
        </svg>
        New blog
      <% end %>
    </div>
  </div>

  <!-- Blog grid -->
  <% if @blogs.any? %>
    <div id="blogs" class="grid gap-5 sm:grid-cols-2 lg:grid-cols-3">
      <% @blogs.each do |blog| %>
        <article id="<%= dom_id blog %>"
                 class="group flex flex-col overflow-hidden rounded-xl border border-slate-200 bg-white shadow-sm transition hover:border-indigo-300 hover:shadow-md">

          <!-- Cover image -->
          <div class="relative aspect-[16/9] overflow-hidden bg-gradient-to-br from-indigo-100 via-slate-100 to-slate-200">
            <% if blog.respond_to?(:cover_image) && blog.cover_image.attached? %>
              <%= image_tag blog.cover_image,
                  class: "h-full w-full object-cover transition duration-300 group-hover:scale-105" %>
            <% else %>
              <div class="flex h-full w-full items-center justify-center">
                <svg class="h-10 w-10 text-slate-400" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor">
                  <path stroke-linecap="round" stroke-linejoin="round" d="m2.25 15.75 5.159-5.159a2.25 2.25 0 0 1 3.182 0l5.159 5.159m-1.5-1.5 1.409-1.409a2.25 2.25 0 0 1 3.182 0l2.909 2.909m-18 3.75h16.5a1.5 1.5 0 0 0 1.5-1.5V6a1.5 1.5 0 0 0-1.5-1.5H3.75A1.5 1.5 0 0 0 2.25 6v12a1.5 1.5 0 0 0 1.5 1.5Zm10.5-11.25h.008v.008h-.008V8.25Zm.375 0a.375.375 0 1 1-.75 0 .375.375 0 0 1 .75 0Z" />
                </svg>
              </div>
            <% end %>

            <!-- Status badge -->
            <% if blog.respond_to?(:status) && blog.status.present? %>
              <% published = blog.status.to_s.downcase == "published" %>
              <span class="absolute left-3 top-3 inline-flex items-center gap-1.5 rounded-full px-2.5 py-1 text-[11px] font-medium ring-1 ring-inset backdrop-blur
                <%= published ? 'bg-emerald-50/90 text-emerald-700 ring-emerald-200' : 'bg-amber-50/90 text-amber-700 ring-amber-200' %>">
                <span class="h-1.5 w-1.5 rounded-full <%= published ? 'bg-emerald-500' : 'bg-amber-500' %>"></span>
                <%= blog.status.humanize %>
              </span>
            <% end %>
          </div>

          <!-- Body -->
          <div class="flex flex-1 flex-col p-5">
            <h3 class="line-clamp-2 text-base font-semibold leading-snug text-slate-900 transition group-hover:text-indigo-700">
              <%= link_to blog.title.presence || "Untitled", blog, class: "focus:outline-none" %>
            </h3>

            <% if blog.respond_to?(:excerpt) && blog.excerpt.present? %>
              <p class="mt-2 line-clamp-2 text-sm leading-5 text-slate-500">
                <%= blog.excerpt %>
              </p>
            <% end %>

            <!-- Meta -->
            <div class="mt-4 flex items-center gap-3 text-xs text-slate-500">
              <% if blog.respond_to?(:user) && blog.user.present? %>
                <div class="flex items-center gap-1.5">
                  <div class="flex h-6 w-6 items-center justify-center rounded-full bg-indigo-100 text-[10px] font-semibold text-indigo-700">
                    <%= blog.user.try(:first_name).to_s.first&.upcase || "?" %>
                  </div>
                  <span><%= blog.user.try(:first_name) || "Unknown" %></span>
                </div>
                <span class="text-slate-300">·</span>
              <% end %>

              <% if blog.respond_to?(:created_at) && blog.created_at %>
                <time datetime="<%= blog.created_at.iso8601 %>">
                  <%= blog.created_at.strftime("%d %b %Y") %>
                </time>
              <% end %>
            </div>
          </div>

          <!-- Actions -->
          <div class="flex items-center justify-end gap-1 border-t border-slate-100 bg-slate-50/50 px-3 py-2 opacity-70 transition group-hover:opacity-100">
            <%= link_to blog, class: "rounded-lg p-1.5 text-indigo-600 transition hover:bg-indigo-50", title: "View" do %>
              <span class="sr-only">Show</span>
              <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke-width="1.8" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" d="M2.036 12.322a1.012 1.012 0 0 1 0-.639C3.423 7.51 7.36 4.5 12 4.5c4.638 0 8.573 3.007 9.963 7.178.07.207.07.431 0 .639C20.577 16.49 16.64 19.5 12 19.5c-4.638 0-8.573-3.007-9.963-7.178Z" />
                <path stroke-linecap="round" stroke-linejoin="round" d="M15 12a3 3 0 1 1-6 0 3 3 0 0 1 6 0Z" />
              </svg>
            <% end %>

            <%= link_to edit_blog_path(blog), class: "rounded-lg p-1.5 text-slate-500 transition hover:bg-slate-100 hover:text-slate-800", title: "Edit" do %>
              <span class="sr-only">Edit</span>
              <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke-width="1.8" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" d="m16.862 4.487 1.687-1.688a1.875 1.875 0 1 1 2.652 2.652L10.582 16.07a4.5 4.5 0 0 1-1.897 1.13L6 18l.8-2.685a4.5 4.5 0 0 1 1.13-1.897l8.932-8.931Z" />
              </svg>
            <% end %>

            <%= button_to blog, method: :delete,
                data: { turbo_confirm: "Are you sure?" },
                class: "rounded-lg p-1.5 text-rose-500 transition hover:bg-rose-50 hover:text-rose-700 cursor-pointer",
                title: "Delete" do %>
              <span class="sr-only">Destroy</span>
              <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke-width="1.8" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" d="m14.74 9-.346 9m-4.788 0L9.26 9m9.968-3.21c.342.052.682.107 1.022.166m-1.022-.165L18.16 19.673a2.25 2.25 0 0 1-2.244 2.077H8.084a2.25 2.25 0 0 1-2.244-2.077L4.772 5.79m14.456 0a48.108 48.108 0 0 0-3.478-.397m-12 .562c.34-.059.68-.114 1.022-.165m0 0a48.11 48.11 0 0 1 3.478-.397m7.5 0v-.916c0-1.18-.91-2.164-2.09-2.201a51.964 51.964 0 0 0-3.32 0c-1.18.037-2.09 1.022-2.09 2.201v.916m7.5 0a48.667 48.667 0 0 0-7.5 0" />
              </svg>
            <% end %>
          </div>
        </article>
      <% end %>
    </div>
  <% else %>
    <div class="flex flex-col items-center justify-center rounded-xl border border-dashed border-slate-300 bg-white px-6 py-16 text-center">
      <div class="flex h-12 w-12 items-center justify-center rounded-full bg-slate-100">
        <svg class="h-6 w-6 text-slate-400" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" d="M12 7.5h1.5m-1.5 3h1.5m-7.5 3h7.5m-7.5 3h7.5m3-9h3.375c.621 0 1.125.504 1.125 1.125V18a2.25 2.25 0 0 1-2.25 2.25M16.5 7.5V18a2.25 2.25 0 0 0 2.25 2.25M16.5 7.5V4.875c0-.621-.504-1.125-1.125-1.125H4.125C3.504 3.75 3 4.254 3 4.875V18a2.25 2.25 0 0 0 2.25 2.25h13.5M6 7.5h3v3H6v-3Z" />
        </svg>
      </div>
      <h3 class="mt-4 text-sm font-semibold text-slate-900">No blogs yet</h3>
      <p class="mt-1 text-sm text-slate-500">Get started by creating your first blog post.</p>
      <%= link_to "New blog", new_blog_path,
          class: "mt-6 inline-flex items-center gap-2 rounded-lg bg-indigo-600 px-4 py-2 text-sm font-semibold text-white shadow-sm transition hover:bg-indigo-500" %>
    </div>
  <% end %>
</div>