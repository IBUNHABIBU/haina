<%# DESKTOP TABLE (md and up) %>
<div class="hidden md:block overflow-hidden rounded-xl border border-slate-200 bg-white shadow-sm">
  <div class="overflow-x-auto">
    <table class="min-w-full divide-y divide-slate-200">
      <thead class="bg-slate-50">
        <tr>
          <th class="px-4 py-3 text-left text-xs font-semibold uppercase tracking-wider text-slate-500">Request</th>
          <th class="px-4 py-3 text-left text-xs font-semibold uppercase tracking-wider text-slate-500">Date</th>
          <th class="px-4 py-3 text-left text-xs font-semibold uppercase tracking-wider text-slate-500">Spare</th>
          <th class="px-4 py-3 text-right text-xs font-semibold uppercase tracking-wider text-slate-500">Qty</th>
          <th class="px-4 py-3 text-left text-xs font-semibold uppercase tracking-wider text-slate-500">Linked Activity</th>
          <th class="px-4 py-3 text-left text-xs font-semibold uppercase tracking-wider text-slate-500">Requested By</th>
          <th class="px-4 py-3 text-left text-xs font-semibold uppercase tracking-wider text-slate-500">Status</th>
          <th class="relative px-4 py-3"><span class="sr-only">Actions</span></th>
        </tr>
      </thead>
      <tbody class="divide-y divide-slate-100">
        <% if spare_requests.any? %>
          <% spare_requests.each do |request| %>
            <%= render "spare_requests/spare_request_row", request: request %>
          <% end %>
        <% else %>
          <tr>
            <td colspan="8" class="px-6 py-16 text-center">
              <div class="flex flex-col items-center justify-center">
                <div class="flex h-12 w-12 items-center justify-center rounded-full bg-slate-100">
                  <svg class="h-6 w-6 text-slate-400" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M9 12h3.75M9 15h3.75M9 18h3.75m3 .75H18a2.25 2.25 0 0 0 2.25-2.25V6.108c0-1.135-.845-2.098-1.976-2.192a48.424 48.424 0 0 0-1.123-.08m-5.801 0c-.065.21-.1.433-.1.664 0 .414.336.75.75.75h4.5a.75.75 0 0 0 .75-.75 2.25 2.25 0 0 0-.1-.664m-5.8 0A2.251 2.251 0 0 1 13.5 2.25H15c1.012 0 1.867.668 2.15 1.586m-5.8 0c-.376.023-.75.05-1.124.08C9.095 4.01 8.25 4.973 8.25 6.108V8.25m0 0H4.875c-.621 0-1.125.504-1.125 1.125v11.25c0 .621.504 1.125 1.125 1.125h9.75c.621 0 1.125-.504 1.125-1.125V9.375c0-.621-.504-1.125-1.125-1.125H8.25ZM6.75 12h.008v.008H6.75V12Zm0 3h.008v.008H6.75V15Zm0 3h.008v.008H6.75V18Z" />
                  </svg>
                </div>
                <h3 class="mt-4 text-sm font-semibold text-slate-900">No spare requests found</h3>
                <p class="mt-1 text-sm text-slate-500">Try a different filter or create a new request.</p>
              </div>
            </td>
          </tr>
        <% end %>
      </tbody>
    </table>
  </div>
</div>

<%# MOBILE CARDS (below md) %>
<div class="md:hidden space-y-3">
  <% if spare_requests.any? %>
    <% spare_requests.each do |request| %>
      <% status_str = request.status.to_s.downcase %>
      <% status_style = case status_str
         when "pending", "requested" then "bg-amber-50 text-amber-700 ring-amber-200"
         when "approved" then "bg-blue-50 text-blue-700 ring-blue-200"
         when "fulfilled", "completed" then "bg-emerald-50 text-emerald-700 ring-emerald-200"
         when "rejected", "cancelled" then "bg-rose-50 text-rose-700 ring-rose-200"
         else "bg-slate-100 text-slate-700 ring-slate-200"
         end %>
         
      <details id="mobile_<%= dom_id request %>" class="group rounded-xl border border-slate-200 bg-white shadow-sm open:shadow-md">
        
        <summary class="flex cursor-pointer items-center gap-3 px-4 py-3 list-none [&::-webkit-details-marker]:hidden">
          <div class="flex h-9 w-9 shrink-0 items-center justify-center rounded-full bg-slate-100 text-slate-600">
            <% if request.request_type == "activity" %>
              <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke-width="1.8" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" d="M11.42 15.17 17.25 21A2.652 2.652 0 0 0 21 17.25l-5.877-5.877M11.42 15.17l2.496-3.03c.317-.384.74-.626 1.208-.766M11.42 15.17l-4.655 5.653a2.548 2.548 0 1 1-3.586-3.586l6.837-5.63m5.108-.233c.55-.164 1.163-.188 1.743-.14a4.5 4.5 0 0 0 4.486-6.336l-3.276 3.277a3.004 3.004 0 0 1-2.25-2.25l3.276-3.276a4.5 4.5 0 0 0-6.336 4.486c.091 1.076-.071 2.264-.904 2.95l-.102.085m-1.745 1.437L5.909 7.5H4.5L2.25 3.75l1.5-1.5L7.5 4.5v1.409l4.26 4.26m-1.745 1.437 1.745-1.437m6.615 8.206L15.75 15.75M4.867 19.125h.008v.008h-.008v-.008Z" /></svg>
            <% elsif request.request_type == "workshop" %>
              <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke-width="1.8" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" d="M11.42 15.17 17.25 21A2.652 2.652 0 0 0 21 17.25l-5.877-5.877M11.42 15.17l2.496-3.03c.317-.384.74-.626 1.208-.766M11.42 15.17l-4.655 5.653a2.548 2.548 0 1 1-3.586-3.586l6.837-5.63m5.108-.233c.55-.164 1.163-.188 1.743-.14a4.5 4.5 0 0 0 4.486-6.336l-3.276 3.277a3.004 3.004 0 0 1-2.25-2.25l3.276-3.276a4.5 4.5 0 0 0-6.336 4.486c.091 1.076-.071 2.264-.904 2.95l-.102.085m-1.745 1.437L5.909 7.5H4.5L2.25 3.75l1.5-1.5L7.5 4.5v1.409l4.26 4.26m-1.745 1.437 1.745-1.437m6.615 8.206L15.75 15.75M4.867 19.125h.008v.008h-.008v-.008Z" /></svg>
            <% else %>
              <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke-width="1.8" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" d="M2.25 3h1.386c.51 0 .955.343 1.087.835l.383 1.437M7.5 14.25a3 3 0 0 0-3 3h15.75m-12.75-3h11.218c1.121-2.3 2.1-4.684 2.924-7.138a60.114 60.114 0 0 0-16.536-1.84M7.5 14.25 5.106 5.272M6 20.25a.75.75 0 1 1-1.5 0 .75.75 0 0 1 1.5 0Zm12.75 0a.75.75 0 1 1-1.5 0 .75.75 0 0 1 1.5 0Z" /></svg>
            <% end %>
          </div>

          <div class="min-w-0 flex-1">
            <p class="truncate text-sm font-semibold text-slate-900">
              <%= spare_request_name(request) %>
            </p>
            <p class="mt-0.5 text-xs text-slate-500">
              <%= request.activity&.customer&.name || request.request_type&.humanize || "—" %>
              · Qty: <span class="font-semibold text-slate-700"><%= request.requested_quantity %></span>
            </p>
          </div>

          <div class="flex flex-col items-end gap-1">
            <span class="inline-flex items-center gap-1.5 rounded-full px-2 py-0.5 text-[10px] font-medium ring-1 ring-inset <%= status_style %>">
              <%= request.status.humanize %>
            </span>
          </div>

          <svg class="h-4 w-4 shrink-0 text-slate-400 transition-transform duration-200 group-open:rotate-180" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" d="m19.5 8.25-7.5 7.5-7.5-7.5" />
          </svg>
        </summary>

        <div class="border-t border-slate-100 px-4 py-4 space-y-4">
          <dl class="grid grid-cols-2 gap-3 text-sm">
            <div>
              <dt class="text-[11px] font-semibold uppercase tracking-wider text-slate-500">Type</dt>
              <dd class="mt-0.5 text-slate-800"><%= request.request_type.humanize %></dd>
            </div>
            <div>
              <dt class="text-[11px] font-semibold uppercase tracking-wider text-slate-500"><%= spare_request_name(request) %></dt>
              <dd class="mt-0.5 font-mono text-slate-800"><%= spare_request_part_number(request) %></dd>
            </div>
            <div class="col-span-2">
              <dt class="text-[11px] font-semibold uppercase tracking-wider text-slate-500">Requested By</dt>
              <dd class="mt-0.5 text-slate-800">
                <% req_name = [request.requested_by&.first_name, request.requested_by&.last_name].compact.join(" ") %>
                <%= req_name.presence || "—" %>
              </dd>
            </div>

            <% if request.activity %>
              <div class="col-span-2 mt-2 pt-2 border-t border-slate-100">
                <dt class="text-[11px] font-semibold uppercase tracking-wider text-slate-500 mb-1">Linked Activity</dt>
                <dd>
                  <%= link_to "Activity ##{request.activity.id}", activity_path(request.activity), class: "inline-block text-sm font-medium text-indigo-600 hover:underline" %>
                  <div class="mt-0.5 text-xs text-slate-500">
                    <%= request.activity.customer&.name || "—" %> · <%= [request.activity.tv_brand&.name, request.activity.tv_size&.size].compact.join(" ") %>
                  </div>
                </dd>
              </div>
            <% end %>
          </dl>

          <div class="flex items-center gap-2 border-t border-slate-100 pt-3">
            <%= link_to spare_request_path(request),  data: { turbo_frame: "_top" },
                class: "flex-1 inline-flex items-center justify-center gap-1.5 rounded-lg border border-slate-200 bg-white px-3 py-2 text-sm font-medium text-indigo-600 transition hover:bg-indigo-50" do %>
              <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke-width="1.8" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" d="M2.036 12.322a1.012 1.012 0 0 1 0-.639C3.423 7.51 7.36 4.5 12 4.5c4.638 0 8.573 3.007 9.963 7.178.07.207.07.431 0 .639C20.577 16.49 16.64 19.5 12 19.5c-4.638 0-8.573-3.007-9.963-7.178Z" />
                <path stroke-linecap="round" stroke-linejoin="round" d="M15 12a3 3 0 1 1-6 0 3 3 0 0 1 6 0Z" />
              </svg>
              View
            <% end %>

            <!-- Mobile Status Inline -->
            <%= form_with model: request,
                url: spare_request_path(request),
                method: :patch,
                data: { turbo_frame: "mobile_#{dom_id(request)}" },
                class: "inline-block" do |f| %>
              <%= f.select :status,
                  SpareRequest.statuses.keys.map { |s| [s.humanize, s] },
                  {},
                  onchange: "this.form.requestSubmit()",
                  data: { controller: "status-color", action: "change->status-color#updateColor", status_color_target: "select" },
                  class: "rounded-md border border-slate-200 bg-white px-2 py-1 text-xs font-medium text-slate-700 shadow-sm focus:border-indigo-500 focus:ring-indigo-500/20 cursor-pointer" %>
            <% end %>
          </div>
        </div>
      </details>
    <% end %>
  <% else %>
    <div class="rounded-xl border border-slate-200 bg-white shadow-sm">
      <div class="flex flex-col items-center justify-center px-6 py-16 text-center">
        <div class="flex h-12 w-12 items-center justify-center rounded-full bg-slate-100">
          <svg class="h-6 w-6 text-slate-400" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" d="M9 12h3.75M9 15h3.75M9 18h3.75m3 .75H18a2.25 2.25 0 0 0 2.25-2.25V6.108c0-1.135-.845-2.098-1.976-2.192a48.424 48.424 0 0 0-1.123-.08m-5.801 0c-.065.21-.1.433-.1.664 0 .414.336.75.75.75h4.5a.75.75 0 0 0 .75-.75 2.25 2.25 0 0 0-.1-.664m-5.8 0A2.251 2.251 0 0 1 13.5 2.25H15c1.012 0 1.867.668 2.15 1.586m-5.8 0c-.376.023-.75.05-1.124.08C9.095 4.01 8.25 4.973 8.25 6.108V8.25m0 0H4.875c-.621 0-1.125.504-1.125 1.125v11.25c0 .621.504 1.125 1.125 1.125h9.75c.621 0 1.125-.504 1.125-1.125V9.375c0-.621-.504-1.125-1.125-1.125H8.25ZM6.75 12h.008v.008H6.75V12Zm0 3h.008v.008H6.75V15Zm0 3h.008v.008H6.75V18Z" />
          </svg>
        </div>
        <h3 class="mt-4 text-sm font-semibold text-slate-900">No spare requests found</h3>
        <p class="mt-1 text-sm text-slate-500">Try a different filter or create a new request.</p>
      </div>
    </div>
  <% end %>
</div>