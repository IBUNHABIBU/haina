<div id="<%= dom_id spare_request %>" class="w-full sm:w-auto my-5 space-y-5">
  <div>
    <strong class="block font-medium mb-1">Activity:</strong>
    <%= spare_request.activity_id %>
  </div>
  <div>
    <strong class="block font-medium mb-1">Spare:</strong>
    <%= spare_request.spare_id %>
  </div>
  <div>
    <strong class="block font-medium mb-1">Requested by:</strong>
    <%= spare_request.requested_by_id %>
  </div>
  <div>
    <strong class="block font-medium mb-1">Issued by:</strong>
    <%= spare_request.issued_by_id %>
  </div>
  <div>
    <strong class="block font-medium mb-1">Requested quantity:</strong>
    <%= spare_request.requested_quantity %>
  </div>
  <div>
    <strong class="block font-medium mb-1">Issued quantity:</strong>
    <%= spare_request.issued_quantity %>
  </div>
  <div>
    <strong class="block font-medium mb-1">Unit cost at issue:</strong>
    <%= spare_request.unit_cost_at_issue %>
  </div>
  <div>
    <strong class="block font-medium mb-1">Status:</strong>
    <%= spare_request.status %>
  </div>
  <div>
    <strong class="block font-medium mb-1">Reason:</strong>
    <%= spare_request.reason %>
  </div>
  <div>
    <strong class="block font-medium mb-1">Store notes:</strong>
    <%= spare_request.store_notes %>
  </div>
  <div>
    <strong class="block font-medium mb-1">Issued at:</strong>
    <%= spare_request.issued_at %>
  </div>
</div>
