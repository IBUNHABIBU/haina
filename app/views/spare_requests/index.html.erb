<% content_for :title, "All Spare Requests" %>

<div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8 py-8 space-y-6">
  <% if notice.present? %>
    <div class="flex items-center gap-2 rounded-lg border border-emerald-200 bg-emerald-50 px-4 py-3 text-sm font-medium text-emerald-700 shadow-sm" id="notice">
      <svg class="h-5 w-5 text-emerald-500" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor">
        <path stroke-linecap="round" stroke-linejoin="round" d="M9 12.75 11.25 15 15 9.75M21 12a9 9 0 1 1-18 0 9 9 0 0 1 18 0Z" />
      </svg>
      <%= notice %>
    </div>
  <% end %>

  <!-- Page header -->
  <div class="flex flex-wrap items-end justify-between gap-2">
    <div>
      <h1 class="text-2xl font-semibold tracking-tight text-slate-900">All Spare Requests</h1>
      <p class="mt-1 text-sm text-slate-500">Activity repairs, workshop requirements and stock replenishment.</p>
    </div>

    <%= link_to new_spare_request_path,
        class: "inline-flex items-center gap-1.5 rounded-lg bg-indigo-600 px-4 py-2.5 text-sm font-semibold text-white shadow-sm transition hover:bg-indigo-500 focus:outline-none focus:ring-2 focus:ring-indigo-500 focus:ring-offset-2" do %>
      <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor">
        <path stroke-linecap="round" stroke-linejoin="round" d="M12 4.5v15m7.5-7.5h-15" />
      </svg>
      New Spare Request
    <% end %>

        <%= link_to spare_requests_path(format: :xlsx),
        class: "inline-flex items-center gap-1.5 rounded-lg border border-slate-200 bg-white px-4 py-2.5 text-sm font-medium text-slate-700 shadow-sm transition hover:bg-slate-50" do %>
      <svg class="h-4 w-4 text-emerald-600" fill="none" viewBox="0 0 24 24" stroke-width="1.8" stroke="currentColor">
        <path stroke-linecap="round" stroke-linejoin="round" d="M3 16.5v2.25A2.25 2.25 0 0 0 5.25 21h13.5A2.25 2.25 0 0 0 21 18.75V16.5M16.5 12 12 16.5m0 0L7.5 12m4.5 4.5V3" />
      </svg>
      Export Excel
    <% end %>
  </div>

  <%# ============================================================
      KPI CARDS
      ============================================================ %>
  <div class="grid gap-4 sm:grid-cols-2 lg:grid-cols-4">
    <!-- Total -->
    <div class="rounded-xl border border-slate-200 bg-white p-5 shadow-sm">
      <div class="flex items-center justify-between">
        <p class="text-xs font-medium uppercase tracking-wider text-slate-500">Total requests</p>
        <div class="flex h-8 w-8 items-center justify-center rounded-lg bg-indigo-50 text-indigo-600">
          <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke-width="1.8" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" d="M9 12h3.75M9 15h3.75M9 18h3.75m3 .75H18a2.25 2.25 0 0 0 2.25-2.25V6.108c0-1.135-.845-2.098-1.976-2.192a48.424 48.424 0 0 0-1.123-.08m-5.801 0c-.065.21-.1.433-.1.664 0 .414.336.75.75.75h4.5a.75.75 0 0 0 .75-.75 2.25 2.25 0 0 0-.1-.664m-5.8 0A2.251 2.251 0 0 1 13.5 2.25H15c1.012 0 1.867.668 2.15 1.586m-5.8 0c-.376.023-.75.05-1.124.08C9.095 4.01 8.25 4.973 8.25 6.108V8.25m0 0H4.875c-.621 0-1.125.504-1.125 1.125v11.25c0 .621.504 1.125 1.125 1.125h9.75c.621 0 1.125-.504 1.125-1.125V9.375c0-.621-.504-1.125-1.125-1.125H8.25ZM6.75 12h.008v.008H6.75V12Zm0 3h.008v.008H6.75V15Zm0 3h.008v.008H6.75V18Z" />
          </svg>
        </div>
      </div>
      <p class="mt-3 text-2xl font-semibold tabular-nums text-slate-900"><%= @spare_requests.size %></p>
      <p class="mt-1 text-xs text-slate-400">All time</p>
    </div>

    <!-- Activity -->
    <div class="rounded-xl border border-slate-200 bg-white p-5 shadow-sm">
      <div class="flex items-center justify-between">
        <p class="text-xs font-medium uppercase tracking-wider text-slate-500">Activity</p>
        <div class="flex h-8 w-8 items-center justify-center rounded-lg bg-blue-50 text-blue-600">
          <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke-width="1.8" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" d="M11.42 15.17 17.25 21A2.652 2.652 0 0 0 21 17.25l-5.877-5.877M11.42 15.17l2.496-3.03c.317-.384.74-.626 1.208-.766M11.42 15.17l-4.655 5.653a2.548 2.548 0 1 1-3.586-3.586l6.837-5.63m5.108-.233c.55-.164 1.163-.188 1.743-.14a4.5 4.5 0 0 0 4.486-6.336l-3.276 3.277a3.004 3.004 0 0 1-2.25-2.25l3.276-3.276a4.5 4.5 0 0 0-6.336 4.486c.091 1.076-.071 2.264-.904 2.95l-.102.085m-1.745 1.437L5.909 7.5H4.5L2.25 3.75l1.5-1.5L7.5 4.5v1.409l4.26 4.26m-1.745 1.437 1.745-1.437m6.615 8.206L15.75 15.75M4.867 19.125h.008v.008h-.008v-.008Z" />
          </svg>
        </div>
      </div>
      <p class="mt-3 text-2xl font-semibold tabular-nums text-slate-900">
        <%= @spare_requests.count { |r| r.request_type == "activity" } %>
      </p>
      <p class="mt-1 text-xs text-slate-400">Repair linked</p>
    </div>

    <!-- Workshop -->
    <div class="rounded-xl border border-slate-200 bg-white p-5 shadow-sm">
      <div class="flex items-center justify-between">
        <p class="text-xs font-medium uppercase tracking-wider text-slate-500">Workshop</p>
        <div class="flex h-8 w-8 items-center justify-center rounded-lg bg-amber-50 text-amber-600">
          <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke-width="1.8" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" d="M11.42 15.17 17.25 21A2.652 2.652 0 0 0 21 17.25l-5.877-5.877M11.42 15.17l2.496-3.03c.317-.384.74-.626 1.208-.766M11.42 15.17l-4.655 5.653a2.548 2.548 0 1 1-3.586-3.586l6.837-5.63m5.108-.233c.55-.164 1.163-.188 1.743-.14a4.5 4.5 0 0 0 4.486-6.336l-3.276 3.277a3.004 3.004 0 0 1-2.25-2.25l3.276-3.276a4.5 4.5 0 0 0-6.336 4.486c.091 1.076-.071 2.264-.904 2.95l-.102.085m-1.745 1.437L5.909 7.5H4.5L2.25 3.75l1.5-1.5L7.5 4.5v1.409l4.26 4.26m-1.745 1.437 1.745-1.437m6.615 8.206L15.75 15.75M4.867 19.125h.008v.008h-.008v-.008Z" />
          </svg>
        </div>
      </div>
      <p class="mt-3 text-2xl font-semibold tabular-nums text-slate-900">
        <%= @spare_requests.count { |r| r.request_type == "workshop" } %>
      </p>
      <p class="mt-1 text-xs text-slate-400">General usage</p>
    </div>

    <!-- Stock -->
    <div class="rounded-xl border border-slate-200 bg-white p-5 shadow-sm">
      <div class="flex items-center justify-between">
        <p class="text-xs font-medium uppercase tracking-wider text-slate-500">Stock Replenish</p>
        <div class="flex h-8 w-8 items-center justify-center rounded-lg bg-emerald-50 text-emerald-600">
          <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke-width="1.8" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" d="M2.25 3h1.386c.51 0 .955.343 1.087.835l.383 1.437M7.5 14.25a3 3 0 0 0-3 3h15.75m-12.75-3h11.218c1.121-2.3 2.1-4.684 2.924-7.138a60.114 60.114 0 0 0-16.536-1.84M7.5 14.25 5.106 5.272M6 20.25a.75.75 0 1 1-1.5 0 .75.75 0 0 1 1.5 0Zm12.75 0a.75.75 0 1 1-1.5 0 .75.75 0 0 1 1.5 0Z" />
          </svg>
        </div>
      </div>
      <p class="mt-3 text-2xl font-semibold tabular-nums text-slate-900">
        <%= @spare_requests.count { |r| r.request_type == "stock_replenishment" } %>
      </p>
      <p class="mt-1 text-xs text-slate-400">For inventory</p>
    </div>
  </div>

  <%# ============================================================
      TABLE
      ============================================================ %>
  <div class="overflow-hidden rounded-xl border border-slate-200 bg-white shadow-sm">
    <div class="overflow-x-auto">
      <table class="min-w-full divide-y divide-slate-200">
        <thead class="bg-slate-50">
          <tr>
            <th class="px-4 py-3 text-left text-xs font-semibold uppercase tracking-wider text-slate-500">Request</th>
            <th class="px-4 py-3 text-left text-xs font-semibold uppercase tracking-wider text-slate-500">Type</th>
            <th class="px-4 py-3 text-left text-xs font-semibold uppercase tracking-wider text-slate-500">Spare</th>
            <th class="px-4 py-3 text-right text-xs font-semibold uppercase tracking-wider text-slate-500">Qty</th>
            <th class="px-4 py-3 text-left text-xs font-semibold uppercase tracking-wider text-slate-500">Linked Activity</th>
            <th class="px-4 py-3 text-left text-xs font-semibold uppercase tracking-wider text-slate-500">Requested By</th>
            <th class="px-4 py-3 text-left text-xs font-semibold uppercase tracking-wider text-slate-500">Status</th>
            <th class="relative px-4 py-3"><span class="sr-only">Actions</span></th>
          </tr>
        </thead>

        <tbody class="divide-y divide-slate-100">
          <% if @spare_requests.any? %>
            <% @spare_requests.each do |request| %>
              <tr id="<%= dom_id request %>" class="group transition hover:bg-slate-50/70">
                
                <!-- Request ID -->
                <td class="whitespace-nowrap px-4 py-3">
                  <span class="inline-flex items-center rounded-md bg-slate-100 px-2 py-1 text-xs font-semibold text-slate-700">
                    #<%= request.id %>
                  </span>
                </td>

                <!-- Type (badge) -->
                <td class="whitespace-nowrap px-4 py-3">
                  <span class="text-sm font-medium text-slate-700">
                    <%= request.request_type.humanize %>
                  </span>
                </td>

                <!-- Spare (Name + Part No) -->
                <td class="px-4 py-3">
                  <div class="text-sm font-medium text-slate-900">
                    <%= request.spare&.name || "Spare unavailable" %>
                  </div>
                  <% if request.spare&.part_number.present? %>
                    <div class="mt-0.5 font-mono text-xs text-slate-500">
                      <%= request.spare.part_number %>
                    </div>
                  <% end %>
                </td>

                <!-- Qty -->
                <td class="whitespace-nowrap px-4 py-3 text-right text-sm font-semibold tabular-nums text-slate-900">
                  <%= request.requested_quantity %>
                </td>

                <!-- Activity & Details (combined) -->
                <td class="px-4 py-3">
                  <% if request.activity %>
                    <div class="text-sm">
                      <%= link_to "Activity ##{request.activity.id}",
                          activity_path(request.activity),
                          class: "font-medium text-indigo-600 transition hover:text-indigo-800 hover:underline" %>
                    </div>
                    <div class="mt-0.5 text-xs text-slate-500 flex flex-wrap gap-1">
                      <span><%= request.activity.customer&.name || "—" %></span>
                      <span>·</span>
                      <span><%= [request.activity.tv_brand&.name, request.activity.tv_size&.size].compact.join(" ") %></span>
                    </div>
                  <% else %>
                    <span class="text-sm text-slate-400 italic">No activity linked</span>
                  <% end %>
                </td>

                <!-- Requested by -->
                <td class="whitespace-nowrap px-4 py-3">
                  <div class="flex items-center gap-2">
                    <% req_name = [request.requested_by&.first_name, request.requested_by&.last_name].compact.join(" ") %>
                    <% if req_name.present? %>
                      <div class="flex h-6 w-6 shrink-0 items-center justify-center rounded-full bg-slate-100 text-[10px] font-semibold text-slate-600">
                        <%= req_name.first.upcase %>
                      </div>
                      <span class="text-sm text-slate-700"><%= req_name %></span>
                    <% else %>
                      <span class="text-sm text-slate-400">—</span>
                    <% end %>
                  </div>
                </td>

                <!-- Status -->
                <td class="whitespace-nowrap px-4 py-3">
                  <% status_str = request.status.to_s.downcase %>
                  <% status_style = case status_str
                     when "pending", "requested" then "bg-amber-50 text-amber-700 ring-amber-200"
                     when "approved" then "bg-blue-50 text-blue-700 ring-blue-200"
                     when "fulfilled", "completed" then "bg-emerald-50 text-emerald-700 ring-emerald-200"
                     when "rejected", "cancelled" then "bg-rose-50 text-rose-700 ring-rose-200"
                     else "bg-slate-100 text-slate-700 ring-slate-200"
                     end %>
                  
                  <span class="inline-flex items-center gap-1.5 rounded-full px-2.5 py-1 text-xs font-medium ring-1 ring-inset <%= status_style %>">
                    <span class="h-1.5 w-1.5 rounded-full <%= status_style.split(" ").last.sub("ring-", "bg-") %>"></span>
                    <%= request.status.humanize %>
                  </span>
                </td>

                <!-- Actions -->
                <td class="whitespace-nowrap px-4 py-3 text-right">
                  <div class="inline-flex items-center justify-end gap-1 opacity-70 transition group-hover:opacity-100">
                    <%= link_to spare_request_path(request), class: "rounded-lg p-1.5 text-indigo-600 transition hover:bg-indigo-50", title: "View" do %>
                      <span class="sr-only">View</span>
                      <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke-width="1.8" stroke="currentColor">
                        <path stroke-linecap="round" stroke-linejoin="round" d="M2.036 12.322a1.012 1.012 0 0 1 0-.639C3.423 7.51 7.36 4.5 12 4.5c4.638 0 8.573 3.007 9.963 7.178.07.207.07.431 0 .639C20.577 16.49 16.64 19.5 12 19.5c-4.638 0-8.573-3.007-9.963-7.178Z" />
                        <path stroke-linecap="round" stroke-linejoin="round" d="M15 12a3 3 0 1 1-6 0 3 3 0 0 1 6 0Z" />
                      </svg>
                    <% end %>
                    
                    <%# Ikiwa una route ya edit %>
                    <%#= link_to edit_spare_request_path(request), class: "...", title: "Edit" do %> 
                  </div>
                </td>
              </tr>
            <% end %>
          <% else %>
            <!-- Empty State -->
            <tr>
              <td colspan="8" class="px-6 py-16 text-center">
                <div class="flex flex-col items-center justify-center">
                  <div class="flex h-12 w-12 items-center justify-center rounded-full bg-slate-100">
                    <svg class="h-6 w-6 text-slate-400" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor">
                      <path stroke-linecap="round" stroke-linejoin="round" d="M9 12h3.75M9 15h3.75M9 18h3.75m3 .75H18a2.25 2.25 0 0 0 2.25-2.25V6.108c0-1.135-.845-2.098-1.976-2.192a48.424 48.424 0 0 0-1.123-.08m-5.801 0c-.065.21-.1.433-.1.664 0 .414.336.75.75.75h4.5a.75.75 0 0 0 .75-.75 2.25 2.25 0 0 0-.1-.664m-5.8 0A2.251 2.251 0 0 1 13.5 2.25H15c1.012 0 1.867.668 2.15 1.586m-5.8 0c-.376.023-.75.05-1.124.08C9.095 4.01 8.25 4.973 8.25 6.108V8.25m0 0H4.875c-.621 0-1.125.504-1.125 1.125v11.25c0 .621.504 1.125 1.125 1.125h9.75c.621 0 1.125-.504 1.125-1.125V9.375c0-.621-.504-1.125-1.125-1.125H8.25ZM6.75 12h.008v.008H6.75V12Zm0 3h.008v.008H6.75V15Zm0 3h.008v.008H6.75V18Z" />
                    </svg>
                  </div>
                  <h3 class="mt-4 text-sm font-semibold text-slate-900">No spare requests found</h3>
                  <p class="mt-1 text-sm text-slate-500">Create your first request to get started.</p>
                  <%= link_to "New Spare Request", new_spare_request_path,
                      class: "mt-6 inline-flex items-center gap-2 rounded-lg bg-indigo-600 px-4 py-2 text-sm font-semibold text-white shadow-sm transition hover:bg-indigo-500" %>
                </div>
              </td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>
  </div>
</div>