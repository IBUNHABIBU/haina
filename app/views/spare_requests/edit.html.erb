<% content_for :title, "Edit Spare Request" %>

<div class="mx-auto max-w-3xl px-4 sm:px-6 lg:px-8 py-8 space-y-6">
  
  <!-- Header -->
  <div>
    <h1 class="text-2xl font-semibold tracking-tight text-slate-900">Edit Spare Request #<%= @spare_request.id %></h1>
    <p class="mt-1 text-sm text-slate-500">
      Update the details of this spare request.
    </p>
  </div>

  <!-- Fomu -->
  <%= render "form", spare_request: @spare_request %>

  <!-- Actions (Back / Show) -->
  <div class="pt-2 flex items-center gap-4">
    <%= link_to spare_request_path(@spare_request), class: "inline-flex items-center gap-1.5 text-sm font-medium text-indigo-600 transition hover:text-indigo-800" do %>
      <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke-width="1.8" stroke="currentColor">
        <path stroke-linecap="round" stroke-linejoin="round" d="M2.036 12.322a1.012 1.012 0 0 1 0-.639C3.423 7.51 7.36 4.5 12 4.5c4.638 0 8.573 3.007 9.963 7.178.07.207.07.431 0 .639C20.577 16.49 16.64 19.5 12 19.5c-4.638 0-8.573-3.007-9.963-7.178Z" />
        <path stroke-linecap="round" stroke-linejoin="round" d="M15 12a3 3 0 1 1-6 0 3 3 0 0 1 6 0Z" />
      </svg>
      Show this request
    <% end %>

    <%= link_to spare_requests_path, class: "inline-flex items-center gap-1.5 text-sm font-medium text-slate-500 transition hover:text-slate-900" do %>
      <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor">
        <path stroke-linecap="round" stroke-linejoin="round" d="M15.75 19.5 8.25 12l7.5-7.5" />
      </svg>
      Back to Spare Requests
    <% end %>
  </div>

</div>