<%= form_with(model: spare_request, class: "contents") do |form| %>
  <% if spare_request.errors.any? %>
    <div id="error_explanation" class="bg-red-50 text-red-500 px-3 py-2 font-medium rounded-md mt-3">
      <h2><%= pluralize(spare_request.errors.count, "error") %> prohibited this spare_request from being saved:</h2>

      <ul class="list-disc ml-6">
        <% spare_request.errors.each do |error| %>
          <li><%= error.full_message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <div class="my-5">
    <%= form.label :activity_id %>
    <%= form.text_field :activity_id, class: ["block shadow-sm rounded-md border px-3 py-2 mt-2 w-full", {"border-gray-400 focus:outline-blue-600": spare_request.errors[:activity_id].none?, "border-red-400 focus:outline-red-600": spare_request.errors[:activity_id].any?}] %>
  </div>

  <div class="my-5">
    <%= form.label :spare_id %>
    <%= form.text_field :spare_id, class: ["block shadow-sm rounded-md border px-3 py-2 mt-2 w-full", {"border-gray-400 focus:outline-blue-600": spare_request.errors[:spare_id].none?, "border-red-400 focus:outline-red-600": spare_request.errors[:spare_id].any?}] %>
  </div>

  <div class="my-5">
    <%= form.label :requested_by_id %>
    <%= form.text_field :requested_by_id, class: ["block shadow-sm rounded-md border px-3 py-2 mt-2 w-full", {"border-gray-400 focus:outline-blue-600": spare_request.errors[:requested_by_id].none?, "border-red-400 focus:outline-red-600": spare_request.errors[:requested_by_id].any?}] %>
  </div>

  <div class="my-5">
    <%= form.label :issued_by_id %>
    <%= form.text_field :issued_by_id, class: ["block shadow-sm rounded-md border px-3 py-2 mt-2 w-full", {"border-gray-400 focus:outline-blue-600": spare_request.errors[:issued_by_id].none?, "border-red-400 focus:outline-red-600": spare_request.errors[:issued_by_id].any?}] %>
  </div>

  <div class="my-5">
    <%= form.label :requested_quantity %>
    <%= form.number_field :requested_quantity, class: ["block shadow-sm rounded-md border px-3 py-2 mt-2 w-full", {"border-gray-400 focus:outline-blue-600": spare_request.errors[:requested_quantity].none?, "border-red-400 focus:outline-red-600": spare_request.errors[:requested_quantity].any?}] %>
  </div>

  <div class="my-5">
    <%= form.label :issued_quantity %>
    <%= form.number_field :issued_quantity, class: ["block shadow-sm rounded-md border px-3 py-2 mt-2 w-full", {"border-gray-400 focus:outline-blue-600": spare_request.errors[:issued_quantity].none?, "border-red-400 focus:outline-red-600": spare_request.errors[:issued_quantity].any?}] %>
  </div>

  <div class="my-5">
    <%= form.label :unit_cost_at_issue %>
    <%= form.text_field :unit_cost_at_issue, class: ["block shadow-sm rounded-md border px-3 py-2 mt-2 w-full", {"border-gray-400 focus:outline-blue-600": spare_request.errors[:unit_cost_at_issue].none?, "border-red-400 focus:outline-red-600": spare_request.errors[:unit_cost_at_issue].any?}] %>
  </div>

  <div class="my-5">
    <%= form.label :status %>
    <%= form.text_field :status, class: ["block shadow-sm rounded-md border px-3 py-2 mt-2 w-full", {"border-gray-400 focus:outline-blue-600": spare_request.errors[:status].none?, "border-red-400 focus:outline-red-600": spare_request.errors[:status].any?}] %>
  </div>

  <div class="my-5">
    <%= form.label :reason %>
    <%= form.textarea :reason, rows: 4, class: ["block shadow-sm rounded-md border px-3 py-2 mt-2 w-full", {"border-gray-400 focus:outline-blue-600": spare_request.errors[:reason].none?, "border-red-400 focus:outline-red-600": spare_request.errors[:reason].any?}] %>
  </div>

  <div class="my-5">
    <%= form.label :store_notes %>
    <%= form.textarea :store_notes, rows: 4, class: ["block shadow-sm rounded-md border px-3 py-2 mt-2 w-full", {"border-gray-400 focus:outline-blue-600": spare_request.errors[:store_notes].none?, "border-red-400 focus:outline-red-600": spare_request.errors[:store_notes].any?}] %>
  </div>

  <div class="my-5">
    <%= form.label :issued_at %>
    <%= form.datetime_field :issued_at, class: ["block shadow-sm rounded-md border px-3 py-2 mt-2 w-full", {"border-gray-400 focus:outline-blue-600": spare_request.errors[:issued_at].none?, "border-red-400 focus:outline-red-600": spare_request.errors[:issued_at].any?}] %>
  </div>

  <div class="inline">
    <%= form.submit class: "w-full sm:w-auto rounded-md px-3.5 py-2.5 bg-blue-600 hover:bg-blue-500 text-white inline-block font-medium cursor-pointer" %>
  </div>
<% end %>
