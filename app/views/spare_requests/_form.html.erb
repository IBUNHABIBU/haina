<%= form_with(
  model: (@activity ? [@activity, spare_request] : spare_request),
  class: "space-y-6"
) do |form| %>

  <%# ============================================================
      ERROR SUMMARY
      ============================================================ %>
  <% if spare_request.errors.any? %>
    <div class="rounded-xl border border-rose-200 bg-rose-50 p-4">
      <div class="flex items-start gap-3">
        <div class="flex h-8 w-8 shrink-0 items-center justify-center rounded-full bg-rose-100 text-rose-600">
          <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" d="M12 9v3.75m9-.75a9 9 0 1 1-18 0 9 9 0 0 1 18 0Zm-9 3.75h.008v.008H12v-.008Z" />
          </svg>
        </div>
        <div class="min-w-0 flex-1">
          <h2 class="text-sm font-semibold text-rose-800">
            Please correct the following errors:
          </h2>
          <ul class="mt-2 list-disc space-y-1 pl-5 text-sm text-rose-700">
            <% spare_request.errors.full_messages.each do |message| %>
              <li><%= message %></li>
            <% end %>
          </ul>
        </div>
      </div>
    </div>
  <% end %>

  <%# ============================================================
      SECTION 1 — REQUEST CONTEXT
      ============================================================ %>
  <section class="overflow-hidden rounded-xl border border-slate-200 bg-white shadow-sm">
    <header class="flex items-center gap-3 border-b border-slate-100 px-6 py-4">
      <div class="flex h-8 w-8 items-center justify-center rounded-lg bg-indigo-50 text-indigo-600">
        <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke-width="1.8" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" d="M9 12h3.75M9 15h3.75M9 18h3.75m3 .75H18a2.25 2.25 0 0 0 2.25-2.25V6.108c0-1.135-.845-2.098-1.976-2.192a48.424 48.424 0 0 0-1.123-.08m-5.801 0c-.065.21-.1.433-.1.664 0 .414.336.75.75.75h4.5a.75.75 0 0 0 .75-.75 2.25 2.25 0 0 0-.1-.664m-5.8 0A2.251 2.251 0 0 1 13.5 2.25H15c1.012 0 1.867.668 2.15 1.586m-5.8 0c-.376.023-.75.05-1.124.08C9.095 4.01 8.25 4.973 8.25 6.108V8.25m0 0H4.875c-.621 0-1.125.504-1.125 1.125v11.25c0 .621.504 1.125 1.125 1.125h9.75c.621 0 1.125-.504 1.125-1.125V9.375c0-.621-.504-1.125-1.125-1.125H8.25ZM6.75 12h.008v.008H6.75V12Zm0 3h.008v.008H6.75V15Zm0 3h.008v.008H6.75V18Z" />
        </svg>
      </div>
      <div>
        <h2 class="text-sm font-semibold text-slate-900">Request Context</h2>
        <p class="text-xs text-slate-500">What kind of spare request is this?</p>
      </div>
    </header>

    <div class="p-6 space-y-5">
      <% if @activity %>
        <!-- Linked Activity Card -->
        <div class="rounded-lg border border-indigo-100 bg-indigo-50/60 p-4">
          <div class="flex items-start gap-3">
            <div class="flex h-9 w-9 shrink-0 items-center justify-center rounded-lg bg-indigo-100 text-indigo-600">
              <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke-width="1.8" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" d="M11.42 15.17 17.25 21A2.652 2.652 0 0 0 21 17.25l-5.877-5.877M11.42 15.17l2.496-3.03c.317-.384.74-.626 1.208-.766M11.42 15.17l-4.655 5.653a2.548 2.548 0 1 1-3.586-3.586l6.837-5.63m5.108-.233c.55-.164 1.163-.188 1.743-.14a4.5 4.5 0 0 0 4.486-6.336l-3.276 3.277a3.004 3.004 0 0 1-2.25-2.25l3.276-3.276a4.5 4.5 0 0 0-6.336 4.486c.091 1.076-.071 2.264-.904 2.95l-.102.085m-1.745 1.437L5.909 7.5H4.5L2.25 3.75l1.5-1.5L7.5 4.5v1.409l4.26 4.26m-1.745 1.437 1.745-1.437m6.615 8.206L15.75 15.75M4.867 19.125h.008v.008h-.008v-.008Z" />
              </svg>
            </div>
            <div>
              <p class="text-xs font-semibold uppercase tracking-wider text-indigo-700">Linked Activity</p>
              <p class="mt-0.5 text-sm font-semibold text-indigo-950">
                Activity #<%= @activity.id %>
                <% if @activity.respond_to?(:model_no) && @activity.model_no.present? %>
                  — <%= @activity.model_no %>
                <% end %>
              </p>
              <p class="mt-1 text-xs text-indigo-700">
                This request will automatically be linked to this activity.
              </p>
            </div>
          </div>
        </div>
      <% else %>
        <div class="grid gap-5 sm:grid-cols-2">
          <div>
            <%= form.label :request_type, "Request type", class: "label" %>
            <%= form.select :request_type,
              [
                ["Workshop spare", "workshop"],
                ["Stock replenishment", "stock_replenishment"],
                ["Activity spare", "activity"]
              ],
              { prompt: "Select request type" },
              class: "field" %>
            <p class="mt-1 text-xs text-slate-400">Choose what the request is for.</p>
          </div>

          <div>
            <%= form.label :activity_id, "Activity (optional)", class: "label" %>
            <%= form.collection_select :activity_id,
              Activity.order(id: :desc),
              :id,
              :id,
              { include_blank: "No activity — workshop or stock request" },
              class: "field" %>
            <p class="mt-1 text-xs text-slate-400">Only if this relates to a specific repair.</p>
          </div>
        </div>
      <% end %>
    </div>
  </section>

  <%# ============================================================
      SECTION 2 — SPARE & QUANTITY
      ============================================================ %>
  <section class="overflow-hidden rounded-xl border border-slate-200 bg-white shadow-sm">
    <header class="flex items-center gap-3 border-b border-slate-100 px-6 py-4">
      <div class="flex h-8 w-8 items-center justify-center rounded-lg bg-emerald-50 text-emerald-600">
        <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke-width="1.8" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" d="m21 7.5-9-5.25L3 7.5m18 0-9 5.25m9-5.25v9l-9 5.25M3 7.5l9 5.25M3 7.5v9l9 5.25m0-9v9" />
        </svg>
      </div>
      <div>
        <h2 class="text-sm font-semibold text-slate-900">Spare Details</h2>
        <p class="text-xs text-slate-500">Which part and how many are needed?</p>
      </div>
    </header>

    <div class="grid gap-5 p-6 sm:grid-cols-2">
      <div>
        <%= form.label :spare_id, "Spare part", class: "label" %>
        <%= form.collection_select :spare_id,
          Spare.order(:part_number),
          :id,
          :part_number,
          { prompt: "Select part number" },
          class: "field" %>
        <p class="mt-1 text-xs text-slate-400">Choose from available stock.</p>
      </div>

      <div>
        <%= form.label :requested_quantity, "Quantity requested", class: "label" %>
        <%= form.number_field :requested_quantity,
          min: 1,
          step: 1,
          required: true,
          class: "field",
          placeholder: "1" %>
        <p class="mt-1 text-xs text-slate-400">How many units are needed?</p>
      </div>
    </div>
  </section>

  <%# ============================================================
      SECTION 3 — REASON
      ============================================================ %>
  <section class="overflow-hidden rounded-xl border border-slate-200 bg-white shadow-sm">
    <header class="flex items-center gap-3 border-b border-slate-100 px-6 py-4">
      <div class="flex h-8 w-8 items-center justify-center rounded-lg bg-amber-50 text-amber-600">
        <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke-width="1.8" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" d="M8.25 6.75h12M8.25 12h12m-12 5.25h12M3.75 6.75h.007v.008H3.75V6.75Zm.375 0a.375.375 0 1 1-.75 0 .375.375 0 0 1 .75 0ZM3.75 12h.007v.008H3.75V12Zm.375 0a.375.375 0 1 1-.75 0 .375.375 0 0 1 .75 0Zm-.375 5.25h.007v.008H3.75v-.008Zm.375 0a.375.375 0 1 1-.75 0 .375.375 0 0 1 .75 0Z" />
        </svg>
      </div>
      <div>
        <h2 class="text-sm font-semibold text-slate-900">Reason for Request</h2>
        <p class="text-xs text-slate-500">Explain why this spare is needed.</p>
      </div>
    </header>

    <div class="p-6">
      <%= form.text_area :reason,
        rows: 4,
        required: true,
        placeholder: "Explain why this spare is required...",
        class: "field" %>
    </div>
  </section>

  <%# ============================================================
      SECTION 4 — STATUS
      ============================================================ %>
  <section class="overflow-hidden rounded-xl border border-slate-200 bg-white shadow-sm">
    <header class="flex items-center gap-3 border-b border-slate-100 px-6 py-4">
      <div class="flex h-8 w-8 items-center justify-center rounded-lg bg-slate-100 text-slate-600">
        <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke-width="1.8" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" d="M9 12.75 11.25 15 15 9.75M21 12a9 9 0 1 1-18 0 9 9 0 0 1 18 0Z" />
        </svg>
      </div>
      <div>
        <h2 class="text-sm font-semibold text-slate-900">Status</h2>
        <p class="text-xs text-slate-500">Current state of this request.</p>
      </div>
    </header>

    <div class="p-6">
      <%= form.select :status,
        SpareRequest.statuses.keys.map { |s| [s.humanize, s] },
        {},
        class: "field" %>
    </div>
  </section>

  <%# ============================================================
      ACTIONS
      ============================================================ %>
  <div class="flex flex-wrap items-center justify-end gap-3 border-t border-slate-200 pt-6">
    <%= link_to "Cancel", spare_requests_path,
        class: "inline-flex items-center gap-1.5 rounded-lg border border-slate-200 bg-white px-4 py-2.5 text-sm font-medium text-slate-700 shadow-sm transition hover:bg-slate-50" %>

    <%= form.submit "Submit Spare Request",
        class: "inline-flex items-center gap-1.5 rounded-lg bg-indigo-600 px-5 py-2.5 text-sm font-semibold text-white shadow-sm transition hover:bg-indigo-500 focus:outline-none focus:ring-2 focus:ring-indigo-500 focus:ring-offset-2 cursor-pointer" %>
  </div>
<% end %>