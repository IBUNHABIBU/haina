
<%= form_with(
  model: (@activity ? [@activity, spare_request] : spare_request),
  class: "space-y-5"
) do |form| %>

  <% if spare_request.errors.any? %>
    <div class="rounded-lg bg-red-50 p-4 text-red-700">
      <h2 class="font-semibold">
        Please correct the following errors:
      </h2>
      <ul class="mt-2 list-disc pl-5">
        <% spare_request.errors.full_messages.each do |message| %>
          <li><%= message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <% if @activity %>
    <div class="rounded-lg bg-indigo-50 p-4">
      <p class="text-sm text-indigo-700">Activity</p>
      <p class="font-semibold text-indigo-950">
        Activity #<%= @activity.id %>
        <% if @activity.respond_to?(:model_no) && @activity.model_no.present? %>
          — <%= @activity.model_no %>
        <% end %>
      </p>
      <p class="mt-1 text-sm text-indigo-800">
        This request will automatically be linked to this activity.
      </p>
    </div>
  <% else %>
    <div>
      <%= form.label :request_type, "Request type",
        class: "block font-medium" %>

      <%= form.select :request_type,
        [
          ["Workshop spare", "workshop"],
          ["Stock replenishment", "stock_replenishment"],
          ["Activity spare", "activity"]
        ],
        { prompt: "Select request type" },
        class: "mt-2 block w-full rounded-lg border px-3 py-2" %>
    </div>

    <div>
      <%= form.label :activity_id, "Activity (if applicable)",
        class: "block font-medium" %>

      <%= form.collection_select :activity_id,
        Activity.order(id: :desc),
        :id,
        :id,
        { include_blank: "No activity — workshop or stock request" },
        class: "mt-2 block w-full rounded-lg border px-3 py-2" %>
    </div>
  <% end %>

  <div>
    <%= form.label :spare_id, "Spare part",
      class: "block font-medium" %>

      <%= form.collection_select :spare_id,
      Spare.order(:part_number),
      :id,
      :part_number,
      { prompt: "Select part number" },
      class: "mt-2 block w-full rounded-lg border px-3 py-2" %>
  </div>

  <div>
    <%= form.label :requested_quantity, "Quantity requested",
      class: "block font-medium" %>

    <%= form.number_field :requested_quantity,
      min: 1,
      step: 1,
      required: true,
      class: "mt-2 block w-full rounded-lg border px-3 py-2" %>
  </div>

  <div>
    <%= form.label :reason, "Reason for request",
      class: "block font-medium" %>

    <%= form.text_area :reason,
      rows: 4,
      required: true,
      placeholder: "Explain why this spare is required...",
      class: "mt-2 block w-full rounded-lg border px-3 py-2" %>
  </div>

  <div>
    <%= form.submit "Submit Spare Request",
      class: "rounded-lg bg-indigo-600 px-5 py-3 font-semibold text-white hover:bg-indigo-700" %>
  </div>
<% end %>
