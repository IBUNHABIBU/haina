<% content_for :title, "New Spare Request" %>

<div class="mx-auto w-full max-w-2xl px-4 py-6">
  <h1 class="text-3xl font-bold text-gray-900">
    New Spare Request
  </h1>

  <p class="mt-2 text-gray-600">
    Request a spare for an activity, workshop use, or stock replenishment.
  </p>

  <div class="mt-6 rounded-xl border bg-white p-6 shadow-sm">
    <%= render "form", spare_request: @spare_request %>
  </div>

  <div class="mt-4">
    <% if @activity %>
      <%= link_to "Back to Activity", activity_path(@activity),
        class: "text-indigo-600 hover:underline" %>
    <% else %>
      <%= link_to "Back to Spare Requests", spare_requests_path,
        class: "text-indigo-600 hover:underline" %>
    <% end %>
  </div>
</div>