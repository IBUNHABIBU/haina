<% content_for :title, "New Spare Request" %>

<div class="mx-auto max-w-3xl px-4 sm:px-6 lg:px-8 py-8 space-y-6">
  
  <!-- Header -->
  <div>
    <h1 class="text-2xl font-semibold tracking-tight text-slate-900">New Spare Request</h1>
    <p class="mt-1 text-sm text-slate-500">
      Request a spare for an activity, workshop use, or stock replenishment.
    </p>
  </div>

  <!-- Fomu -->
  <%= render "form", spare_request: @spare_request %>

  <!-- Back Link -->
  <div class="pt-2">
    <% if @activity %>
      <%= link_to activity_path(@activity), class: "inline-flex items-center gap-1.5 text-sm font-medium text-slate-500 transition hover:text-slate-900" do %>
        <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" d="M15.75 19.5 8.25 12l7.5-7.5" />
        </svg>
        Back to Activity
      <% end %>
    <% else %>
      <%= link_to spare_requests_path, class: "inline-flex items-center gap-1.5 text-sm font-medium text-slate-500 transition hover:text-slate-900" do %>
        <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" d="M15.75 19.5 8.25 12l7.5-7.5" />
        </svg>
        Back to Spare Requests
      <% end %>
    <% end %>
  </div>

</div>