<div id="<%= dom_id activity %>" class="w-full sm:w-auto my-5 space-y-5">
  <div>
    <strong class="block font-medium mb-1">Customer:</strong>
    <%= activity.customer %>
  </div>
  <div>
    <strong class="block font-medium mb-1">Phone:</strong>
    <%= activity.phone %>
  </div>
  <div>
    <strong class="block font-medium mb-1">Tv brand:</strong>
    <%= activity.TV_brand %>
  </div>
  <div>
    <strong class="block font-medium mb-1">Tv size:</strong>
    <%= activity.TV_size %>
  </div>
  <div>
    <strong class="block font-medium mb-1">Model no:</strong>
    <%= activity.model_no %>
  </div>
  <div>
    <strong class="block font-medium mb-1">Date in:</strong>
    <%= activity.date_in %>
  </div>
  <div>
    <strong class="block font-medium mb-1">Date out:</strong>
    <%= activity.date_out %>
  </div>
  <div>
    <strong class="block font-medium mb-1">Starting price:</strong>
    <%= activity.starting_price %>
  </div>
  <div>
    <strong class="block font-medium mb-1">Final price:</strong>
    <%= activity.final_price %>
