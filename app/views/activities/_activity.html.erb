    <strong class="block font-medium mb-1">Spare used:</strong>
    <%= activity.spare_used %>
  </div>
  <div>
    <strong class="block font-medium mb-1">Cost each:</strong>
    <%= activity.cost_each %>
  </div>
  <div>
    <strong class="block font-medium mb-1">Total cost:</strong>
    <%= activity.total_cost %>
  </div>
  <div>
    <strong class="block font-medium mb-1">Profit:</strong>
    <%= activity.profit %>
  </div>
  <div>
    <strong class="block font-medium mb-1">Remarks:</strong>
    <%= activity.remarks %>
  </div>
</div>
