<%= form_with(model: activity, class: "contents") do |form| %>
  <% if activity.errors.any? %>
    <div id="error_explanation" class="bg-red-50 text-red-500 px-3 py-2 font-medium rounded-md mt-3">
      <h2><%= pluralize(activity.errors.count, "error") %> prohibited this activity from being saved:</h2>

      <ul class="list-disc ml-6">
        <% activity.errors.each do |error| %>
          <li><%= error.full_message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <div class="my-5">
    <%= form.label :customer %>
    <%= form.text_field :customer, class: ["block shadow-sm rounded-md border px-3 py-2 mt-2 w-full", {"border-gray-400 focus:outline-blue-600": activity.errors[:customer].none?, "border-red-400 focus:outline-red-600": activity.errors[:customer].any?}] %>
  </div>

  <div class="my-5">
    <%= form.label :phone %>
    <%= form.text_field :phone, class: ["block shadow-sm rounded-md border px-3 py-2 mt-2 w-full", {"border-gray-400 focus:outline-blue-600": activity.errors[:phone].none?, "border-red-400 focus:outline-red-600": activity.errors[:phone].any?}] %>
  </div>

  <div class="my-5">
    <%= form.label :TV_brand %>
    <%= form.text_field :TV_brand, class: ["block shadow-sm rounded-md border px-3 py-2 mt-2 w-full", {"border-gray-400 focus:outline-blue-600": activity.errors[:TV_brand].none?, "border-red-400 focus:outline-red-600": activity.errors[:TV_brand].any?}] %>
  </div>

  <div class="my-5">
    <%= form.label :TV_size %>
    <%= form.number_field :TV_size, class: ["block shadow-sm rounded-md border px-3 py-2 mt-2 w-full", {"border-gray-400 focus:outline-blue-600": activity.errors[:TV_size].none?, "border-red-400 focus:outline-red-600": activity.errors[:TV_size].any?}] %>
  </div>

  <div class="my-5">
    <%= form.label :model_no %>
    <%= form.number_field :model_no, class: ["block shadow-sm rounded-md border px-3 py-2 mt-2 w-full", {"border-gray-400 focus:outline-blue-600": activity.errors[:model_no].none?, "border-red-400 focus:outline-red-600": activity.errors[:model_no].any?}] %>
  </div>

  <div class="my-5">
    <%= form.label :date_in %>
    <%= form.datetime_field :date_in, class: ["block shadow-sm rounded-md border px-3 py-2 mt-2 w-full", {"border-gray-400 focus:outline-blue-600": activity.errors[:date_in].none?, "border-red-400 focus:outline-red-600": activity.errors[:date_in].any?}] %>
  </div>

  <div class="my-5">
    <%= form.label :date_out %>
    <%= form.datetime_field :date_out, class: ["block shadow-sm rounded-md border px-3 py-2 mt-2 w-full", {"border-gray-400 focus:outline-blue-600": activity.errors[:date_out].none?, "border-red-400 focus:outline-red-600": activity.errors[:date_out].any?}] %>
  </div>

  <div class="my-5">
    <%= form.label :starting_price %>
    <%= form.text_field :starting_price, class: ["block shadow-sm rounded-md border px-3 py-2 mt-2 w-full", {"border-gray-400 focus:outline-blue-600": activity.errors[:starting_price].none?, "border-red-400 focus:outline-red-600": activity.errors[:starting_price].any?}] %>
  </div>

  <div class="my-5">
    <%= form.label :final_price %>
    <%= form.text_field :final_price, class: ["block shadow-sm rounded-md border px-3 py-2 mt-2 w-full", {"border-gray-400 focus:outline-blue-600": activity.errors[:final_price].none?, "border-red-400 focus:outline-red-600": activity.errors[:final_price].any?}] %>
  </div>

  <div class="my-5">
    <%= form.label :status %>
    <%= form.number_field :status, class: ["block shadow-sm rounded-md border px-3 py-2 mt-2 w-full", {"border-gray-400 focus:outline-blue-600": activity.errors[:status].none?, "border-red-400 focus:outline-red-600": activity.errors[:status].any?}] %>
  </div>

  <div class="my-5">
    <%= form.label :spare_used %>
    <%= form.number_field :spare_used, class: ["block shadow-sm rounded-md border px-3 py-2 mt-2 w-full", {"border-gray-400 focus:outline-blue-600": activity.errors[:spare_used].none?, "border-red-400 focus:outline-red-600": activity.errors[:spare_used].any?}] %>
  </div>

  <div class="my-5">
    <%= form.label :cost_each %>
    <%= form.text_field :cost_each, class: ["block shadow-sm rounded-md border px-3 py-2 mt-2 w-full", {"border-gray-400 focus:outline-blue-600": activity.errors[:cost_each].none?, "border-red-400 focus:outline-red-600": activity.errors[:cost_each].any?}] %>
  </div>

  <div class="my-5">
    <%= form.label :total_cost %>
    <%= form.text_field :total_cost, class: ["block shadow-sm rounded-md border px-3 py-2 mt-2 w-full", {"border-gray-400 focus:outline-blue-600": activity.errors[:total_cost].none?, "border-red-400 focus:outline-red-600": activity.errors[:total_cost].any?}] %>
  </div>

  <div class="my-5">
    <%= form.label :profit %>
    <%= form.text_field :profit, class: ["block shadow-sm rounded-md border px-3 py-2 mt-2 w-full", {"border-gray-400 focus:outline-blue-600": activity.errors[:profit].none?, "border-red-400 focus:outline-red-600": activity.errors[:profit].any?}] %>
  </div>

  <div class="my-5">
    <%= form.label :remarks %>
    <%= form.textarea :remarks, rows: 4, class: ["block shadow-sm rounded-md border px-3 py-2 mt-2 w-full", {"border-gray-400 focus:outline-blue-600": activity.errors[:remarks].none?, "border-red-400 focus:outline-red-600": activity.errors[:remarks].any?}] %>
  </div>

  <div class="inline">
    <%= form.submit class: "w-full sm:w-auto rounded-md px-3.5 py-2.5 bg-blue-600 hover:bg-blue-500 text-white inline-block font-medium cursor-pointer" %>
  </div>
<% end %>
