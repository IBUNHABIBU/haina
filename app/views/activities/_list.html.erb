<% if activities.any? %>

  <%# ===================== DESKTOP TABLE ===================== %>
  <div class="hidden md:block overflow-hidden rounded-xl border border-slate-200 bg-white shadow-sm">
    <div class="overflow-x-auto">
      <table class="min-w-full divide-y divide-slate-200">
        <thead class="bg-slate-50">
          <tr>
            <th class="px-4 py-3 text-left text-xs font-semibold uppercase tracking-wider text-slate-500">Date</th>
            <th class="px-4 py-3 text-left text-xs font-semibold uppercase tracking-wider text-slate-500">Customer</th>
            <th class="px-4 py-3 text-left text-xs font-semibold uppercase tracking-wider text-slate-500">TV</th>
            <th class="px-4 py-3 text-left text-xs font-semibold uppercase tracking-wider text-slate-500">Problem</th>
            <th class="px-4 py-3 text-left text-xs font-semibold uppercase tracking-wider text-slate-500">Status</th>
            <th class="px-4 py-3 text-right text-xs font-semibold uppercase tracking-wider text-slate-500">Price</th>
            <% if current_user.super_admin? %>
              <th class="px-4 py-3 text-right text-xs font-semibold uppercase tracking-wider text-slate-500">Gross profit</th>
            <% end %>
            <th class="px-4 py-3 text-left text-xs font-semibold uppercase tracking-wider text-slate-500">History</th>
            <th class="relative px-4 py-3"><span class="sr-only">Actions</span></th>
          </tr>
        </thead>
        <tbody class="divide-y divide-slate-100">
          <% activities.each do |activity| %>
            <tr id="<%= dom_id activity %>" class="group transition hover:bg-slate-50/70">
              <td class="whitespace-nowrap px-4 py-3 text-sm text-slate-600">
                <%= activity.date_in&.in_time_zone("Africa/Dar_es_Salaam")&.strftime("%d %b %Y, %H:%M") || "—" %>
              </td>
              <td class="whitespace-nowrap px-4 py-3">
                <div class="flex items-center gap-3">
                  <div class="flex h-8 w-8 shrink-0 items-center justify-center rounded-full bg-indigo-100 text-xs font-semibold text-indigo-700">
                    <%= activity.customer&.name.to_s.first&.upcase || "?" %>
                  </div>
                  <div>
                    <div class="text-sm font-medium text-slate-900"><%= highlight_search(activity.customer&.name, query) || "—" %></div>
                    <% if activity.customer&.phone.present? %>
                      <div class="text-xs text-slate-500"><%= highlight_search(activity.customer.phone, query) %></div>
                    <% end %>
                  </div>
                </div>
              </td>
              <td class="whitespace-nowrap px-4 py-3 text-sm text-slate-600">
                <%= [activity.tv_brand&.name, activity.tv_size&.size].compact.join(" ").presence || "—" %>
              </td>
              <td class="whitespace-nowrap px-4 py-3 text-sm text-slate-600"><%= activity.tatizo&.name || "—" %></td>
              <td class="whitespace-nowrap px-4 py-3">
                <span class="inline-flex items-center gap-1.5 rounded-full bg-slate-100 px-2.5 py-1 text-xs font-medium text-slate-700">
                  <span class="h-1.5 w-1.5 rounded-full bg-slate-400"></span>
                  <%= activity.status&.humanize || "Not set" %>
                </span>
              </td>
              <td class="whitespace-nowrap px-4 py-3 text-right text-sm font-medium tabular-nums text-slate-900">
                <%= number_to_currency(activity.price, unit: "TSh ", precision: 0) %>
              </td>
              <% if current_user.super_admin? %>
                <td class="whitespace-nowrap px-4 py-3 text-right text-sm font-semibold tabular-nums
                  <%= activity.gross_profit.to_f.positive? ? "text-emerald-600" : activity.gross_profit.to_f.negative? ? "text-rose-600" : "text-slate-500" %>">
                  <%= number_to_currency(activity.gross_profit, unit: "TSh ", precision: 0) %>
                </td>
              <% end %>
              <td class="whitespace-nowrap px-4 py-3">
                <% edit_count = activity.versions.where(event: "update").count %>
                <% if edit_count.positive? %>
                  <%= link_to activity_versions_path(item_type: "Activity", item_id: activity.id),
                      class: "inline-flex items-center gap-1 rounded-md bg-amber-50 px-2 py-1 text-xs font-medium text-amber-700 transition hover:bg-amber-100" do %>
                    <svg class="h-3.5 w-3.5" fill="none" viewBox="0 0 24 24" stroke-width="1.8" stroke="currentColor">
                      <path stroke-linecap="round" stroke-linejoin="round" d="M12 6v6l4 2m6-2a10 10 0 1 1-20 0 10 10 0 0 1 20 0Z" />
                    </svg>
                    <%= pluralize(edit_count, "edit") %>
                  <% end %>
                <% else %>
                  <span class="text-xs text-slate-400">No edits</span>
                <% end %>
              </td>
              <td class="whitespace-nowrap px-4 py-3 text-right">
                <div class="inline-flex items-center justify-end gap-1 opacity-70 transition group-hover:opacity-100">
                  <%= link_to activity, class: "rounded-lg p-1.5 text-indigo-600 transition hover:bg-indigo-50", title: "View" do %>
                    <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke-width="1.8" stroke="currentColor">
                      <path stroke-linecap="round" stroke-linejoin="round" d="M2.036 12.322a1.012 1.012 0 0 1 0-.639C3.423 7.51 7.36 4.5 12 4.5c4.638 0 8.573 3.007 9.963 7.178.07.207.07.431 0 .639C20.577 16.49 16.64 19.5 12 19.5c-4.638 0-8.573-3.007-9.963-7.178Z" />
                      <path stroke-linecap="round" stroke-linejoin="round" d="M15 12a3 3 0 1 1-6 0 3 3 0 0 1 6 0Z" />
                    </svg>
                  <% end %>
                  <%= link_to edit_activity_path(activity), class: "rounded-lg p-1.5 text-slate-500 transition hover:bg-slate-100 hover:text-slate-800", title: "Edit" do %>
                    <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke-width="1.8" stroke="currentColor">
                      <path stroke-linecap="round" stroke-linejoin="round" d="m16.862 4.487 1.687-1.688a1.875 1.875 0 1 1 2.652 2.652L10.582 16.07a4.5 4.5 0 0 1-1.897 1.13L6 18l.8-2.685a4.5 4.5 0 0 1 1.13-1.897l8.932-8.931Z" />
                    </svg>
                  <% end %>
                  <% if current_user.super_admin? %>
                    <%= button_to activity, method: :delete, data: { turbo_confirm: "Are you sure?" },
                        class: "rounded-lg p-1.5 text-rose-500 transition hover:bg-rose-50 hover:text-rose-700 cursor-pointer", title: "Delete" do %>
                      <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke-width="1.8" stroke="currentColor">
                        <path stroke-linecap="round" stroke-linejoin="round" d="m14.74 9-.346 9m-4.788 0L9.26 9m9.968-3.21c.342.052.682.107 1.022.166m-1.022-.165L18.16 19.673a2.25 2.25 0 0 1-2.244 2.077H8.084a2.25 2.25 0 0 1-2.244-2.077L4.772 5.79m14.456 0a48.108 48.108 0 0 0-3.478-.397m-12 .562c.34-.059.68-.114 1.022-.165m0 0a48.11 48.11 0 0 1 3.478-.397m7.5 0v-.916c0-1.18-.91-2.164-2.09-2.201a51.964 51.964 0 0 0-3.32 0c-1.18.037-2.09 1.022-2.09 2.201v.916m7.5 0a48.667 48.667 0 0 0-7.5 0" />
                      </svg>
                    <% end %>
                  <% end %>
                </div>
              </td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>
  </div>

  <%# ===================== MOBILE CARDS ===================== %>
  <div class="md:hidden space-y-3">
    <% activities.each do |activity| %>
      <details id="<%= dom_id activity %>" class="group rounded-xl border border-slate-200 bg-white shadow-sm open:shadow-md">
        <summary class="flex cursor-pointer items-center gap-3 px-4 py-3 list-none [&::-webkit-details-marker]:hidden">
          <div class="flex h-9 w-9 shrink-0 items-center justify-center rounded-full bg-indigo-100 text-xs font-semibold text-indigo-700">
            <%= activity.customer&.name.to_s.first&.upcase || "?" %>
          </div>

          <div class="min-w-0 flex-1">
            <p class="truncate text-sm font-semibold text-slate-900">
              <%= activity.customer&.name || "—" %>
            </p>
            <p class="mt-0.5 text-xs text-slate-500">
              <%= activity.date_in&.in_time_zone("Africa/Dar_es_Salaam")&.strftime("%d %b %Y, %H:%M") || "—" %>
            </p>
          </div>

          <div class="flex flex-col items-end gap-1">
            <span class="text-sm font-semibold tabular-nums text-slate-900">
              <%= number_to_currency(activity.price, unit: "TSh ", precision: 0) %>
            </span>
            <span class="inline-flex items-center gap-1 rounded-full bg-slate-100 px-2 py-0.5 text-[10px] font-medium text-slate-700">
              <span class="h-1.5 w-1.5 rounded-full bg-slate-400"></span>
              <%= activity.status&.humanize || "Not set" %>
            </span>
          </div>

          <svg class="h-4 w-4 shrink-0 text-slate-400 transition-transform duration-200 group-open:rotate-180" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" d="m19.5 8.25-7.5 7.5-7.5-7.5" />
          </svg>
        </summary>

        <div class="border-t border-slate-100 px-4 py-4 space-y-3">
          <dl class="grid grid-cols-2 gap-3 text-sm">
            <div>
              <dt class="text-[11px] font-semibold uppercase tracking-wider text-slate-500">TV</dt>
              <dd class="mt-0.5 text-slate-800">
                <%= [activity.tv_brand&.name, activity.tv_size&.size].compact.join(" ").presence || "—" %>
              </dd>
            </div>
            <div>
              <dt class="text-[11px] font-semibold uppercase tracking-wider text-slate-500">Problem</dt>
              <dd class="mt-0.5 text-slate-800"><%= activity.tatizo&.name || "—" %></dd>
            </div>
            <div>
              <dt class="text-[11px] font-semibold uppercase tracking-wider text-slate-500">Price</dt>
              <dd class="mt-0.5 font-medium tabular-nums text-slate-900">
                <%= number_to_currency(activity.price, unit: "TSh ", precision: 0) %>
              </dd>
            </div>
            <% if current_user.super_admin? %>
              <div>
                <dt class="text-[11px] font-semibold uppercase tracking-wider text-slate-500">Gross profit</dt>
                <dd class="mt-0.5 font-semibold tabular-nums
                  <%= activity.gross_profit.to_f.positive? ? "text-emerald-600" : activity.gross_profit.to_f.negative? ? "text-rose-600" : "text-slate-500" %>">
                  <%= number_to_currency(activity.gross_profit, unit: "TSh ", precision: 0) %>
                </dd>
              </div>
            <% end %>
          </dl>

          <div class="flex items-center justify-between border-t border-slate-100 pt-3">
            <% edit_count = activity.versions.where(event: "update").count %>
            <% if edit_count.positive? %>
              <%= link_to activity_versions_path(item_type: "Activity", item_id: activity.id),
                  class: "inline-flex items-center gap-1 rounded-md bg-amber-50 px-2 py-1 text-xs font-medium text-amber-700 transition hover:bg-amber-100" do %>
                <svg class="h-3.5 w-3.5" fill="none" viewBox="0 0 24 24" stroke-width="1.8" stroke="currentColor">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M12 6v6l4 2m6-2a10 10 0 1 1-20 0 10 10 0 0 1 20 0Z" />
                </svg>
                <%= pluralize(edit_count, "edit") %>
              <% end %>
            <% else %>
              <span class="text-xs text-slate-400">No edits</span>
            <% end %>
          </div>

          <div class="flex items-center gap-2 border-t border-slate-100 pt-3">
            <%= link_to activity,
                class: "flex-1 inline-flex items-center justify-center gap-1.5 rounded-lg border border-slate-200 bg-white px-3 py-2 text-sm font-medium text-indigo-600 transition hover:bg-indigo-50" do %>
              <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke-width="1.8" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" d="M2.036 12.322a1.012 1.012 0 0 1 0-.639C3.423 7.51 7.36 4.5 12 4.5c4.638 0 8.573 3.007 9.963 7.178.07.207.07.431 0 .639C20.577 16.49 16.64 19.5 12 19.5c-4.638 0-8.573-3.007-9.963-7.178Z" />
                <path stroke-linecap="round" stroke-linejoin="round" d="M15 12a3 3 0 1 1-6 0 3 3 0 0 1 6 0Z" />
              </svg>
              View
            <% end %>

            <%= link_to edit_activity_path(activity),
                class: "flex-1 inline-flex items-center justify-center gap-1.5 rounded-lg border border-slate-200 bg-white px-3 py-2 text-sm font-medium text-slate-700 transition hover:bg-slate-50" do %>
              <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke-width="1.8" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" d="m16.862 4.487 1.687-1.688a1.875 1.875 0 1 1 2.652 2.652L10.582 16.07a4.5 4.5 0 0 1-1.897 1.13L6 18l.8-2.685a4.5 4.5 0 0 1 1.13-1.897l8.932-8.931Z" />
              </svg>
              Edit
            <% end %>

            <% if current_user.super_admin? %>
              <%= button_to activity, method: :delete,
                  data: { turbo_confirm: "Are you sure?" },
                  class: "inline-flex items-center justify-center gap-1.5 rounded-lg border border-rose-200 bg-white px-3 py-2 text-sm font-medium text-rose-600 transition hover:bg-rose-50 cursor-pointer" do %>
                <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke-width="1.8" stroke="currentColor">
                  <path stroke-linecap="round" stroke-linejoin="round" d="m14.74 9-.346 9m-4.788 0L9.26 9m9.968-3.21c.342.052.682.107 1.022.166m-1.022-.165L18.16 19.673a2.25 2.25 0 0 1-2.244 2.077H8.084a2.25 2.25 0 0 1-2.244-2.077L4.772 5.79m14.456 0a48.108 48.108 0 0 0-3.478-.397m-12 .562c.34-.059.68-.114 1.022-.165m0 0a48.11 48.11 0 0 1 3.478-.397m7.5 0v-.916c0-1.18-.91-2.164-2.09-2.201a51.964 51.964 0 0 0-3.32 0c-1.18.037-2.09 1.022-2.09 2.201v.916m7.5 0a48.667 48.667 0 0 0-7.5 0" />
                </svg>
              <% end %>
            <% end %>
          </div>
        </div>
      </details>
    <% end %>
  </div>

<% else %>
  <%# ===================== EMPTY STATE ===================== %>
  <div class="flex flex-col items-center justify-center rounded-xl border border-dashed border-slate-300 bg-white px-6 py-16 text-center">
    <div class="flex h-12 w-12 items-center justify-center rounded-full bg-slate-100">
      <% if query.present? %>
        <svg class="h-6 w-6 text-slate-400" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" d="m21 21-5.197-5.197m0 0A7.5 7.5 0 1 0 5.196 5.196a7.5 7.5 0 0 0 10.607 10.607Z" />
        </svg>
      <% else %>
        <svg class="h-6 w-6 text-slate-400" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" d="M11.42 15.17 17.25 21A2.652 2.652 0 0 0 21 17.25l-5.877-5.877M11.42 15.17l2.496-3.03c.317-.384.74-.626 1.208-.766M11.42 15.17l-4.655 5.653a2.548 2.548 0 1 1-3.586-3.586l6.837-5.63m5.108-.233c.55-.164 1.163-.188 1.743-.14a4.5 4.5 0 0 0 4.486-6.336l-3.276 3.277a3.004 3.004 0 0 1-2.25-2.25l3.276-3.276a4.5 4.5 0 0 0-6.336 4.486c.091 1.076-.071 2.264-.904 2.95l-.102.085m-1.745 1.437L5.909 7.5H4.5L2.25 3.75l1.5-1.5L7.5 4.5v1.409l4.26 4.26m-1.745 1.437 1.745-1.437m6.615 8.206L15.75 15.75M4.867 19.125h.008v.008h-.008v-.008Z" />
        </svg>
      <% end %>
    </div>
    <% if query.present? %>
      <h3 class="mt-4 text-sm font-semibold text-slate-900">No activities match "<%= query %>"</h3>
      <p class="mt-1 text-sm text-slate-500">Try a different customer, phone, TV, or problem.</p>
      <%= link_to "Clear search", activities_path,
          data: { turbo_frame: "activities", turbo_action: "advance" },
          class: "mt-6 inline-flex items-center gap-2 rounded-lg border border-slate-200 bg-white px-4 py-2 text-sm font-medium text-slate-700 shadow-sm transition hover:bg-slate-50" %>
    <% else %>
      <h3 class="mt-4 text-sm font-semibold text-slate-900">No activities yet</h3>
      <p class="mt-1 text-sm text-slate-500">Get started by logging your first repair activity.</p>
      <%= link_to "New Activity", new_activity_path,
          class: "mt-6 inline-flex items-center gap-2 rounded-lg bg-indigo-600 px-4 py-2 text-sm font-semibold text-white shadow-sm transition hover:bg-indigo-500" %>
    <% end %>
  </div>
<% end %>