<% content_for :title, "Activities" %>

<div class="w-full max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
  <% if notice.present? %>
    <div class="mb-6 bg-green-50 border-l-4 border-green-500 text-green-700 p-4 rounded-md" id="notice">
      <p class="font-medium"><%= notice %></p>
    </div>
  <% end %>

  <!-- Header Section -->
  <div class="flex flex-col sm:flex-row justify-between items-start sm:items-center gap-4 mb-6 pb-4 border-b border-gray-200">
    <h1 class="font-bold text-3xl sm:text-4xl text-gray-900 flex items-center gap-3">
      <svg class="w-8 h-8 text-blue-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2"/>
      </svg>
      Activities
    </h1>
    <div class="flex flex-wrap gap-2">
      <!-- Column Toggle Button -->
      <button id="toggleColumnsBtn" 
              data-action="click->column-toggle#toggle" 
              class="inline-flex items-center gap-2 px-4 py-2.5 bg-gray-100 hover:bg-gray-200 text-gray-700 font-medium rounded-lg transition duration-150">
        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6a2 2 0 012-2h2a2 2 0 012 2v2a2 2 0 01-2 2H6a2 2 0 01-2-2V6zM14 6a2 2 0 012-2h2a2 2 0 012 2v2a2 2 0 01-2 2h-2a2 2 0 01-2-2V6zM4 16a2 2 0 012-2h2a2 2 0 012 2v2a2 2 0 01-2 2H6a2 2 0 01-2-2v-2zM14 16a2 2 0 012-2h2a2 2 0 012 2v2a2 2 0 01-2 2h-2a2 2 0 01-2-2v-2z"/>
        </svg>
        Columns
        <span class="bg-blue-100 text-blue-800 text-xs font-medium px-2 py-0.5 rounded-full">
          <span data-column-toggle-target="count"><%= 18 %></span>
        </span>
      </button>
      
      <%= link_to new_activity_path, class: "inline-flex items-center gap-2 px-4 py-2.5 bg-blue-600 hover:bg-blue-700 text-white font-medium rounded-lg shadow-sm hover:shadow-md transition duration-150" do %>
        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4"/>
        </svg>
        New Activity
      <% end %>
    </div>
  </div>

  <!-- Column Toggle Panel -->
  <div id="columnTogglePanel" 
       class="hidden mb-6 bg-white rounded-xl shadow-lg border border-gray-200 p-4"
       data-column-toggle-target="panel">
    <div class="flex justify-between items-center mb-3">
      <h3 class="text-sm font-medium text-gray-700">Toggle Columns</h3>
      <div class="flex gap-2">
        <button data-action="click->column-toggle#showAll" 
                class="text-xs text-blue-600 hover:text-blue-800 font-medium">
          Show All
        </button>
        <span class="text-gray-300">|</span>
        <button data-action="click->column-toggle#hideAll" 
                class="text-xs text-blue-600 hover:text-blue-800 font-medium">
          Hide All
        </button>
      </div>
    </div>
    <div class="grid grid-cols-2 sm:grid-cols-3 md:grid-cols-4 lg:grid-cols-6 gap-2">
      <label class="flex items-center gap-2 text-sm text-gray-700 hover:text-gray-900 cursor-pointer">
        <input type="checkbox" 
               class="column-toggle rounded border-gray-300 text-blue-600 focus:ring-blue-500" 
               data-column="customer" 
               data-action="change->column-toggle#toggleColumn"
               checked>
        Customer
      </label>
      <label class="flex items-center gap-2 text-sm text-gray-700 hover:text-gray-900 cursor-pointer">
        <input type="checkbox" 
               class="column-toggle rounded border-gray-300 text-blue-600 focus:ring-blue-500" 
               data-column="phone" 
               data-action="change->column-toggle#toggleColumn"
               checked>
        Phone
      </label>
      <label class="flex items-center gap-2 text-sm text-gray-700 hover:text-gray-900 cursor-pointer">
        <input type="checkbox" 
               class="column-toggle rounded border-gray-300 text-blue-600 focus:ring-blue-500" 
               data-column="tv_brand" 
               data-action="change->column-toggle#toggleColumn"
               checked>
        TV Brand
      </label>
      <label class="flex items-center gap-2 text-sm text-gray-700 hover:text-gray-900 cursor-pointer">
        <input type="checkbox" 
               class="column-toggle rounded border-gray-300 text-blue-600 focus:ring-blue-500" 
               data-column="tv_size" 
               data-action="change->column-toggle#toggleColumn"
               checked>
        Size
      </label>
      <label class="flex items-center gap-2 text-sm text-gray-700 hover:text-gray-900 cursor-pointer">
        <input type="checkbox" 
               class="column-toggle rounded border-gray-300 text-blue-600 focus:ring-blue-500" 
               data-column="model_no" 
               data-action="change->column-toggle#toggleColumn"
               checked>
        Model
      </label>
      <label class="flex items-center gap-2 text-sm text-gray-700 hover:text-gray-900 cursor-pointer">
        <input type="checkbox" 
               class="column-toggle rounded border-gray-300 text-blue-600 focus:ring-blue-500" 
               data-column="date_in" 
               data-action="change->column-toggle#toggleColumn"
               checked>
        Date In
      </label>
      <label class="flex items-center gap-2 text-sm text-gray-700 hover:text-gray-900 cursor-pointer">
        <input type="checkbox" 
               class="column-toggle rounded border-gray-300 text-blue-600 focus:ring-blue-500" 
               data-column="date_out" 
               data-action="change->column-toggle#toggleColumn"
               checked>
        Date Out
      </label>
      <label class="flex items-center gap-2 text-sm text-gray-700 hover:text-gray-900 cursor-pointer">
        <input type="checkbox" 
               class="column-toggle rounded border-gray-300 text-blue-600 focus:ring-blue-500" 
               data-column="starting_price" 
               data-action="change->column-toggle#toggleColumn"
               checked>
        Starting
      </label>
      <label class="flex items-center gap-2 text-sm text-gray-700 hover:text-gray-900 cursor-pointer">
        <input type="checkbox" 
               class="column-toggle rounded border-gray-300 text-blue-600 focus:ring-blue-500" 
               data-column="final_price" 
               data-action="change->column-toggle#toggleColumn"
               checked>
        Final
      </label>
      <label class="flex items-center gap-2 text-sm text-gray-700 hover:text-gray-900 cursor-pointer">
        <input type="checkbox" 
               class="column-toggle rounded border-gray-300 text-blue-600 focus:ring-blue-500" 
               data-column="status" 
               data-action="change->column-toggle#toggleColumn"
               checked>
        Status
      </label>
      <label class="flex items-center gap-2 text-sm text-gray-700 hover:text-gray-900 cursor-pointer">
        <input type="checkbox" 
               class="column-toggle rounded border-gray-300 text-blue-600 focus:ring-blue-500" 
               data-column="spare_used" 
               data-action="change->column-toggle#toggleColumn"
               checked>
        Spare
      </label>
      <label class="flex items-center gap-2 text-sm text-gray-700 hover:text-gray-900 cursor-pointer">
        <input type="checkbox" 
               class="column-toggle rounded border-gray-300 text-blue-600 focus:ring-blue-500" 
               data-column="cost_each" 
               data-action="change->column-toggle#toggleColumn"
               checked>
        Cost Each
      </label>
      <label class="flex items-center gap-2 text-sm text-gray-700 hover:text-gray-900 cursor-pointer">
        <input type="checkbox" 
               class="column-toggle rounded border-gray-300 text-blue-600 focus:ring-blue-500" 
               data-column="total_cost" 
               data-action="change->column-toggle#toggleColumn"
               checked>
        Total Cost
      </label>
      <label class="flex items-center gap-2 text-sm text-gray-700 hover:text-gray-900 cursor-pointer">
        <input type="checkbox" 
               class="column-toggle rounded border-gray-300 text-blue-600 focus:ring-blue-500" 
               data-column="labour_cost" 
               data-action="change->column-toggle#toggleColumn"
               checked>
        Labour
      </label>
      <label class="flex items-center gap-2 text-sm text-gray-700 hover:text-gray-900 cursor-pointer">
        <input type="checkbox" 
               class="column-toggle rounded border-gray-300 text-blue-600 focus:ring-blue-500" 
               data-column="profit" 
               data-action="change->column-toggle#toggleColumn"
               checked>
        Profit
      </label>
      <label class="flex items-center gap-2 text-sm text-gray-700 hover:text-gray-900 cursor-pointer">
        <input type="checkbox" 
               class="column-toggle rounded border-gray-300 text-blue-600 focus:ring-blue-500" 
               data-column="user_id" 
               data-action="change->column-toggle#toggleColumn"
               checked>
        User
      </label>
      <label class="flex items-center gap-2 text-sm text-gray-700 hover:text-gray-900 cursor-pointer">
        <input type="checkbox" 
               class="column-toggle rounded border-gray-300 text-blue-600 focus:ring-blue-500" 
               data-column="remarks" 
               data-action="change->column-toggle#toggleColumn"
               checked>
        Remarks
      </label>
      <label class="flex items-center gap-2 text-sm text-gray-700 hover:text-gray-900 cursor-pointer">
        <input type="checkbox" 
               class="column-toggle rounded border-gray-300 text-blue-600 focus:ring-blue-500" 
               data-column="actions" 
               data-action="change->column-toggle#toggleColumn"
               checked>
        Actions
      </label>
    </div>
  </div>

  <!-- Filter/Search Bar -->
  <div class="mb-6 flex flex-wrap gap-3">
    <div class="relative flex-1 min-w-[200px]">
      <input type="text" 
             placeholder="Search activities..." 
             class="w-full px-4 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-blue-500 focus:border-transparent">
      <svg class="absolute right-3 top-2.5 w-5 h-5 text-gray-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"/>
      </svg>
    </div>
    <div class="flex gap-2">
      <select class="px-4 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-blue-500 focus:border-transparent bg-white">
        <option value="">All Status</option>
        <option value="received">Received</option>
        <option value="completed">Completed</option>
        <option value="returned">Returned</option>
        <option value="irepairable">Irreparable</option>
      </select>
    </div>
  </div>

  <!-- Activities Table -->
  <div id="activities" class="bg-white rounded-xl shadow-sm overflow-hidden border border-gray-200">
    <div class="overflow-x-auto">
      <table class="min-w-full divide-y divide-gray-200">
        <!-- Table Header -->
        <thead class="bg-gray-50 sticky top-0 z-10">
          <tr>
            <th scope="col" class="px-3 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider column-header customer" data-column="customer">Customer</th>
            <th scope="col" class="px-3 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider column-header phone" data-column="phone">Phone</th>
            <th scope="col" class="px-3 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider column-header tv_brand" data-column="tv_brand">TV Brand</th>
            <th scope="col" class="px-3 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider column-header tv_size" data-column="tv_size">Size</th>
            <th scope="col" class="px-3 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider column-header model_no" data-column="model_no">Model</th>
            <th scope="col" class="px-3 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider column-header date_in" data-column="date_in">Date In</th>
            <th scope="col" class="px-3 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider column-header date_out" data-column="date_out">Date Out</th>
            <th scope="col" class="px-3 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider column-header starting_price" data-column="starting_price">Starting</th>
            <th scope="col" class="px-3 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider column-header final_price" data-column="final_price">Final</th>
            <th scope="col" class="px-3 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider column-header status" data-column="status">Status</th>
            <th scope="col" class="px-3 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider column-header spare_used" data-column="spare_used">Spare</th>
            <th scope="col" class="px-3 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider column-header cost_each" data-column="cost_each">Cost Each</th>
            <th scope="col" class="px-3 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider column-header total_cost" data-column="total_cost">Total Cost</th>
            <th scope="col" class="px-3 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider column-header labour_cost" data-column="labour_cost">Labour</th>
            <th scope="col" class="px-3 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider column-header profit" data-column="profit">Profit</th>
            <th scope="col" class="px-3 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider column-header user_id" data-column="user_id">User</th>
            <th scope="col" class="px-3 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider column-header remarks" data-column="remarks">Remarks</th>
            <th scope="col" class="px-3 py-3 text-right text-xs font-medium text-gray-500 uppercase tracking-wider column-header actions" data-column="actions">Actions</th>
          </tr>
        </thead>
        
        <!-- Table Body -->
        <tbody class="bg-white divide-y divide-gray-200">
          <% if @activities.any? %>
            <% @activities.each do |activity| %>
              <%= render activity %>
            <% end %>
          <% else %>
            <tr>
              <td colspan="18" class="px-4 py-16 text-center">
                <div class="inline-flex items-center justify-center w-20 h-20 bg-gray-100 rounded-full mb-4">
                  <svg class="w-10 h-10 text-gray-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2"/>
                  </svg>
                </div>
                <p class="text-gray-500 text-lg font-medium">No activities found</p>
                <p class="text-gray-400 text-sm mt-1">Create your first activity to get started</p>
                <%= link_to new_activity_path, class: "inline-flex items-center gap-2 mt-4 px-4 py-2 bg-blue-600 hover:bg-blue-700 text-white font-medium rounded-lg transition duration-150" do %>
                  <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4"/>
                  </svg>
                  Create New Activity
                <% end %>
              </td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>
  </div>
</div>