<% content_for :title, "Repair Activities" %>

<div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8 py-8 space-y-6">
  
  <!-- Page header -->
  <div class="flex flex-wrap items-end justify-between gap-4">
    <div>
      <h1 class="text-2xl font-semibold tracking-tight text-slate-900">Repair Activities</h1>
      <p class="mt-1 text-sm text-slate-500">Track repairs, spares, returns and profitability.</p>
    </div>
    <div class="flex items-center gap-2">
      <%= link_to new_activity_path,
          class: "inline-flex items-center gap-1.5 rounded-lg bg-indigo-600 px-4 py-2.5 text-sm font-semibold text-white shadow-sm transition hover:bg-indigo-500 focus:outline-none focus:ring-2 focus:ring-indigo-500 focus:ring-offset-2" do %>
        <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" d="M12 4.5v15m7.5-7.5h-15" />
        </svg>
        Kazi mpya
      <% end %>
    </div>
  </div>

  <%# ============ KPI STRIP (overall) ============ %>
  <div class="grid gap-3 grid-cols-2 lg:grid-cols-4">
    <div class="rounded-xl border border-slate-200 bg-white px-4 py-3 shadow-sm">
      <p class="text-[11px] font-medium uppercase tracking-wider text-slate-500">Total repairs</p>
      <p class="mt-1 text-xl font-semibold tabular-nums text-slate-900"><%= @total_count %></p>
    </div>
    <div class="rounded-xl border border-slate-200 bg-white px-4 py-3 shadow-sm">
      <p class="text-[11px] font-medium uppercase tracking-wider text-slate-500">In progress</p>
      <p class="mt-1 text-xl font-semibold tabular-nums text-amber-600"><%= @in_progress %></p>
    </div>
    <div class="rounded-xl border border-slate-200 bg-white px-4 py-3 shadow-sm">
      <p class="text-[11px] font-medium uppercase tracking-wider text-slate-500">Completed today</p>
      <p class="mt-1 text-xl font-semibold tabular-nums text-emerald-600"><%= @completed_today %></p>
    </div>
    <% if current_user.super_admin? %>
      <div class="rounded-xl border border-slate-200 bg-white px-4 py-3 shadow-sm">
        <p class="text-[11px] font-medium uppercase tracking-wider text-slate-500">Total revenue</p>
        <p class="mt-1 text-xl font-semibold tabular-nums text-slate-900">
          <%= number_to_currency(@total_revenue, unit: "TSh ", precision: 0) %>
        </p>
      </div>
    <% end %>
  </div>

  <%# ============ SEARCH BAR ============ %>
  <%= form_with url: activities_path, method: :get,
      data: {
        controller: "search",
        turbo_frame: "activities",
        turbo_action: "advance",
        action: "input->search#submit"
      }, class: "rounded-xl border border-slate-200 bg-white p-3 shadow-sm" do |f| %>

    <div class="flex items-center gap-2">
      <div class="relative flex-1">
        <div class="pointer-events-none absolute inset-y-0 left-0 flex items-center pl-3">
          <svg class="h-4 w-4 text-slate-400" fill="none" viewBox="0 0 24 24" stroke-width="1.8" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" d="m21 21-5.197-5.197m0 0A7.5 7.5 0 1 0 5.196 5.196a7.5 7.5 0 0 0 10.607 10.607Z" />
          </svg>
        </div>

        <%= f.search_field :q,
            value: params[:q],
            placeholder: "Search by customer, phone, TV brand, size, problem, model, board, COF…",
            autocomplete: "off",
            class: "block w-full rounded-lg border border-slate-200 bg-white pl-10 pr-3 py-2 text-sm text-slate-900 shadow-sm transition placeholder:text-slate-400 focus:border-indigo-500 focus:outline-none focus:ring-2 focus:ring-indigo-500/20" %>
      </div>

      <% if params[:q].present? %>
        <%= link_to activities_path,
            data: { turbo_frame: "activities", turbo_action: "advance" },
            class: "inline-flex items-center gap-1.5 rounded-lg border border-slate-200 bg-white px-3 py-2 text-sm font-medium text-slate-600 transition hover:bg-slate-50",
            title: "Clear search" do %>
          <svg class="h-3.5 w-3.5" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" d="M6 18 18 6M6 6l12 12" />
          </svg>
          Clear
        <% end %>
      <% end %>
    </div>
  <% end %>

 <!-- Filter by status (Desktop: pills, Mobile: dropdown) -->
<div class="flex flex-wrap items-center gap-2">
  <span class="text-sm font-medium text-slate-500 mr-2 hidden md:inline">Filter by status:</span>

  <!-- Desktop: pills -->
  <div class="hidden md:flex flex-wrap items-center gap-2">
    <%= link_to "All", activities_path,
        data: { turbo_frame: "activities", turbo_action: "advance" },
        class: "rounded-full border px-3.5 py-1.5 text-sm font-medium transition #{params[:status].blank? ? 'bg-indigo-600 border-indigo-600 text-white shadow-sm' : 'bg-white border-slate-200 text-slate-600 hover:bg-slate-50'}" %>

    <% Activity.statuses.keys.each do |status| %>
      <%= link_to status.humanize, activities_path(status: status),
          data: { turbo_frame: "activities", turbo_action: "advance" },
          class: "rounded-full border px-3.5 py-1.5 text-sm font-medium transition #{params[:status] == status ? 'bg-indigo-600 border-indigo-600 text-white shadow-sm' : 'bg-white border-slate-200 text-slate-600 hover:bg-slate-50'}" %>
    <% end %>
  </div>

  <!-- Mobile: dropdown -->
  <div class="md:hidden w-full">
    <%= form_with url: activities_path, method: :get,
        data: { turbo_frame: "activities", turbo_action: "advance", action: "change->search#submit" },
        class: "w-full" do |f| %>
      <%= hidden_field_tag :q, params[:q] %>
      <%= f.select :status,
          options_for_select([["All statuses", ""]] + Activity.statuses.keys.map { |s| [s.humanize, s] }, params[:status]),
          {},
          onchange: "this.form.requestSubmit()",
          class: "w-full rounded-lg border border-slate-200 bg-white px-3 py-2 text-sm font-medium text-slate-700 shadow-sm focus:border-indigo-500 focus:ring-indigo-500/20 cursor-pointer" %>
    <% end %>
  </div>
</div>

  <%# ============ LIST (Turbo Frame) ============ %>
  <%= turbo_frame_tag "activities" do %>
    <%= render "activities/list", activities: @activities, query: params[:q] %>
  <% end %>
</div>