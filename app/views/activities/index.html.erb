<div class="mx-auto max-w-7xl">
  <div class="mb-6 flex flex-wrap items-center justify-between gap-3"><div><h1 class="text-2xl font-bold">Repair Activities</h1><p class="text-slate-500">Track repairs, spares, returns and profitability.</p></div><%= link_to "New Activity", new_activity_path, class: "rounded-lg bg-blue-600 px-4 py-2.5 font-medium text-white" %></div>
  <div class="overflow-x-auto rounded-xl border bg-white shadow-sm"><table class="min-w-full divide-y"><thead class="bg-slate-50"><tr><th class="px-4 py-3 text-left text-xs uppercase">Customer</th><th class="px-4 py-3 text-left text-xs uppercase">TV</th><th class="px-4 py-3 text-left text-xs uppercase">Problem</th><th class="px-4 py-3 text-left text-xs uppercase">Status</th><th class="px-4 py-3 text-right text-xs uppercase">Price</th><th class="px-4 py-3 text-right text-xs uppercase">Gross profit</th><th></th></tr></thead><tbody class="divide-y">
  <% @activities.each do |activity| %><tr class="hover:bg-slate-50"><td class="px-4 py-3"><%= activity.customer&.name || "—" %></td><td class="px-4 py-3"><%= [activity.tv_brand&.name, activity.tv_size&.size].compact.join(" ") %></td><td class="px-4 py-3"><%= activity.tatizo&.name || "—" %></td><td class="px-4 py-3"><span class="rounded-full bg-slate-100 px-2 py-1 text-xs"><%= activity.status.humanize %></span></td><td class="px-4 py-3 text-right"><%= number_to_currency(activity.price, unit: "TSh ", precision: 0) %></td><td class="px-4 py-3 text-right font-semibold"><%= number_to_currency(activity.gross_profit, unit: "TSh ", precision: 0) %></td><td class="px-4 py-3 text-right"><%= link_to "View", activity, class: "text-blue-600" %></td></tr><% end %>
  </tbody></table></div>
</div>
