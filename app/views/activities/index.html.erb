<% content_for :title, "Activities" %>

<div class="w-full max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
  <% if notice.present? %>
    <div class="mb-6 bg-green-50 border-l-4 border-green-500 text-green-700 p-4 rounded-md" id="notice">
      <p class="font-medium"><%= notice %></p>
    </div>
  <% end %>

  <!-- Header Section -->
  <div class="flex flex-col sm:flex-row justify-between items-start sm:items-center gap-4 mb-6 pb-4 border-b border-gray-200">
    <h1 class="font-bold text-3xl sm:text-4xl text-gray-900 flex items-center gap-3">
      <svg class="w-8 h-8 text-blue-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2"/>
      </svg>
      Activities
    </h1>
    <div class="flex flex-wrap gap-2">
      <!-- Column Toggle Dropdown -->
      <div class="relative" data-controller="dropdown">
        <button data-action="click->dropdown#toggle" 
                class="inline-flex items-center gap-2 px-4 py-2.5 bg-gray-100 hover:bg-gray-200 text-gray-700 font-medium rounded-lg transition duration-150">
          <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6a2 2 0 012-2h2a2 2 0 012 2v2a2 2 0 01-2 2H6a2 2 0 01-2-2V6zM14 6a2 2 0 012-2h2a2 2 0 012 2v2a2 2 0 01-2 2h-2a2 2 0 01-2-2V6zM4 16a2 2 0 012-2h2a2 2 0 012 2v2a2 2 0 01-2 2H6a2 2 0 01-2-2v-2zM14 16a2 2 0 012-2h2a2 2 0 012 2v2a2 2 0 01-2 2h-2a2 2 0 01-2-2v-2z"/>
          </svg>
          Columns
          <span class="bg-blue-100 text-blue-800 text-xs font-medium px-2 py-0.5 rounded-full">
            <span data-column-toggle-target="count">18</span>
          </span>
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"/>
          </svg>
        </button>
        
        <!-- Dropdown Panel -->
        <div data-dropdown-target="menu" 
             class="hidden absolute right-0 mt-2 w-80 bg-white rounded-xl shadow-lg border border-gray-200 z-50 max-h-[500px] overflow-y-auto">
          <div class="p-4">
            <div class="flex justify-between items-center mb-3">
              <h3 class="text-sm font-medium text-gray-700">Manage Columns</h3>
              <div class="flex gap-2 text-xs">
                <button data-action="click->dropdown#showAll" class="text-blue-600 hover:text-blue-800 font-medium">Show All</button>
                <span class="text-gray-300">|</span>
                <button data-action="click->dropdown#hideAll" class="text-blue-600 hover:text-blue-800 font-medium">Hide All</button>
                <span class="text-gray-300">|</span>
                <button data-action="click->dropdown#resetDefaults" class="text-blue-600 hover:text-blue-800 font-medium">Reset</button>
              </div>
            </div>
            
            <!-- Search columns -->
            <div class="relative mb-3">
              <input type="text" 
                     placeholder="Search columns..." 
                     data-action="input->column-toggle#filterColumns"
                     class="w-full px-3 py-1.5 text-sm border border-gray-300 rounded-lg focus:ring-2 focus:ring-blue-500 focus:border-transparent">
              <svg class="absolute right-3 top-2 w-4 h-4 text-gray-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"/>
              </svg>
            </div>
            
            <div class="space-y-1" data-column-toggle-target="list">
              <%= render "column_toggle_items" %>
            </div>
            
            <div class="mt-3 pt-3 border-t border-gray-100">
              <div class="text-xs text-gray-500 flex items-center justify-between">
                <span>💡 Right-click any column header to hide</span>
                <span class="text-gray-400">Drag to reorder</span>
              </div>
            </div>
          </div>
        </div>
      </div>
      
      <%= link_to new_activity_path, class: "inline-flex items-center gap-2 px-4 py-2.5 bg-blue-600 hover:bg-blue-700 text-white font-medium rounded-lg shadow-sm hover:shadow-md transition duration-150" do %>
        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4"/>
        </svg>
        New Activity
      <% end %>
    </div>
  </div>

  <!-- Filter/Search Bar -->
  <div class="mb-6 flex flex-wrap gap-3">
    <div class="relative flex-1 min-w-[200px]">
      <input type="text" 
             placeholder="Search activities..." 
             class="w-full px-4 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-blue-500 focus:border-transparent">
      <svg class="absolute right-3 top-2.5 w-5 h-5 text-gray-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"/>
      </svg>
    </div>
    <div class="flex gap-2">
      <select class="px-4 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-blue-500 focus:border-transparent bg-white">
        <option value="">All Status</option>
        <option value="received">Received</option>
        <option value="completed">Completed</option>
        <option value="returned">Returned</option>
        <option value="irepairable">Irreparable</option>
      </select>
    </div>
  </div>

  <!-- Context Menu (Right-click) -->
  <div data-controller="context-menu">
    <div data-context-menu-target="menu" 
         class="fixed hidden bg-white rounded-lg shadow-xl border border-gray-200 py-1 z-50 min-w-[180px]">
      <button data-action="click->context-menu#hideColumn" 
              class="w-full text-left px-4 py-2 text-sm text-red-600 hover:bg-red-50 flex items-center gap-2">
        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"/>
        </svg>
        Hide Column
      </button>
      <button data-action="click->context-menu#showAllColumns" 
              class="w-full text-left px-4 py-2 text-sm text-gray-700 hover:bg-gray-50 flex items-center gap-2">
        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/>
        </svg>
        Show All Columns
      </button>
      <hr class="my-1">
      <button data-action="click->context-menu#resetDefaults" 
              class="w-full text-left px-4 py-2 text-sm text-gray-700 hover:bg-gray-50 flex items-center gap-2">
        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 4v5h.582m15.356 2A8.001 8.001 0 004.582 9m0 0H9m11 11v-5h-.581m0 0a8.003 8.003 0 01-15.357-2m15.357 2H15"/>
        </svg>
        Reset to Default
      </button>
      <div class="px-4 py-1 text-xs text-gray-400 border-t border-gray-100">
        Right-click any column header
      </div>
    </div>

    <!-- Activities Table -->
    <div id="activities" class="bg-white rounded-xl shadow-sm overflow-hidden border border-gray-200">
      <div class="overflow-x-auto">
        <table class="min-w-full divide-y divide-gray-200">
          <!-- Table Header -->
          <thead class="bg-gray-50 sticky top-0 z-10">
            <tr>
              <!-- Customer Column -->
              <th scope="col" class="px-3 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider column-header customer group relative" data-column="customer" data-context-menu-target="header">
                <div class="flex items-center justify-between gap-2">
                  <span>Customer</span>
                  <div class="flex items-center gap-1 opacity-0 group-hover:opacity-100 transition-opacity duration-150">
                    <button data-action="click->column-toggle#hideColumn" 
                            data-column="customer"
                            class="text-gray-400 hover:text-red-600 transition-colors duration-150 p-0.5 rounded hover:bg-red-50"
                            title="Hide this column">
                      <svg class="w-3 h-3" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"/>
                      </svg>
                    </button>
                  </div>
                </div>
              </th>
              
              <!-- Phone Column -->
              <th scope="col" class="px-3 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider column-header phone group relative" data-column="phone" data-context-menu-target="header">
                <div class="flex items-center justify-between gap-2">
                  <span>Phone</span>
                  <div class="flex items-center gap-1 opacity-0 group-hover:opacity-100 transition-opacity duration-150">
                    <button data-action="click->column-toggle#hideColumn" 
                            data-column="phone"
                            class="text-gray-400 hover:text-red-600 transition-colors duration-150 p-0.5 rounded hover:bg-red-50"
                            title="Hide this column">
                      <svg class="w-3 h-3" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"/>
                      </svg>
                    </button>
                  </div>
                </div>
              </th>
              
              <!-- TV Brand Column -->
              <th scope="col" class="px-3 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider column-header tv_brand group relative" data-column="tv_brand" data-context-menu-target="header">
                <div class="flex items-center justify-between gap-2">
                  <span>TV Brand</span>
                  <div class="flex items-center gap-1 opacity-0 group-hover:opacity-100 transition-opacity duration-150">
                    <button data-action="click->column-toggle#hideColumn" 
                            data-column="tv_brand"
                            class="text-gray-400 hover:text-red-600 transition-colors duration-150 p-0.5 rounded hover:bg-red-50"
                            title="Hide this column">
                      <svg class="w-3 h-3" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"/>
                      </svg>
                    </button>
                  </div>
                </div>
              </th>
              
              <!-- TV Size Column -->
              <th scope="col" class="px-3 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider column-header tv_size group relative" data-column="tv_size" data-context-menu-target="header">
                <div class="flex items-center justify-between gap-2">
                  <span>Size</span>
                  <div class="flex items-center gap-1 opacity-0 group-hover:opacity-100 transition-opacity duration-150">
                    <button data-action="click->column-toggle#hideColumn" 
                            data-column="tv_size"
                            class="text-gray-400 hover:text-red-600 transition-colors duration-150 p-0.5 rounded hover:bg-red-50"
                            title="Hide this column">
                      <svg class="w-3 h-3" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"/>
                      </svg>
                    </button>
                  </div>
                </div>
              </th>
              
              <!-- Model No Column -->
              <th scope="col" class="px-3 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider column-header model_no group relative" data-column="model_no" data-context-menu-target="header">
                <div class="flex items-center justify-between gap-2">
                  <span>Model</span>
                  <div class="flex items-center gap-1 opacity-0 group-hover:opacity-100 transition-opacity duration-150">
                    <button data-action="click->column-toggle#hideColumn" 
                            data-column="model_no"
                            class="text-gray-400 hover:text-red-600 transition-colors duration-150 p-0.5 rounded hover:bg-red-50"
                            title="Hide this column">
                      <svg class="w-3 h-3" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"/>
                      </svg>
                    </button>
                  </div>
                </div>
              </th>
              
              <!-- Date In Column -->
              <th scope="col" class="px-3 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider column-header date_in group relative" data-column="date_in" data-context-menu-target="header">
                <div class="flex items-center justify-between gap-2">
                  <span>Date In</span>
                  <div class="flex items-center gap-1 opacity-0 group-hover:opacity-100 transition-opacity duration-150">
                    <button data-action="click->column-toggle#hideColumn" 
                            data-column="date_in"
                            class="text-gray-400 hover:text-red-600 transition-colors duration-150 p-0.5 rounded hover:bg-red-50"
                            title="Hide this column">
                      <svg class="w-3 h-3" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"/>
                      </svg>
                    </button>
                  </div>
                </div>
              </th>
              
              <!-- Date Out Column -->
              <th scope="col" class="px-3 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider column-header date_out group relative" data-column="date_out" data-context-menu-target="header">
                <div class="flex items-center justify-between gap-2">
                  <span>Date Out</span>
                  <div class="flex items-center gap-1 opacity-0 group-hover:opacity-100 transition-opacity duration-150">
                    <button data-action="click->column-toggle#hideColumn" 
                            data-column="date_out"
                            class="text-gray-400 hover:text-red-600 transition-colors duration-150 p-0.5 rounded hover:bg-red-50"
                            title="Hide this column">
                      <svg class="w-3 h-3" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"/>
                      </svg>
                    </button>
                  </div>
                </div>
              </th>
              
              <!-- Starting Price Column -->
              <th scope="col" class="px-3 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider column-header starting_price group relative" data-column="starting_price" data-context-menu-target="header">
                <div class="flex items-center justify-between gap-2">
                  <span>Starting</span>
                  <div class="flex items-center gap-1 opacity-0 group-hover:opacity-100 transition-opacity duration-150">
                    <button data-action="click->column-toggle#hideColumn" 
                            data-column="starting_price"
                            class="text-gray-400 hover:text-red-600 transition-colors duration-150 p-0.5 rounded hover:bg-red-50"
                            title="Hide this column">
                      <svg class="w-3 h-3" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"/>
                      </svg>
                    </button>
                  </div>
                </div>
              </th>
              
              <!-- Final Price Column -->
              <th scope="col" class="px-3 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider column-header final_price group relative" data-column="final_price" data-context-menu-target="header">
                <div class="flex items-center justify-between gap-2">
                  <span>Final</span>
                  <div class="flex items-center gap-1 opacity-0 group-hover:opacity-100 transition-opacity duration-150">
                    <button data-action="click->column-toggle#hideColumn" 
                            data-column="final_price"
                            class="text-gray-400 hover:text-red-600 transition-colors duration-150 p-0.5 rounded hover:bg-red-50"
                            title="Hide this column">
                      <svg class="w-3 h-3" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"/>
                      </svg>
                    </button>
                  </div>
                </div>
              </th>
              
              <!-- Status Column -->
              <th scope="col" class="px-3 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider column-header status group relative" data-column="status" data-context-menu-target="header">
                <div class="flex items-center justify-between gap-2">
                  <span>Status</span>
                  <div class="flex items-center gap-1 opacity-0 group-hover:opacity-100 transition-opacity duration-150">
                    <button data-action="click->column-toggle#hideColumn" 
                            data-column="status"
                            class="text-gray-400 hover:text-red-600 transition-colors duration-150 p-0.5 rounded hover:bg-red-50"
                            title="Hide this column">
                      <svg class="w-3 h-3" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"/>
                      </svg>
                    </button>
                  </div>
                </div>
              </th>
              
              <!-- Spare Used Column -->
              <th scope="col" class="px-3 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider column-header spare_used group relative" data-column="spare_used" data-context-menu-target="header">
                <div class="flex items-center justify-between gap-2">
                  <span>Spare</span>
                  <div class="flex items-center gap-1 opacity-0 group-hover:opacity-100 transition-opacity duration-150">
                    <button data-action="click->column-toggle#hideColumn" 
                            data-column="spare_used"
                            class="text-gray-400 hover:text-red-600 transition-colors duration-150 p-0.5 rounded hover:bg-red-50"
                            title="Hide this column">
                      <svg class="w-3 h-3" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"/>
                      </svg>
                    </button>
                  </div>
                </div>
              </th>
              
              <!-- Cost Each Column -->
              <th scope="col" class="px-3 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider column-header cost_each group relative" data-column="cost_each" data-context-menu-target="header">
                <div class="flex items-center justify-between gap-2">
                  <span>Cost Each</span>
                  <div class="flex items-center gap-1 opacity-0 group-hover:opacity-100 transition-opacity duration-150">
                    <button data-action="click->column-toggle#hideColumn" 
                            data-column="cost_each"
                            class="text-gray-400 hover:text-red-600 transition-colors duration-150 p-0.5 rounded hover:bg-red-50"
                            title="Hide this column">
                      <svg class="w-3 h-3" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"/>
                      </svg>
                    </button>
                  </div>
                </div>
              </th>
              
              <!-- Total Cost Column -->
              <th scope="col" class="px-3 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider column-header total_cost group relative" data-column="total_cost" data-context-menu-target="header">
                <div class="flex items-center justify-between gap-2">
                  <span>Total Cost</span>
                  <div class="flex items-center gap-1 opacity-0 group-hover:opacity-100 transition-opacity duration-150">
                    <button data-action="click->column-toggle#hideColumn" 
                            data-column="total_cost"
                            class="text-gray-400 hover:text-red-600 transition-colors duration-150 p-0.5 rounded hover:bg-red-50"
                            title="Hide this column">
                      <svg class="w-3 h-3" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"/>
                      </svg>
                    </button>
                  </div>
                </div>
              </th>
              
              <!-- Labour Cost Column -->
              <th scope="col" class="px-3 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider column-header labour_cost group relative" data-column="labour_cost" data-context-menu-target="header">
                <div class="flex items-center justify-between gap-2">
                  <span>Labour</span>
                  <div class="flex items-center gap-1 opacity-0 group-hover:opacity-100 transition-opacity duration-150">
                    <button data-action="click->column-toggle#hideColumn" 
                            data-column="labour_cost"
                            class="text-gray-400 hover:text-red-600 transition-colors duration-150 p-0.5 rounded hover:bg-red-50"
                            title="Hide this column">
                      <svg class="w-3 h-3" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"/>
                      </svg>
                    </button>
                  </div>
                </div>
              </th>
              
              <!-- Profit Column -->
              <th scope="col" class="px-3 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider column-header profit group relative" data-column="profit" data-context-menu-target="header">
                <div class="flex items-center justify-between gap-2">
                  <span>Profit</span>
                  <div class="flex items-center gap-1 opacity-0 group-hover:opacity-100 transition-opacity duration-150">
                    <button data-action="click->column-toggle#hideColumn" 
                            data-column="profit"
                            class="text-gray-400 hover:text-red-600 transition-colors duration-150 p-0.5 rounded hover:bg-red-50"
                            title="Hide this column">
                      <svg class="w-3 h-3" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"/>
                      </svg>
                    </button>
                  </div>
                </div>
              </th>
              
              <!-- User ID Column -->
              <th scope="col" class="px-3 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider column-header user_id group relative" data-column="user_id" data-context-menu-target="header">
                <div class="flex items-center justify-between gap-2">
                  <span>User</span>
                  <div class="flex items-center gap-1 opacity-0 group-hover:opacity-100 transition-opacity duration-150">
                    <button data-action="click->column-toggle#hideColumn" 
                            data-column="user_id"
                            class="text-gray-400 hover:text-red-600 transition-colors duration-150 p-0.5 rounded hover:bg-red-50"
                            title="Hide this column">
                      <svg class="w-3 h-3" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"/>
                      </svg>
                    </button>
                  </div>
                </div>
              </th>
              
              <!-- Remarks Column -->
              <th scope="col" class="px-3 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider column-header remarks group relative" data-column="remarks" data-context-menu-target="header">
                <div class="flex items-center justify-between gap-2">
                  <span>Remarks</span>
                  <div class="flex items-center gap-1 opacity-0 group-hover:opacity-100 transition-opacity duration-150">
                    <button data-action="click->column-toggle#hideColumn" 
                            data-column="remarks"
                            class="text-gray-400 hover:text-red-600 transition-colors duration-150 p-0.5 rounded hover:bg-red-50"
                            title="Hide this column">
                      <svg class="w-3 h-3" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"/>
                      </svg>
                    </button>
                  </div>
                </div>
              </th>
              
              <!-- Actions Column (Always Visible) -->
              <th scope="col" class="px-3 py-3 text-right text-xs font-medium text-gray-500 uppercase tracking-wider column-header actions" data-column="actions">
                <span>Actions</span>
              </th>
            </tr>
          </thead>
          
          <!-- Table Body -->
          <tbody class="bg-white divide-y divide-gray-200">
            <% if @activities.any? %>
              <% @activities.each do |activity| %>
                <%= render activity %>
              <% end %>
            <% else %>
              <tr>
                <td colspan="18" class="px-4 py-16 text-center">
                  <div class="inline-flex items-center justify-center w-20 h-20 bg-gray-100 rounded-full mb-4">
                    <svg class="w-10 h-10 text-gray-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2"/>
                    </svg>
                  </div>
                  <p class="text-gray-500 text-lg font-medium">No activities found</p>
                  <p class="text-gray-400 text-sm mt-1">Create your first activity to get started</p>
                  <%= link_to new_activity_path, class: "inline-flex items-center gap-2 mt-4 px-4 py-2 bg-blue-600 hover:bg-blue-700 text-white font-medium rounded-lg transition duration-150" do %>
                    <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4"/>
                    </svg>
                    Create New Activity
                  <% end %>
                </td>
              </tr>
            <% end %>
          </tbody>
        </table>
      </div>
    </div>
  </div>
</div>