<% content_for :title, "Showing activity" %>

<div class="w-full max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
  <% if notice.present? %>
    <div class="mb-6 bg-green-50 border-l-4 border-green-500 text-green-700 p-4 rounded-md" id="notice">
      <p class="font-medium"><%= notice %></p>
    </div>
  <% end %>

  <!-- Header Section -->
  <div class="flex flex-col sm:flex-row justify-between items-start sm:items-center gap-4 mb-6 pb-4 border-b border-gray-200">
    <div class="flex items-center gap-3">
      <svg class="w-8 h-8 text-blue-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2"/>
      </svg>
      <div>
        <h1 class="font-bold text-3xl sm:text-4xl text-gray-900">Activity Details</h1>
        <p class="text-sm text-gray-500 mt-1">#<%= @activity.id %> · Created <%= time_ago_in_words(@activity.created_at) %> ago</p>
      </div>
    </div>
    <span class="px-3 py-1 text-sm font-medium rounded-full <%= status_badge_color(@activity.status) %> whitespace-nowrap">
      <%= @activity.status&.humanize %>
    </span>
  </div>

  <!-- Activity Details -->
  <div class="bg-white rounded-xl shadow-sm border border-gray-200 overflow-hidden">
    <!-- Customer Section -->
    <div class="p-6 border-b border-gray-100">
      <div class="grid grid-cols-1 sm:grid-cols-2 gap-6">
        <div>
          <h3 class="text-xs font-medium text-gray-500 uppercase tracking-wider mb-1">Customer</h3>
          <p class="text-lg font-semibold text-gray-900"><%= @activity.customer.presence || "—" %></p>
        </div>
        <div>
          <h3 class="text-xs font-medium text-gray-500 uppercase tracking-wider mb-1">Phone</h3>
          <p class="text-lg font-semibold text-gray-900 flex items-center gap-2">
            <%= @activity.phone.presence || "—" %>
            <% if @activity.phone.present? %>
              <a href="tel:<%= @activity.phone %>" class="text-blue-600 hover:text-blue-800">
                <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"/>
                </svg>
              </a>
            <% end %>
          </p>
        </div>
      </div>
    </div>

    <!-- TV Details Section -->
    <div class="p-6 border-b border-gray-100">
      <h3 class="text-xs font-medium text-gray-500 uppercase tracking-wider mb-3">TV Details</h3>
      <div class="grid grid-cols-1 sm:grid-cols-3 gap-4">
        <div class="bg-gray-50 rounded-lg p-3">
          <span class="text-xs font-medium text-gray-500 block">Brand</span>
          <span class="text-sm font-medium text-gray-900"><%= @activity.TV_brand.presence || "—" %></span>
        </div>
        <div class="bg-gray-50 rounded-lg p-3">
          <span class="text-xs font-medium text-gray-500 block">Size</span>
          <span class="text-sm font-medium text-gray-900"><%= @activity.TV_size.presence ? "#{@activity.TV_size}\"" : "—" %></span>
        </div>
        <div class="bg-gray-50 rounded-lg p-3">
          <span class="text-xs font-medium text-gray-500 block">Model No.</span>
          <span class="text-sm font-medium text-gray-900"><%= @activity.model_no.presence || "—" %></span>
        </div>
      </div>
    </div>

    <!-- Images Section -->
    <div class="p-6 border-b border-gray-100">
      <h3 class="text-xs font-medium text-gray-500 uppercase tracking-wider mb-4">Images</h3>
      
      <div class="grid grid-cols-2 sm:grid-cols-3 lg:grid-cols-4 gap-4">
        <!-- Model Image -->
        <div class="bg-gray-50 rounded-lg overflow-hidden border border-gray-200">
          <div class="aspect-w-1 aspect-h-1 bg-gray-100">
            <% if @activity.model_image.attached? %>
              <%= image_tag @activity.model_image, class: "w-full h-32 object-cover", alt: "Model Image" %>
            <% else %>
              <div class="w-full h-32 flex items-center justify-center bg-gray-100">
                <span class="text-xs text-gray-400">No image</span>
              </div>
            <% end %>
          </div>
          <div class="p-2 text-center">
            <span class="text-xs font-medium text-gray-600">Model Image</span>
          </div>
        </div>

        <!-- Board Number -->
        <div class="bg-gray-50 rounded-lg overflow-hidden border border-gray-200">
          <div class="aspect-w-1 aspect-h-1 bg-gray-100">
            <% if @activity.board_number.attached? %>
              <%= image_tag @activity.board_number, class: "w-full h-32 object-cover", alt: "Board Number" %>
            <% else %>
              <div class="w-full h-32 flex items-center justify-center bg-gray-100">
                <span class="text-xs text-gray-400">No image</span>
              </div>
            <% end %>
          </div>
          <div class="p-2 text-center">
            <span class="text-xs font-medium text-gray-600">Board Number</span>
          </div>
        </div>

        <!-- TCON Number -->
        <div class="bg-gray-50 rounded-lg overflow-hidden border border-gray-200">
          <div class="aspect-w-1 aspect-h-1 bg-gray-100">
            <% if @activity.tcon_number.attached? %>
              <%= image_tag @activity.tcon_number, class: "w-full h-32 object-cover", alt: "TCON Number" %>
            <% else %>
              <div class="w-full h-32 flex items-center justify-center bg-gray-100">
                <span class="text-xs text-gray-400">No image</span>
              </div>
            <% end %>
          </div>
          <div class="p-2 text-center">
            <span class="text-xs font-medium text-gray-600">TCON Number</span>
          </div>
        </div>

        <!-- COF Number -->
        <div class="bg-gray-50 rounded-lg overflow-hidden border border-gray-200">
          <div class="aspect-w-1 aspect-h-1 bg-gray-100">
            <% if @activity.cof_number.attached? %>
              <%= image_tag @activity.cof_number, class: "w-full h-32 object-cover", alt: "COF Number" %>
            <% else %>
              <div class="w-full h-32 flex items-center justify-center bg-gray-100">
                <span class="text-xs text-gray-400">No image</span>
              </div>
            <% end %>
          </div>
          <div class="p-2 text-center">
            <span class="text-xs font-medium text-gray-600">COF Number</span>
          </div>
        </div>

        <!-- Panel Number -->
        <div class="bg-gray-50 rounded-lg overflow-hidden border border-gray-200">
          <div class="aspect-w-1 aspect-h-1 bg-gray-100">
            <% if @activity.panel_number.attached? %>
              <%= image_tag @activity.panel_number, class: "w-full h-32 object-cover", alt: "Panel Number" %>
            <% else %>
              <div class="w-full h-32 flex items-center justify-center bg-gray-100">
                <span class="text-xs text-gray-400">No image</span>
              </div>
            <% end %>
          </div>
          <div class="p-2 text-center">
            <span class="text-xs font-medium text-gray-600">Panel Number</span>
          </div>
        </div>

        <!-- Image Before -->
        <div class="bg-gray-50 rounded-lg overflow-hidden border border-gray-200">
          <div class="aspect-w-1 aspect-h-1 bg-gray-100">
            <% if @activity.image_before.attached? %>
              <%= image_tag @activity.image_before, class: "w-full h-32 object-cover", alt: "Before Image" %>
            <% else %>
              <div class="w-full h-32 flex items-center justify-center bg-gray-100">
                <span class="text-xs text-gray-400">No image</span>
              </div>
            <% end %>
          </div>
          <div class="p-2 text-center">
            <span class="text-xs font-medium text-gray-600">Before</span>
          </div>
        </div>

         <!-- COF pattern Image -->
        <div class="bg-gray-50 rounded-lg overflow-hidden border border-gray-200">
          <div class="aspect-w-1 aspect-h-1 bg-gray-100">
            <% if @activity.pattern_image.attached? %>
              <%= image_tag @activity.pattern_image, class: "w-full h-32 object-cover", alt: "COF pattern Image" %>
            <% else %>
              <div class="w-full h-32 flex items-center justify-center bg-gray-100">
                <span class="text-xs text-gray-400">No image</span>
              </div>
            <% end %>
          </div>
          <div class="p-2 text-center">
            <span class="text-xs font-medium text-gray-600">COF Pattern Image</span>
          </div>
        </div>

        <!-- Image After -->
        <div class="bg-gray-50 rounded-lg overflow-hidden border border-gray-200">
          <div class="aspect-w-1 aspect-h-1 bg-gray-100">
            <% if @activity.image_after.attached? %>
              <%= image_tag @activity.image_after, class: "w-full h-32 object-cover", alt: "After Image" %>
            <% else %>
              <div class="w-full h-32 flex items-center justify-center bg-gray-100">
                <span class="text-xs text-gray-400">No image</span>
              </div>
            <% end %>
          </div>
          <div class="p-2 text-center">
            <span class="text-xs font-medium text-gray-600">After</span>
          </div>
        </div>
      </div>
    </div>

    <!-- Date Information -->
    <div class="p-6 border-b border-gray-100">
      <h3 class="text-xs font-medium text-gray-500 uppercase tracking-wider mb-3">Dates</h3>
      <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
        <div class="flex items-center gap-3">
          <div class="p-2 bg-blue-50 rounded-lg">
            <svg class="w-5 h-5 text-blue-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z"/>
            </svg>
          </div>
          <div>
            <span class="text-xs font-medium text-gray-500 block">Date In</span>
            <span class="text-sm font-medium text-gray-900"><%= @activity.date_in.strftime("%B %d, %Y %I:%M %p") if @activity.date_in %></span>
          </div>
        </div>
        <div class="flex items-center gap-3">
          <div class="p-2 bg-green-50 rounded-lg">
            <svg class="w-5 h-5 text-green-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z"/>
            </svg>
          </div>
          <div>
            <span class="text-xs font-medium text-gray-500 block">Date Out</span>
            <span class="text-sm font-medium text-gray-900"><%= @activity.date_out.strftime("%B %d, %Y %I:%M %p") if @activity.date_out %></span>
          </div>
        </div>
      </div>
    </div>

    <!-- Pricing Section -->
    <div class="p-6 border-b border-gray-100">
      <h3 class="text-xs font-medium text-gray-500 uppercase tracking-wider mb-3">Pricing</h3>
      <div class="grid grid-cols-1 sm:grid-cols-4 gap-4">
        <div class="bg-green-50 rounded-lg p-3 text-center">
          <span class="text-xs font-medium text-green-700 block">Starting Price</span>
          <span class="text-lg font-bold text-green-800">$<%= @activity.starting_price %></span>
        </div>
        <div class="bg-blue-50 rounded-lg p-3 text-center">
          <span class="text-xs font-medium text-blue-700 block">Final Price</span>
          <span class="text-lg font-bold text-blue-800">$<%= @activity.final_price %></span>
        </div>
        <div class="bg-purple-50 rounded-lg p-3 text-center">
          <span class="text-xs font-medium text-purple-700 block">Profit</span>
          <span class="text-lg font-bold <%= @activity.profit.to_f > 0 ? 'text-green-800' : @activity.profit.to_f < 0 ? 'text-red-800' : 'text-gray-800' %>">
            $<%= @activity.profit %>
          </span>
        </div>
        <div class="bg-gray-50 rounded-lg p-3 text-center">
          <span class="text-xs font-medium text-gray-700 block">Total Cost</span>
          <span class="text-lg font-bold text-gray-800">$<%= @activity.total_cost %></span>
        </div>
      </div>
    </div>

    <!-- Additional Costs -->
    <div class="p-6 border-b border-gray-100">
      <h3 class="text-xs font-medium text-gray-500 uppercase tracking-wider mb-3">Additional Costs</h3>
      <div class="grid grid-cols-1 sm:grid-cols-3 gap-4">
        <div>
          <span class="text-xs font-medium text-gray-500 block">Spare Used</span>
          <span class="text-sm font-medium text-gray-900"><%= @activity.spare_used.presence || "0" %></span>
        </div>
        <div>
          <span class="text-xs font-medium text-gray-500 block">Cost Each</span>
          <span class="text-sm font-medium text-gray-900">$<%= @activity.cost_each %></span>
        </div>
        <div>
          <span class="text-xs font-medium text-gray-500 block">Labour Cost</span>
          <span class="text-sm font-medium text-gray-900">$<%= @activity.labour_cost %></span>
        </div>
      </div>
    </div>

    <!-- User & Remarks -->
    <div class="p-6">
      <div class="grid grid-cols-1 sm:grid-cols-2 gap-6">
        <div>
          <h3 class="text-xs font-medium text-gray-500 uppercase tracking-wider mb-1">Recorded by</h3>
          <p class="text-sm font-medium text-gray-900"><%= @activity.user.first_name || "—" %></p>
        </div>
        <div>
          <h3 class="text-xs font-medium text-gray-500 uppercase tracking-wider mb-1">Created</h3>
          <p class="text-sm font-medium text-gray-900"><%= @activity.created_at.strftime("%B %d, %Y %I:%M %p") %></p>
        </div>
      </div>

      <% if @activity.remarks.present? %>
        <div class="mt-4 bg-yellow-50 border-l-4 border-yellow-400 p-4 rounded-lg">
          <h3 class="text-xs font-medium text-yellow-800 uppercase tracking-wider mb-1">Remarks</h3>
          <p class="text-sm text-gray-700"><%= @activity.remarks %></p>
        </div>
      <% end %>
    </div>
  </div>

  <!-- Action Buttons -->
  <div class="mt-6 flex flex-wrap gap-3">
    <%= link_to edit_activity_path(@activity), class: "inline-flex items-center gap-2 px-4 py-2.5 bg-blue-600 hover:bg-blue-700 text-white font-medium rounded-lg shadow-sm hover:shadow-md transition duration-150" do %>
      <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11 5H6a2 2 0 00-2 2v11a2 2 0 002 2h11a2 2 0 002-2v-5m-1.414-9.414a2 2 0 112.828 2.828L11.828 15H9v-2.828l8.586-8.586z"/>
      </svg>
      Edit Activity
    <% end %>
    
    <%= link_to activities_path, class: "inline-flex items-center gap-2 px-4 py-2.5 bg-gray-100 hover:bg-gray-200 text-gray-700 font-medium rounded-lg transition duration-150" do %>
      <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 19l-7-7m0 0l7-7m-7 7h18"/>
      </svg>
      Back to Activities
    <% end %>
    
    <%= button_to @activity, method: :delete, data: { turbo_confirm: "Are you sure you want to delete this activity?" }, class: "inline-flex items-center gap-2 px-4 py-2.5 bg-red-600 hover:bg-red-700 text-white font-medium rounded-lg shadow-sm hover:shadow-md transition duration-150" do %>
      <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16"/>
      </svg>
      Delete Activity
    <% end %>
  </div>
</div>