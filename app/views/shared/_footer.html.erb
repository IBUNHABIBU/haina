<%# app/views/shared/_footer.html.erb %>

<footer class="mt-12 border-t border-slate-200 bg-white">
  <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8 py-8">

    <div class="flex flex-col gap-6 md:flex-row md:items-center md:justify-between">

      <%# Brand %>
      <div class="flex items-center gap-3">
        <div class="flex h-9 w-9 items-center justify-center rounded-lg bg-indigo-600 text-white">
          <svg class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke-width="1.8" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" d="M11.42 15.17 17.25 21A2.652 2.652 0 0 0 21 17.25l-5.877-5.877M11.42 15.17l2.496-3.03c.317-.384.74-.626 1.208-.766M11.42 15.17l-4.655 5.653a2.548 2.548 0 1 1-3.586-3.586l6.837-5.63m5.108-.233c.55-.164 1.163-.188 1.743-.14a4.5 4.5 0 0 0 4.486-6.336l-3.276 3.277a3.004 3.004 0 0 1-2.25-2.25l3.276-3.276a4.5 4.5 0 0 0-6.336 4.486c.091 1.076-.071 2.264-.904 2.95l-.102.085m-1.745 1.437L5.909 7.5H4.5L2.25 3.75l1.5-1.5L7.5 4.5v1.409l4.26 4.26m-1.745 1.437 1.745-1.437m6.615 8.206L15.75 15.75M4.867 19.125h.008v.008h-.008v-.008Z" />
          </svg>
        </div>
        <div>
          <p class="text-sm font-semibold text-slate-900">Haina</p>
          <p class="text-xs text-slate-500">TV Repair Management</p>
        </div>
      </div>

      <%# Links %>
      <nav class="flex flex-wrap items-center gap-x-6 gap-y-2 text-sm">
      
        <%= link_to "Home", root_path,
            class: "text-slate-600 transition hover:text-indigo-600" %>
        <%= link_to "Activities", activities_path,
            class: "text-slate-600 transition hover:text-indigo-600" %>
        <%= link_to "Spares", spares_path,
            class: "text-slate-600 transition hover:text-indigo-600" %>
        <%= link_to "Customers", customers_path,
            class: "text-slate-600 transition hover:text-indigo-600" %>
        <%= link_to "Dashboard", dashboard_path,
            class: "text-slate-600 transition hover:text-indigo-600" %>
      </nav>

      <%# Meta %>
      <div class="flex items-center gap-3 text-xs text-slate-500">
        <span class="inline-flex items-center gap-1.5">
          <span class="h-1.5 w-1.5 rounded-full bg-emerald-500"></span>
          All systems operational
        </span>
        <span class="text-slate-300">·</span>
        <span>&copy; <%= Time.current.year %> Haina</span>
      </div>

    </div>

  </div>
</footer>