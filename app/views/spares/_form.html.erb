<%= form_with model: spare, class: "space-y-5" do |form| %><% if spare.errors.any? %><div class="rounded-lg bg-red-50 p-4 text-red-700"><%= spare.errors.full_messages.to_sentence %></div><% end %><div><%= form.label :spare_category_id, "Category", class: "label" %><%= form.collection_select :spare_category_id, @categories, :id, :name, { prompt: "Select category" }, class: "field" %></div><div><%= form.label :name, class: "label" %><%= form.text_field :name, class: "field" %></div><div class="grid gap-5 md:grid-cols-2"><div><%= form.label :part_number, class: "label" %><%= form.text_field :part_number, class: "field" %></div><div><%= form.label :brand, class: "label" %><%= form.text_field :brand, class: "field" %></div><div><%= form.label :unit_cost, "Unit cost (TSh)", class: "label" %><%= form.number_field :unit_cost, step: 0.01, min: 0, class: "field" %></div><div><%= form.label :selling_price, "Selling price (TSh)", class: "label" %><%= form.number_field :selling_price, step: 0.01, min: 0, class: "field" %></div><div><%= form.label :quantity, "Opening stock", class: "label" %><%= form.number_field :quantity, min: 0, class: "field" %></div><div><%= form.label :reorder_level, class: "label" %><%= form.number_field :reorder_level, min: 0, class: "field" %></div><div><%= form.label :location, class: "label" %><%= form.text_field :location, class: "field" %></div></div><div><%= form.label :notes, class: "label" %><%= form.text_area :notes, rows: 3, class: "field" %></div><%= form.submit class: "rounded-lg bg-blue-600 px-5 py-2.5 font-medium text-white" %><% end %>
