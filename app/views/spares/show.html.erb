<div class="mx-auto max-w-3xl space-y-5"><div class="flex justify-between"><div><h1 class="text-2xl font-bold"><%= @spare.name %></h1><p class="text-slate-500"><%= @spare.spare_category.name %></p></div><div class="flex gap-2"><%= link_to "Purchase stock", new_spare_spare_purchase_path(@spare), class: "rounded-lg bg-blue-600 px-4 py-2 text-white" %><%= link_to "Purchases", spare_spare_purchases_path(@spare), class: "rounded-lg border px-4 py-2" %><%= link_to "Edit", edit_spare_path(@spare), class: "rounded-lg border px-4 py-2" %></div></div><div class="grid gap-4 md:grid-cols-3"><div class="rounded-xl border bg-white p-5"><p class="text-sm text-slate-500">Stock</p><p class="text-2xl font-bold"><%= @spare.quantity %></p></div><div class="rounded-xl border bg-white p-5"><p class="text-sm text-slate-500">Unit cost</p><p class="text-xl font-bold"><%= number_to_currency(@spare.unit_cost, unit: "TSh ", precision: 0) %></p></div><div class="rounded-xl border bg-white p-5"><p class="text-sm text-slate-500">Stock value</p><p class="text-xl font-bold"><%= number_to_currency(@spare.stock_value, unit: "TSh ", precision: 0) %></p></div></div></div>
