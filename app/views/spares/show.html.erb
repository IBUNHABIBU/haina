<% content_for :title, "#{@spare.name} — Spare" %>

<div class="mx-auto max-w-3xl px-4 sm:px-6 lg:px-8 py-8 space-y-6">

  <%# ============ HEADER ============ %>
  <div class="flex flex-wrap items-start justify-between gap-4">
    <div class="flex items-start gap-4">
      <div class="flex h-12 w-12 shrink-0 items-center justify-center rounded-xl bg-indigo-100 text-indigo-700">
        <svg class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke-width="1.8" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" d="m21 7.5-9-5.25L3 7.5m18 0-9 5.25m9-5.25v9l-9 5.25M3 7.5l9 5.25M3 7.5v9l9 5.25m0-9v9" />
        </svg>
      </div>

      <div>
        <div class="flex items-center gap-2">
          <h1 class="text-2xl font-semibold tracking-tight text-slate-900">
            <%= @spare.name %>
          </h1>
          <% if @spare.spare_category&.name.present? %>
            <span class="inline-flex items-center rounded-full bg-slate-100 px-2.5 py-1 text-xs font-medium text-slate-700">
              <%= @spare.spare_category.name %>
            </span>
          <% end %>
        </div>

        <% if @spare.part_number.present? %>
          <p class="mt-1 text-sm font-mono text-slate-500">
            <%= @spare.part_number %>
          </p>
        <% end %>
      </div>
    </div>

    <div class="flex flex-wrap items-center gap-2">
      <%= link_to spares_path,
          class: "inline-flex items-center gap-1.5 rounded-lg border border-slate-200 bg-white px-4 py-2.5 text-sm font-medium text-slate-700 shadow-sm transition hover:bg-slate-50" do %>
        <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke-width="1.8" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" d="M10.5 19.5 3 12m0 0 7.5-7.5M3 12h18" />
        </svg>
        Back
      <% end %>

      <%= link_to spare_spare_purchases_path(@spare),
          class: "inline-flex items-center gap-1.5 rounded-lg border border-slate-200 bg-white px-4 py-2.5 text-sm font-medium text-slate-700 shadow-sm transition hover:bg-slate-50" do %>
        <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke-width="1.8" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" d="M9 12h3.75M9 15h3.75M9 18h3.75m3 .75H18a2.25 2.25 0 0 0 2.25-2.25V6.108c0-1.135-.845-2.098-1.976-2.192a48.424 48.424 0 0 0-1.123-.08m-5.801 0c-.065.21-.1.433-.1.664 0 .414.336.75.75.75h4.5a.75.75 0 0 0 .75-.75 2.25 2.25 0 0 0-.1-.664m-5.8 0A2.251 2.251 0 0 1 13.5 2.25H15c1.012 0 1.867.668 2.15 1.586m-5.8 0c-.376.023-.75.05-1.124.08C9.095 4.01 8.25 4.973 8.25 6.108V8.25m0 0H4.875c-.621 0-1.125.504-1.125 1.125v11.25c0 .621.504 1.125 1.125 1.125h9.75c.621 0 1.125-.504 1.125-1.125V9.375c0-.621-.504-1.125-1.125-1.125H8.25ZM6.75 12h.008v.008H6.75V12Zm0 3h.008v.008H6.75V15Zm0 3h.008v.008H6.75V18Z" />
        </svg>
        Purchases
      <% end %>

      <%= link_to edit_spare_path(@spare),
          class: "inline-flex items-center gap-1.5 rounded-lg border border-slate-200 bg-white px-4 py-2.5 text-sm font-medium text-slate-700 shadow-sm transition hover:bg-slate-50" do %>
        <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke-width="1.8" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" d="m16.862 4.487 1.687-1.688a1.875 1.875 0 1 1 2.652 2.652L10.582 16.07a4.5 4.5 0 0 1-1.897 1.13L6 18l.8-2.685a4.5 4.5 0 0 1 1.13-1.897l8.932-8.931Z" />
        </svg>
        Edit
      <% end %>

      <%= link_to new_spare_spare_purchase_path(@spare),
          class: "inline-flex items-center gap-1.5 rounded-lg bg-blue-600 px-4 py-2.5 text-sm font-semibold text-white shadow-sm transition hover:bg-blue-500" do %>
        <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" d="M12 4.5v15m7.5-7.5h-15" />
        </svg>
        Purchase stock
      <% end %>
    </div>
  </div>

  <%# ============ KPI CARDS ============ %>
  <div class="grid gap-4 sm:grid-cols-3">
    <div class="rounded-xl border border-slate-200 bg-white p-5 shadow-sm">
      <div class="flex items-center justify-between">
        <p class="text-xs font-medium uppercase tracking-wider text-slate-500">Stock</p>
        <div class="flex h-8 w-8 items-center justify-center rounded-lg bg-indigo-50 text-indigo-600">
          <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke-width="1.8" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" d="m21 7.5-9-5.25L3 7.5m18 0-9 5.25m9-5.25v9l-9 5.25M3 7.5l9 5.25M3 7.5v9l9 5.25m0-9v9" />
          </svg>
        </div>
      </div>
      <p class="mt-3 text-2xl font-semibold tabular-nums text-slate-900">
        <%= @spare.quantity %>
      </p>
      <p class="mt-1 text-xs text-slate-400">Available units</p>
    </div>

    <div class="rounded-xl border border-slate-200 bg-white p-5 shadow-sm">
      <div class="flex items-center justify-between">
        <p class="text-xs font-medium uppercase tracking-wider text-slate-500">Unit cost</p>
        <div class="flex h-8 w-8 items-center justify-center rounded-lg bg-amber-50 text-amber-600">
          <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke-width="1.8" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" d="M2.25 18.75a60.07 60.07 0 0 1 15.797 2.101c.727.198 1.453-.342 1.453-1.096V18.75M3.75 4.5v.75A.75.75 0 0 1 3 6h-.75m0 0v-.375c0-.621.504-1.125 1.125-1.125H20.25M2.25 6v9m18-10.5v.75c0 .414.336.75.75.75h.75m-1.5-1.5h.375c.621 0 1.125.504 1.125 1.125v9.75c0 .621-.504 1.125-1.125 1.125h-.375m1.5-1.5H21a.75.75 0 0 0-.75.75v.75m0 0H3.75m0 0h-.375a1.125 1.125 0 0 1-1.125-1.125V15m1.5 1.5v-.75A.75.75 0 0 0 3 15h-.75M15 10.5a3 3 0 1 1-6 0 3 3 0 0 1 6 0Zm3 0h.008v.008H18V10.5Zm-12 0h.008v.008H6V10.5Z" />
          </svg>
        </div>
      </div>
      <p class="mt-3 text-2xl font-semibold tabular-nums text-slate-900">
        <%= number_to_currency(@spare.unit_cost, unit: "TSh ", precision: 0) %>
      </p>
      <p class="mt-1 text-xs text-slate-400">Per unit</p>
    </div>

    <div class="rounded-xl border border-slate-200 bg-white p-5 shadow-sm">
      <div class="flex items-center justify-between">
        <p class="text-xs font-medium uppercase tracking-wider text-slate-500">Stock value</p>
        <div class="flex h-8 w-8 items-center justify-center rounded-lg bg-emerald-50 text-emerald-600">
          <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke-width="1.8" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" d="M2.25 18 9 11.25l4.306 4.306a11.95 11.95 0 0 1 5.814-5.518l2.74-1.22m0 0-5.94-2.281m5.94 2.28-2.28 5.941" />
          </svg>
        </div>
      </div>
      <p class="mt-3 text-2xl font-semibold tabular-nums text-slate-900">
        <%= number_to_currency(@spare.stock_value, unit: "TSh ", precision: 0) %>
      </p>
      <p class="mt-1 text-xs text-slate-400">Total inventory value</p>
    </div>
  </div>

  <%# ============ DETAILS ============ %>
  <section class="overflow-hidden rounded-xl border border-slate-200 bg-white shadow-sm">
    <header class="flex items-center gap-3 border-b border-slate-100 px-6 py-4">
      <div class="flex h-8 w-8 items-center justify-center rounded-lg bg-slate-100 text-slate-600">
        <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke-width="1.8" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" d="M11.25 11.25l.041-.02a.75.75 0 0 1 1.063.852l-.708 2.836a.75.75 0 0 0 1.063.853l.041-.021M21 12a9 9 0 1 1-18 0 9 9 0 0 1 18 0Zm-9-3.75h.008v.008H12V8.25Z" />
        </svg>
      </div>
      <div>
        <h2 class="text-sm font-semibold text-slate-900">Details</h2>
        <p class="text-xs text-slate-500">Part and inventory information.</p>
      </div>
    </header>

    <dl class="divide-y divide-slate-100">
      <div class="flex items-center justify-between px-6 py-3.5 text-sm">
        <dt class="text-slate-500">Category</dt>
        <dd class="font-medium text-slate-900"><%= @spare.spare_category&.name || "—" %></dd>
      </div>

      <div class="flex items-center justify-between px-6 py-3.5 text-sm">
        <dt class="text-slate-500">Part number</dt>
        <dd class="font-medium font-mono text-slate-900"><%= @spare.part_number.presence || "—" %></dd>
      </div>

      <div class="flex items-center justify-between px-6 py-3.5 text-sm">
        <dt class="text-slate-500">Brand</dt>
        <dd class="font-medium text-slate-900"><%= @spare.brand.presence || "—" %></dd>
      </div>

      <div class="flex items-center justify-between px-6 py-3.5 text-sm">
        <dt class="text-slate-500">Selling price</dt>
        <dd class="font-medium tabular-nums text-slate-900">
          <%= number_to_currency(@spare.selling_price, unit: "TSh ", precision: 0) %>
        </dd>
      </div>

      <div class="flex items-center justify-between px-6 py-3.5 text-sm">
        <dt class="text-slate-500">Reorder level</dt>
        <dd>
          <% if @spare.quantity.to_i <= @spare.reorder_level.to_i %>
            <span class="inline-flex items-center gap-1 rounded-full bg-rose-50 px-2.5 py-1 text-xs font-medium text-rose-700 ring-1 ring-inset ring-rose-200">
              <%= @spare.reorder_level %> (low stock)
            </span>
          <% else %>
            <span class="font-medium text-slate-900"><%= @spare.reorder_level %></span>
          <% end %>
        </dd>
      </div>

      <div class="flex items-center justify-between px-6 py-3.5 text-sm">
        <dt class="text-slate-500">Location</dt>
        <dd class="font-medium text-slate-900"><%= @spare.location.presence || "—" %></dd>
      </div>

      <% if @spare.notes.present? %>
        <div class="flex items-start justify-between px-6 py-3.5 text-sm">
          <dt class="text-slate-500">Notes</dt>
          <dd class="max-w-md whitespace-pre-wrap text-right text-slate-700"><%= @spare.notes %></dd>
        </div>
      <% end %>
    </dl>
  </section>

</div>