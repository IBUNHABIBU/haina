<div class="mx-auto max-w-7xl"><div class="mb-6 flex flex-wrap items-center justify-between gap-3"><div><h1 class="text-2xl font-bold">Spare Inventory</h1><p class="text-slate-500"><%= @spares.count %> items · <%= @low_stock_count %> low stock</p></div><%= link_to "Add Spare", new_spare_path, class: "rounded-lg bg-blue-600 px-4 py-2.5 font-medium text-white" %></div><div class="overflow-x-auto rounded-xl border bg-white shadow-sm"><table class="min-w-full divide-y"><thead class="bg-slate-50"><tr><th class="px-4 py-3 text-left text-xs uppercase">Spare</th><th class="px-4 py-3 text-left text-xs uppercase">Category</th><th class="px-4 py-3 text-left text-xs uppercase">Part number</th><th class="px-4 py-3 text-right text-xs uppercase">Cost</th><th class="px-4 py-3 text-right text-xs uppercase">Stock</th><th class="px-4 py-3 text-right text-xs uppercase">Value</th><th></th></tr></thead><tbody class="divide-y"><% @spares.each do |spare| %><tr><td class="px-4 py-3 font-medium"><%= spare.name %></td><td class="px-4 py-3"><%= spare.spare_category.name %></td><td class="px-4 py-3"><%= spare.part_number.presence || "—" %></td><td class="px-4 py-3 text-right"><%= number_to_currency(spare.unit_cost, unit: "TSh ", precision: 0) %></td><td class="px-4 py-3 text-right <%= spare.quantity <= spare.reorder_level ? 'font-bold text-red-600' : '' %>"><%= spare.quantity %></td><td class="px-4 py-3 text-right"><%= number_to_currency(spare.stock_value, unit: "TSh ", precision: 0) %></td><td class="px-4 py-3 text-right"><%= link_to "View", spare, class: "text-blue-600" %></td></tr><% end %></tbody></table></div></div>
