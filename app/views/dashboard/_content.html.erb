
<%# ============ 2. KPI Cards ============ %>
<div class="grid gap-4 sm:grid-cols-2 lg:grid-cols-5">

  <!-- Sales -->
  <div class="rounded-xl border border-slate-200 bg-white p-5 shadow-sm">
    <p class="text-xs font-medium uppercase tracking-wider text-slate-500">Sales</p>
    <p class="mt-3 text-2xl font-semibold tabular-nums text-slate-900">
      <%= number_to_currency(@sales, unit: "TSh ", precision: 0) %>
    </p>
    <p class="mt-1 text-xs text-slate-400">Total revenue</p>
  </div>

  <!-- Gross Profit -->
  <div class="rounded-xl border border-slate-200 bg-white p-5 shadow-sm">
    <p class="text-xs font-medium uppercase tracking-wider text-slate-500">Gross profit</p>
    <p class="mt-3 text-2xl font-semibold tabular-nums <%= @gross_profit.to_f.positive? ? 'text-emerald-600' : @gross_profit.to_f.negative? ? 'text-rose-600' : 'text-slate-900' %>">
      <%= number_to_currency(@gross_profit, unit: "TSh ", precision: 0) %>
    </p>
    <p class="mt-1 text-xs text-slate-400">After spares &amp; labour</p>
  </div>

  <!-- Expenses -->
  <div class="rounded-xl border border-slate-200 bg-white p-5 shadow-sm">
    <p class="text-xs font-medium uppercase tracking-wider text-slate-500">Expenses</p>
    <p class="mt-3 text-2xl font-semibold tabular-nums text-slate-900">
      <%= number_to_currency(@expenses, unit: "TSh ", precision: 0) %>
    </p>
    <p class="mt-1 text-xs text-slate-400">Operating costs</p>
  </div>

  <!-- Net Profit -->
  <div class="rounded-xl border border-slate-200 bg-white p-5 shadow-sm">
    <p class="text-xs font-medium uppercase tracking-wider text-slate-500">Net profit</p>
    <p class="mt-3 text-2xl font-semibold tabular-nums <%= @net_profit.to_f.positive? ? 'text-emerald-600' : @net_profit.to_f.negative? ? 'text-rose-600' : 'text-slate-900' %>">
      <%= number_to_currency(@net_profit, unit: "TSh ", precision: 0) %>
    </p>
    <p class="mt-1 text-xs text-slate-400">Bottom line</p>
  </div>

  <!-- Repairs -->
  <div class="rounded-xl border border-slate-200 bg-white p-5 shadow-sm">
    <p class="text-xs font-medium uppercase tracking-wider text-slate-500">Repairs</p>
    <p class="mt-3 text-2xl font-semibold tabular-nums text-slate-900"><%= @repair_count %></p>
    <div class="mt-1 flex flex-wrap items-center gap-2 text-xs">
      <span class="text-slate-400"><%= @return_count %> returns</span>
      <span class="<%= @low_stock_count.to_i.positive? ? 'font-medium text-rose-600' : 'text-slate-400' %>">
        <%= @low_stock_count %> low stock
      </span>
    </div>
  </div>

  <!-- Top Irreparable -->
  <div class="rounded-xl border border-slate-200 bg-white p-5 shadow-sm">
    <p class="text-xs font-medium uppercase tracking-wider text-slate-500">Top Irreparable</p>
    <p class="mt-3 truncate text-sm font-semibold text-slate-900">
      <%= @top_irreparable_reason&.first || "—" %>
    </p>
    <p class="mt-1 text-xs text-slate-400">
      <%= @top_irreparable_reason&.last || 0 %> activities
    </p>
  </div>

  <!-- MTTR -->
  <div class="rounded-xl border border-slate-200 bg-white p-5 shadow-sm">
    <p class="text-xs font-medium uppercase tracking-wider text-slate-500">MTTR</p>
    <p class="mt-3 text-2xl font-semibold tabular-nums text-slate-900">
      <%= @mttr_avg_hours %> <span class="text-sm font-normal text-slate-500">hrs</span>
    </p>
    <p class="mt-1 text-xs text-slate-400">Average repair time</p>
  </div>

</div>

<%# ============ 3. GRAPHS ============ %>

<div class="grid gap-6 lg:grid-cols-2 mt-6">

  <!-- Top TV Brands -->
  <section class="rounded-xl border border-slate-200 bg-white p-6 shadow-sm">
    <h2 class="text-sm font-semibold text-slate-900 mb-1">Top TV Brands</h2>
    <p class="text-xs text-slate-500 mb-6">Brand zinazokuja sana kwa repair katika <%= @chart_period_label %>.</p>

    <%= bar_chart @top_brands,
    colors: ["#6366f1"],
    library: {
      plugins: { legend: { display: false } },
      indexAxis: 'y',
      scales: {
        x: {
          beginAtZero: true,
          min: 0,
          ticks: {
            precision: 0,
            stepSize: 1
          }
        }
      }
    } %>
 
  </section>

  <!-- Top TV Sizes -->
  <section class="rounded-xl border border-slate-200 bg-white p-6 shadow-sm">
    <h2 class="text-sm font-semibold text-slate-900 mb-1">Top TV Sizes</h2>
    <p class="text-xs text-slate-500 mb-6">Ukubwa wa TV unaokuja sana.</p>

    <%= pie_chart @top_sizes,
   discrete: true,
        colors: ["#f59e0b", "#ef4444", "#10b981", "#3b82f6", "#8b5cf6"],
        donut: true,
        library: { plugins: { legend: { position: "bottom" } } } %>
  </section>

  <!-- Top COF Numbers -->
  <section class="rounded-xl border border-slate-200 bg-white p-6 shadow-sm">
    <h2 class="text-sm font-semibold text-slate-900 mb-1">Top COF Numbers</h2>
    <p class="text-xs text-slate-500 mb-6">COF numbers zinazokuja sana.</p>

    <%= bar_chart @top_cofs,
   discrete: true,
        colors: ["#10b981"],
    library: {
      plugins: { legend: { display: false } },
      indexAxis: 'y',
      scales: {
        x: {
          beginAtZero: true,
          min: 0,
          ticks: {
            precision: 0,
            stepSize: 1
          }
        }
      }
    } %>
  </section>

  <!-- Status Breakdown -->
  <section class="rounded-xl border border-slate-200 bg-white p-6 shadow-sm">
    <h2 class="text-sm font-semibold text-slate-900 mb-1">Status Breakdown</h2>
    <p class="text-xs text-slate-500 mb-6">Mgawanyo wa repair kwa status.</p>

    <%= pie_chart @status_breakdown,
       discrete: true,
        colors: ["#94a3b8", "#3b82f6", "#f59e0b", "#6366f1", "#10b981", "#14b8a6", "#06b6d4", "#f43f5e", "#6b7280"],
        library: { plugins: { legend: { position: "bottom" } } } %>
  </section>

  <!-- Top Customers -->
  <section class="rounded-xl border border-slate-200 bg-white p-6 shadow-sm lg:col-span-2">
    <h2 class="text-sm font-semibold text-slate-900 mb-1">Top Customers</h2>
    <p class="text-xs text-slate-500 mb-6">Wateja wanaokuja mara nyingi kwa repair.</p>

    <%= bar_chart @top_customers,
       discrete: true,
        colors: ["#6366f1"],
    library: {
      plugins: { legend: { display: false } },
      indexAxis: 'y',
      scales: {
        x: {
          beginAtZero: true,
          min: 0,
          ticks: {
            precision: 0,
            stepSize: 1
          }
        }
      }
    } %>
  </section>

  <!-- Customer Trend -->
  <section class="rounded-xl border border-slate-200 bg-white p-6 shadow-sm">
    <h2 class="text-sm font-semibold text-slate-900 mb-1">Customer Trend</h2>
    <p class="text-xs text-slate-500 mb-6">Idadi ya wateja — <%= @chart_period_label %>.</p>

    <%= line_chart @customer_trend,
        discrete: true,
        colors: ["#6366f1"],
        curve: false,
        points: true,
        library: {
          plugins: { legend: { display: false } },
          scales: {
            y: { beginAtZero: true, ticks: { precision: 0, stepSize: 1 } }
          }
        } %>
  </section>

  <!-- Sales Trend -->
  <section class="rounded-xl border border-slate-200 bg-white p-6 shadow-sm">
    <h2 class="text-sm font-semibold text-slate-900 mb-1">Sales Trend — <%= @chart_period_label %></h2>
    <p class="text-xs text-slate-500 mb-6">Mapato katika kipindi kilichochaguliwa.</p>

    <%= line_chart @sales_trend,
       discrete: true,
        colors: ["#f59e0b"],
        curve: false,
        points: true,
        library: {
          plugins: { legend: { display: false } },
          scales: { y: { beginAtZero: true, ticks: { precision: 0 } } }
        } %>
  </section>

  <!-- Gross Profit Trend -->
  <section class="rounded-xl border border-slate-200 bg-white p-6 shadow-sm">
    <h2 class="text-sm font-semibold text-slate-900 mb-1">Gross Profit — <%= @chart_period_label %></h2>
    <p class="text-xs text-slate-500 mb-6">Faida katika kipindi kilichochaguliwa.</p>

    <%= bar_chart @profit_trend,
       discrete: true,
        colors: ["#10b981"],
        library: {
          plugins: { legend: { display: false } },
          scales: { y: { beginAtZero: true, ticks: { precision: 0 } } }
        } %>
  </section>

  <!-- Repairs Trend -->
  <section class="rounded-xl border border-slate-200 bg-white p-6 shadow-sm">
    <h2 class="text-sm font-semibold text-slate-900 mb-1">Repairs Trend — <%= @chart_period_label %></h2>
    <p class="text-xs text-slate-500 mb-6">Idadi ya repairs katika kipindi kilichochaguliwa.</p>

    <%= line_chart @repair_trend,
       discrete: true,
        colors: ["#6366f1"],
        curve: false,
        points: true,
        library: {
          plugins: { legend: { display: false } },
          scales: { y: { beginAtZero: true, ticks: { precision: 0, stepSize: 1 } } }
        } %>
  </section>

  <!-- MTTR Trend -->
  <section class="rounded-xl border border-slate-200 bg-white p-6 shadow-sm">
    <h2 class="text-sm font-semibold text-slate-900 mb-1">MTTR Trend — <%= @chart_period_label %></h2>
    <p class="text-xs text-slate-500 mb-6">Wastani wa muda wa repair (masaa).</p>

    <%= line_chart @mttr_trend,
       discrete: true,
        colors: ["#3b82f6"],
        curve: false,
        points: true,
        library: {
          plugins: { legend: { display: false } },
          scales: { y: { beginAtZero: true, ticks: { precision: 1 } } }
        } %>
  </section>

  <!-- Irreparable by Period -->
  <section class="rounded-xl border border-slate-200 bg-white p-6 shadow-sm lg:col-span-2">
    <h2 class="text-sm font-semibold text-slate-900 mb-1">Irreparable — <%= @chart_period_label %></h2>
    <p class="text-xs text-slate-500 mb-6">Sababu za irreparable kwa kila kundi la muda.</p>

    <% if @irreparable_by_period_chart.present? %>
      <%= bar_chart @irreparable_by_period_chart,
         discrete: true,
          stacked: true,
          colors: ["#f43f5e", "#f59e0b", "#8b5cf6", "#3b82f6", "#10b981", "#6b7280"],
          library: {
            plugins: { legend: { position: "bottom" } },
            scales: {
              x: { stacked: true },
              y: { stacked: true, beginAtZero: true, ticks: { precision: 0, stepSize: 1 } }
            }
          } %>
    <% else %>
      <div class="py-12 text-center text-sm text-slate-500">
        Hakuna TV irreparable katika kipindi hiki. 🎉
      </div>
    <% end %>
  </section>

  <!-- Irreparable by Reason -->
  <section class="rounded-xl border border-slate-200 bg-white p-6 shadow-sm">
    <h2 class="text-sm font-semibold text-slate-900 mb-1">Irreparable by Reason</h2>
    <p class="text-xs text-slate-500 mb-6">Sababu za irreparable katika <%= @chart_period_label %>.</p>

    <% if @irreparable_by_reason.present? %>
      <%= pie_chart @irreparable_by_reason,
         discrete: true,
          colors: ["#f43f5e", "#f59e0b", "#8b5cf6", "#3b82f6", "#10b981", "#6b7280", "#ec4899"],
          donut: true,
          library: { plugins: { legend: { position: "bottom" } } } %>
    <% else %>
      <div class="py-12 text-center text-sm text-slate-500">
        Hakuna TV irreparable katika kipindi hiki. 🎉
      </div>
    <% end %>
  </section>

  <!-- Longest Repair Duration -->
  <section class="rounded-xl border border-slate-200 bg-white p-6 shadow-sm">
    <h2 class="text-sm font-semibold text-slate-900 mb-1">Longest Repair Duration — <%= @chart_period_label %></h2>
    <p class="text-xs text-slate-500 mb-6">TV zilizokaa muda mrefu workshop katika kipindi hiki (masaa).</p>

    <% if @top_durations.present? %>
      <%= bar_chart @top_durations,
         discrete: true,
          colors: ["#f59e0b"],
          library: {
            plugins: { legend: { display: false } },
            scales: { x: { beginAtZero: true, ticks: { precision: 1 } } },
            indexAxis: "y"
          } %>
    <% else %>
      <div class="py-12 text-center text-sm text-slate-500">
        Hakuna repair duration katika kipindi hiki.
      </div>
    <% end %>
  </section>

</div>

<%# ============ 4. SALES BREAKDOWN ============ %>
<section class="mt-6 overflow-hidden rounded-xl border border-slate-200 bg-white shadow-sm">
  <header class="flex items-center justify-between border-b border-slate-100 px-6 py-4">
    <div>
      <h2 class="text-sm font-semibold text-slate-900">Sales — <%= @chart_period_label %></h2>
      <p class="mt-0.5 text-xs text-slate-500">Revenue breakdown kwa siku ndani ya kipindi kilichochaguliwa.</p>
    </div>
  </header>

  <% if @sales_by_day.present? %>
    <ul class="divide-y divide-slate-100">
      <% max = @sales_by_day.values.map(&:to_f).max.to_f %>

      <% @sales_by_day.each do |date, amount| %>
        <li class="flex items-center gap-4 px-6 py-3">
          <div class="w-24 shrink-0 text-sm text-slate-500"><%= date %></div>

          <div class="relative h-1.5 flex-1 overflow-hidden rounded-full bg-slate-100">
            <div class="absolute inset-y-0 left-0 rounded-full bg-indigo-500"
                 style="width: <%= max.positive? ? (amount.to_f / max * 100).round(1) : 0 %>%"></div>
          </div>

          <div class="w-28 shrink-0 text-right text-sm font-semibold tabular-nums text-slate-900">
            <%= number_to_currency(amount, unit: "TSh ", precision: 0) %>
          </div>
        </li>
      <% end %>
    </ul>
  <% else %>
    <div class="px-6 py-10 text-center text-sm text-slate-500">
      No sales in this period.
    </div>
  <% end %>
</section>

<%# ============ 5. WATEJA WANAODAIWA ============ %>
<div class="grid gap-6 lg:grid-cols-3 mt-6">

  <!-- Debtors List -->
  <div class="rounded-xl border border-slate-200 bg-white shadow-sm lg:col-span-2 overflow-hidden flex flex-col">
    <header class="flex items-center justify-between border-b border-slate-100 px-6 py-4 shrink-0">
      <div>
        <h2 class="text-sm font-semibold text-slate-900">Wateja Wanaodaiwa</h2>
        <p class="text-xs text-slate-500">Activities zenye balance (starting_price - price).</p>
      </div>

      <span class="inline-flex items-center rounded-full bg-rose-50 px-2.5 py-1 text-xs font-medium text-rose-700 ring-1 ring-inset ring-rose-200">
        <%= @debtors.size %> records
      </span>
    </header>

    <% if @debtors.any? %>
      <div class="divide-y divide-slate-100 overflow-y-auto max-h-[500px]">
        <% @debtors.each do |activity| %>
          <% balance = activity.starting_price - activity.price %>

          <div class="flex items-center justify-between px-6 py-3.5 hover:bg-slate-50/70 transition">
            <div class="flex items-center gap-3 min-w-0">
              <div class="flex h-8 w-8 shrink-0 items-center justify-center rounded-full bg-rose-100 text-xs font-semibold text-rose-700">
                <%= activity.customer&.name.to_s.first&.upcase || "?" %>
              </div>

              <div class="min-w-0">
                <p class="text-sm font-medium text-slate-900 truncate">
                  <%= activity.customer&.name || "Unknown" %>
                </p>

                <p class="text-xs text-slate-500 truncate">
                  <%= [activity.tv_brand&.name, activity.tv_size&.size].compact.join(" ") %>
                  · <%= activity.tatizo&.name %>
                </p>
              </div>
            </div>

            <div class="flex items-center gap-4">
              <div class="text-right">
                <p class="text-sm font-semibold tabular-nums text-rose-600">
                  <%= number_to_currency(balance, unit: "TSh ", precision: 0) %>
                </p>
                <p class="text-[10px] text-slate-400 uppercase tracking-wide">Deni</p>
              </div>

              <%= link_to activity,
                  class: "rounded-lg p-1.5 text-slate-400 hover:bg-indigo-50 hover:text-indigo-600 transition",
                  title: "View Activity" do %>
                <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M13.5 4.5 21 12m0 0-7.5 7.5M21 12H3" />
                </svg>
              <% end %>
            </div>
          </div>
        <% end %>
      </div>
    <% else %>
      <div class="px-6 py-12 text-center">
        <p class="text-sm text-slate-500">Hakuna wateja wanaodaiwa kwa sasa. 🎉</p>
      </div>
    <% end %>
  </div>

  <!-- Total Debt -->
  <div class="rounded-xl border border-rose-200 bg-rose-50/40 p-6 shadow-sm flex flex-col justify-between">
    <div>
      <p class="text-xs font-medium uppercase tracking-wider text-rose-700">Jumla ya Madeni</p>
      <p class="mt-1 text-xs text-rose-600">Starting price − Paid price</p>
    </div>

    <div class="mt-4">
      <p class="text-3xl font-bold tabular-nums text-rose-700">
        <%= number_to_currency(@total_debt, unit: "TSh ", precision: 0) %>
      </p>

      <p class="mt-1 text-xs text-rose-600">
        Kutoka kwa activities <%= @debtors_count %> zenye balance.
      </p>
    </div>

    <div class="mt-4 pt-4 border-t border-rose-200/60">
      <%= link_to activities_path,
          class: "inline-flex items-center gap-1.5 text-sm font-medium text-rose-700 hover:text-rose-900" do %>
        Angalia activities zote
        <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" d="M13.5 4.5 21 12m0 0-7.5 7.5M21 12H3" />
        </svg>
      <% end %>
    </div>
  </div>

</div>

<!-- KPI Cards (Zilizopo) -->
<div class="grid gap-4 sm:grid-cols-2 lg:grid-cols-5">
  <!-- ... Sales, Gross Profit, Expenses, Net Profit, Repairs, MTTR ... -->
</div>

<!-- ============================================================
     LOST REVENUE SECTION (Pesa inayovuja)
     ============================================================ -->
<div class="grid gap-4 sm:grid-cols-2 lg:grid-cols-3 mt-4">


  <!-- Pesa Ulizokosa kwa Irreparable -->
  <div class="rounded-xl border border-amber-200 bg-amber-50/40 p-5 shadow-sm">
    <div class="flex items-center justify-between">
      <p class="text-xs font-medium uppercase tracking-wider text-amber-700">Mapato Yaliyokosa (Irreparable)</p>
      <div class="flex h-8 w-8 items-center justify-center rounded-lg bg-amber-100 text-amber-600">
        <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke-width="1.8" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" d="M12 9v3.75m9-.75a9 9 0 1 1-18 0 9 9 0 0 1 18 0Zm-9 3.75h.008v.008H12v-.008Z" />
        </svg>
      </div>
    </div>
    <p class="mt-3 text-2xl font-semibold tabular-nums text-amber-700">
      <%= number_to_currency(@total_irreparable_lost, unit: "TSh ", precision: 0) %>
    </p>
    <p class="mt-1 text-xs text-amber-600">TV zilizoshindwa kurekebishwa</p>
  </div>

  <!-- Jumla ya Pesa Iliyokosa -->
  <div class="rounded-xl border border-slate-800 bg-slate-900 p-5 shadow-sm">
    <div class="flex items-center justify-between">
      <p class="text-xs font-medium uppercase tracking-wider text-slate-300">Total lost revenew</p>
      <div class="flex h-8 w-8 items-center justify-center rounded-lg bg-slate-800 text-slate-300">
        <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke-width="1.8" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" d="M2.25 6 9 12.75l4.286-4.286a11.948 11.948 0 0 1 4.214 6.843L21 21M21 21v-6.75M21 21h-6.75" />
        </svg>
      </div>
    </div>
    <p class="mt-3 text-2xl font-semibold tabular-nums text-white">
      <%= number_to_currency(@total_lost_revenue, unit: "TSh ", precision: 0) %>
    </p>
    <p class="mt-1 text-xs text-slate-400">Madeni + Irreparable</p>
  </div>
</div>

<section class="rounded-xl border border-slate-200 bg-white p-6 shadow-sm lg:col-span-2">
  <h2 class="text-sm font-semibold text-slate-900 mb-1">Lost Revenue Trend</h2>
  <p class="text-xs text-slate-500 mb-6">Pesa iliyokosa (Madeni + Irreparable) kwa kila mwezi.</p>
  <%= bar_chart @lost_revenue_trend,
      colors: ["#f43f5e"],
      library: {
        plugins: { legend: { display: false } },
        scales: { y: { beginAtZero: true, ticks: { precision: 0 } } }
      } %>
</section>
<!-- ============================================================
     COF WASTAGE GRAPHS
     ============================================================ -->
<div class="grid gap-6 lg:grid-cols-2 mt-6">
  
  <!-- COF Wastage Count Trend -->
  <section class="rounded-xl border border-slate-200 bg-white p-6 shadow-sm">
    <h2 class="text-sm font-semibold text-slate-900 mb-1">COF Wastage (Idadi)</h2>
    <p class="text-xs text-slate-500 mb-6">Idadi ya COF zilizoharibika kwa <%= @chart_period_label %>.</p>
    
    <% if @cof_wastage_count_trend.any? %>
      <%= bar_chart @cof_wastage_count_trend,
          colors: ["#f59e0b"],
          library: {
            plugins: { legend: { display: false } },
            scales: {
              y: { beginAtZero: true, ticks: { precision: 0, stepSize: 1 } }
            }
          } %>
    <% else %>
      <div class="flex flex-col items-center justify-center py-12 text-center">
        <p class="text-sm text-slate-500">Hakuna COF wastage kwa kipindi hiki. 🎉</p>
      </div>
    <% end %>
  </section>

  <!-- COF Wastage Value Trend -->
  <section class="rounded-xl border border-slate-200 bg-white p-6 shadow-sm">
    <h2 class="text-sm font-semibold text-slate-900 mb-1">COF Wastage (Thamani)</h2>
    <p class="text-xs text-slate-500 mb-6">Pesa iliyopotea kwa COF zilizoharibika kwa <%= @chart_period_label %>.</p>
    
    <% if @cof_wastage_value_trend.any? %>
      <%= bar_chart @cof_wastage_value_trend,
          colors: ["#ef4444"],
          library: {
            plugins: { legend: { display: false } },
            scales: {
              y: { beginAtZero: true, ticks: { precision: 0 } }
            }
          } %>
    <% else %>
      <div class="flex flex-col items-center justify-center py-12 text-center">
        <p class="text-sm text-slate-500">Hakuna thamani iliyopotea kwa kipindi hiki. 🎉</p>
      </div>
    <% end %>
  </section>

</div>