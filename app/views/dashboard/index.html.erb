<div class="mx-auto max-w-7xl space-y-6">
  <div class="flex flex-wrap items-end justify-between gap-3"><div><h1 class="text-2xl font-bold">Repair Dashboard</h1><p class="text-slate-500">Sales and profit performance for the selected period.</p></div><div class="flex gap-2"><% %w[daily weekly monthly yearly].each do |period| %><%= link_to period.humanize, dashboard_path(period: period), class: "rounded-lg border px-3 py-2 text-sm #{'bg-slate-900 text-white' if @period == period}" %><% end %></div></div>
  <div class="grid gap-4 sm:grid-cols-2 lg:grid-cols-5"><% [["Sales", @sales], ["Gross profit", @gross_profit], ["Expenses", @expenses], ["Net profit", @net_profit]].each do |label, value| %><div class="rounded-xl border bg-white p-5 shadow-sm"><p class="text-sm text-slate-500"><%= label %></p><p class="mt-1 text-xl font-bold"><%= number_to_currency(value, unit: "TSh ", precision: 0) %></p></div><% end %><div class="rounded-xl border bg-white p-5 shadow-sm"><p class="text-sm text-slate-500">Repairs</p><p class="mt-1 text-xl font-bold"><%= @repair_count %></p><p class="text-xs text-slate-400"><%= @return_count %> returns · <%= @low_stock_count %> low stock</p></div></div>
  <div class="grid gap-6 lg:grid-cols-2"><section class="rounded-xl border bg-white p-6"><h2 class="mb-4 font-semibold">Sales by day</h2><div class="space-y-2"><% @sales_by_day.each do |date, amount| %><div class="flex justify-between border-b py-2 text-sm"><span><%= date %></span><strong><%= number_to_currency(amount, unit: "TSh ", precision: 0) %></strong></div><% end %></div></section><section class="rounded-xl border bg-white p-6"><h2 class="mb-4 font-semibold">Formula</h2><p class="text-sm leading-6 text-slate-600">Gross profit = Price − Labour charge − cost of spares used.</p><p class="mt-2 text-sm leading-6 text-slate-600">Net profit = Gross profit − operating expenses.</p></section></div>
</div>
