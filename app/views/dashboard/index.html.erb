<% content_for :title, "Repair Dashboard" %>

<div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8 py-8 space-y-6">

  <!-- ============ 1. Page header ============ -->
  <div class="flex flex-wrap items-end justify-between gap-4">
    <div>
      <h1 class="text-2xl font-semibold tracking-tight text-slate-900">Repair Dashboard</h1>
      <p class="mt-1 text-sm text-slate-500">Sales and profit performance for the selected period.</p>
    </div>

    <div class="flex flex-wrap items-center gap-2">
      <!-- Month Filter -->
      <%= form_with url: dashboard_path, method: :get,
          data: { turbo_frame: "dashboard_content", turbo_action: "advance" },
          class: "inline-block" do |f| %>
        <%= hidden_field_tag :period, @period %>
        <%= f.select :month,
            options_for_select([
              ["All Months", 0],
              ["January", 1], ["February", 2], ["March", 3],
              ["April", 4], ["May", 5], ["June", 6],
              ["July", 7], ["August", 8], ["September", 9],
              ["October", 10], ["November", 11], ["December", 12]
            ], params[:month]&.to_i || 0),
            {},
            onchange: "this.form.requestSubmit()",
            class: "rounded-md border border-slate-200 bg-white px-3 py-1.5 text-sm font-medium text-slate-700 shadow-sm focus:border-indigo-500 focus:ring-indigo-500/20 cursor-pointer" %>
      <% end %>

      <!-- Period switcher -->
      <div class="inline-flex items-center rounded-lg border border-slate-200 bg-white p-0.5 shadow-sm">
        <% %w[daily weekly monthly yearly].each do |period| %>
          <%= link_to period.humanize,
              dashboard_path(period: period, month: params[:month]),
              data: { turbo_frame: "dashboard_content", turbo_action: "advance" },
              class: "rounded-md px-3 py-1.5 text-sm font-medium transition #{@period == period ? 'bg-indigo-600 text-white shadow-sm' : 'text-slate-600 hover:text-slate-900 hover:bg-slate-50'}" %>
        <% end %>
      </div>
    </div>
  </div>

  <!-- ============ TURBO FRAME: Content ============ -->
  <%= turbo_frame_tag "dashboard_content" do %>
    <%= render "dashboard/content" %>
  <% end %>

</div>