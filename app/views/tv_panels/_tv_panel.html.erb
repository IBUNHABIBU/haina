<div id="<%= dom_id tv_panel %>" class="w-full sm:w-auto my-5 space-y-5">
  <div>
    <strong class="block font-medium mb-1">Tv brand:</strong>
    <%= tv_panel.tv_brand_id %>
  </div>
  <div>
    <strong class="block font-medium mb-1">Tv size:</strong>
    <%= tv_panel.tv_size_id %>
  </div>
  <div>
    <strong class="block font-medium mb-1">Customer:</strong>
    <%= tv_panel.customer_id %>
  </div>
  <div>
    <strong class="block font-medium mb-1">Buy price:</strong>
    <%= tv_panel.buy_price %>
  </div>
  <div>
    <strong class="block font-medium mb-1">Sell price:</strong>
    <%= tv_panel.sell_price %>
  </div>
  <div>
    <strong class="block font-medium mb-1">Status:</strong>
    <%= tv_panel.status %>
  </div>
  <div>
    <strong class="block font-medium mb-1">Sold at:</strong>
    <%= tv_panel.sold_at %>
  </div>
</div>
