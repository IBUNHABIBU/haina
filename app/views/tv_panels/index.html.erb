<% content_for :title, "Mabango (TV Panels)" %>

<div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8 py-8 space-y-6">
  <!-- Header -->
  <div class="flex flex-wrap items-end justify-between gap-4">
    <div>
      <h1 class="text-2xl font-semibold tracking-tight text-slate-900">Mabango (TV Panels)</h1>
      <p class="mt-1 text-sm text-slate-500">Simamia ununuzi na mauzo ya mabango.</p>
    </div>
    <%= link_to new_tv_panel_path, class: "inline-flex items-center gap-1.5 rounded-lg bg-indigo-600 px-4 py-2.5 text-sm font-semibold text-white shadow-sm hover:bg-indigo-500" do %>
      <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" d="M12 4.5v15m7.5-7.5h-15" /></svg>
      Ongeza Bango
    <% end %>
  </div>

  <!-- KPI Cards -->
  <div class="grid gap-4 sm:grid-cols-3">
    <div class="rounded-xl border border-slate-200 bg-white p-5 shadow-sm">
      <p class="text-xs font-medium uppercase tracking-wider text-slate-500">Zilizopo Stock</p>
      <p class="mt-3 text-2xl font-semibold text-slate-900"><%= @in_stock_count %></p>
    </div>
    <div class="rounded-xl border border-slate-200 bg-white p-5 shadow-sm">
      <p class="text-xs font-medium uppercase tracking-wider text-slate-500">Zilizouzwa</p>
      <p class="mt-3 text-2xl font-semibold text-slate-900"><%= @sold_count %></p>
    </div>
    <div class="rounded-xl border border-emerald-200 bg-emerald-50/40 p-5 shadow-sm">
      <p class="text-xs font-medium uppercase tracking-wider text-emerald-700">Faida ya Mabango</p>
      <p class="mt-3 text-2xl font-semibold text-emerald-700"><%= number_to_currency(@total_profit, unit: "TSh ", precision: 0) %></p>
    </div>
  </div>

  <!-- ===================== DESKTOP TABLE (md and up) ===================== -->
  <div class="hidden md:block overflow-hidden rounded-xl border border-slate-200 bg-white shadow-sm">
    <div class="overflow-x-auto">
      <table class="min-w-full divide-y divide-slate-200">
        <thead class="bg-slate-50">
          <tr>
            <th class="px-4 py-3 text-left text-xs font-semibold uppercase tracking-wider text-slate-500">Bango</th>
            <th class="px-4 py-3 text-left text-xs font-semibold uppercase tracking-wider text-slate-500">Muuzaji</th>
            <th class="px-4 py-3 text-right text-xs font-semibold uppercase tracking-wider text-slate-500">Bei ya Kununua</th>
            <th class="px-4 py-3 text-right text-xs font-semibold uppercase tracking-wider text-slate-500">Bei ya Kuuza</th>
            <th class="px-4 py-3 text-left text-xs font-semibold uppercase tracking-wider text-slate-500">Hali</th>
            <th class="px-4 py-3 text-right text-xs font-semibold uppercase tracking-wider text-slate-500">Faida</th>
            <th class="relative px-4 py-3"><span class="sr-only">Actions</span></th>
          </tr>
        </thead>
        <tbody class="divide-y divide-slate-100">
          <% @tv_panels.each do |panel| %>
            <!-- Row inabadilika rangi kama imeuzwa -->
            <tr class="group transition-colors duration-200 <%= panel.sold? ? 'bg-emerald-100 hover:bg-emerald-200' : 'hover:bg-slate-50' %>">
              <td class="px-4 py-3">
                <div class="text-sm font-medium text-slate-900"><%= panel.tv_brand.name %> <%= panel.tv_size.size %>"</div>
              </td>
              <td class="px-4 py-3 text-sm text-slate-600"><%= panel.customer.name %></td>
              <td class="px-4 py-3 text-right text-sm tabular-nums text-slate-600"><%= number_to_currency(panel.buy_price, unit: "TSh ", precision: 0) %></td>
              <td class="px-4 py-3 text-right text-sm tabular-nums text-slate-600"><%= number_to_currency(panel.sell_price, unit: "TSh ", precision: 0) %></td>
              <td class="px-4 py-3">
                <span class="inline-flex items-center rounded-full px-2.5 py-1 text-xs font-medium <%= panel.sold? ? 'bg-emerald-100 text-emerald-800' : 'bg-amber-100 text-amber-800' %>">
                  <%= panel.status&.humanize %>
                </span>
              </td>
              <td class="px-4 py-3 text-right text-sm font-semibold tabular-nums <%= panel.sold? ? 'text-emerald-600' : 'text-slate-400' %>">
                <%= panel.sold? ? number_to_currency(panel.profit, unit: "TSh ", precision: 0) : "—" %>
              </td>
              <td class="px-4 py-3 text-right">
                <div class="inline-flex items-center justify-end gap-1 opacity-70 transition group-hover:opacity-100">
                  <!-- Link ya Show (View) -->
                  <%= link_to tv_panel_path(panel), class: "rounded-lg p-1.5 text-indigo-600 transition hover:bg-indigo-50", title: "View" do %>
                    <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke-width="1.8" stroke="currentColor">
                      <path stroke-linecap="round" stroke-linejoin="round" d="M2.036 12.322a1.012 1.012 0 0 1 0-.639C3.423 7.51 7.36 4.5 12 4.5c4.638 0 8.573 3.007 9.963 7.178.07.207.07.431 0 .639C20.577 16.49 16.64 19.5 12 19.5c-4.638 0-8.573-3.007-9.963-7.178Z" />
                      <path stroke-linecap="round" stroke-linejoin="round" d="M15 12a3 3 0 1 1-6 0 3 3 0 0 1 6 0Z" />
                    </svg>
                  <% end %>
                  
                  <!-- Link ya Edit -->
                  <%= link_to edit_tv_panel_path(panel), class: "rounded-lg p-1.5 text-slate-500 transition hover:bg-slate-100", title: "Edit" do %>
                    <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke-width="1.8" stroke="currentColor">
                      <path stroke-linecap="round" stroke-linejoin="round" d="m16.862 4.487 1.687-1.688a1.875 1.875 0 1 1 2.652 2.652L10.582 16.07a4.5 4.5 0 0 1-1.897 1.13L6 18l.8-2.685a4.5 4.5 0 0 1 1.13-1.897l8.932-8.931Z" />
                    </svg>
                  <% end %>
                </div>
              </td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>
  </div>

  <!-- ===================== MOBILE CARDS (below md) ===================== -->
  <div class="md:hidden space-y-3">
    <% @tv_panels.each do |panel| %>
      <details class="group rounded-xl border <%= panel.sold? ? 'border-emerald-200 bg-emerald-50/70' : 'border-slate-200 bg-white' %> shadow-sm open:shadow-md transition-colors duration-200">
        <summary class="flex cursor-pointer items-center gap-3 px-4 py-3 list-none [&::-webkit-details-marker]:hidden">
          
          <div class="flex h-9 w-9 shrink-0 items-center justify-center rounded-full <%= panel.sold? ? 'bg-emerald-100 text-emerald-700' : 'bg-indigo-100 text-indigo-700' %>">
            <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke-width="1.8" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" d="M6 20.25h12m-7.5-3v3m3-3v3m-10.125-3h17.25c.621 0 1.125-.504 1.125-1.125V4.875c0-.621-.504-1.125-1.125-1.125H3.375c-.621 0-1.125.504-1.125 1.125v11.25c0 .621.504 1.125 1.125 1.125Z" />
            </svg>
          </div>

          <div class="min-w-0 flex-1">
            <p class="truncate text-sm font-semibold text-slate-900">
              <%= panel.tv_brand.name %> <%= panel.tv_size.size %>"
            </p>
            <p class="mt-0.5 text-xs text-slate-500">
              <%= panel.customer.name %>
            </p>
          </div>

          <div class="flex flex-col items-end gap-1">
            <span class="inline-flex items-center rounded-full px-2 py-0.5 text-[10px] font-medium <%= panel.sold? ? 'bg-emerald-100 text-emerald-800' : 'bg-amber-100 text-amber-800' %>">
              <%= panel.status&.humanize %>
            </span>
          </div>

          <svg class="h-4 w-4 shrink-0 text-slate-400 transition-transform duration-200 group-open:rotate-180" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" d="m19.5 8.25-7.5 7.5-7.5-7.5" />
          </svg>
        </summary>

        <div class="border-t border-slate-100 px-4 py-4 space-y-4">
          <dl class="grid grid-cols-2 gap-3 text-sm">
            <div>
              <dt class="text-[11px] font-semibold uppercase tracking-wider text-slate-500">Bei ya Kununua</dt>
              <dd class="mt-0.5 font-medium tabular-nums text-slate-900">
                <%= number_to_currency(panel.buy_price, unit: "TSh ", precision: 0) %>
              </dd>
            </div>
            <div>
              <dt class="text-[11px] font-semibold uppercase tracking-wider text-slate-500">Bei ya Kuuza</dt>
              <dd class="mt-0.5 font-medium tabular-nums text-slate-900">
                <%= number_to_currency(panel.sell_price, unit: "TSh ", precision: 0) %>
              </dd>
            </div>
            <div class="col-span-2 border-t border-slate-100 pt-2">
              <dt class="text-[11px] font-semibold uppercase tracking-wider text-slate-500">Faida</dt>
              <dd class="mt-0.5 font-semibold tabular-nums <%= panel.sold? ? 'text-emerald-600' : 'text-slate-400' %>">
                <%= panel.sold? ? number_to_currency(panel.profit, unit: "TSh ", precision: 0) : "—" %>
              </dd>
            </div>
          </dl>

          <div class="flex items-center gap-2 border-t border-slate-100 pt-3">
            <%= link_to "View Details", tv_panel_path(panel),
                class: "flex-1 inline-flex items-center justify-center gap-1.5 rounded-lg border border-slate-200 bg-white px-3 py-2 text-sm font-medium text-indigo-600 transition hover:bg-indigo-50" %>
            
            <%= link_to "Edit", edit_tv_panel_path(panel),
                class: "flex-1 inline-flex items-center justify-center gap-1.5 rounded-lg border border-slate-200 bg-white px-3 py-2 text-sm font-medium text-slate-700 transition hover:bg-slate-50" %>
          </div>
        </div>
      </details>
    <% end %>
  </div>

</div>