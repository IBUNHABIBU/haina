<% content_for :title, "Bango: #{@tv_panel.tv_brand.name} #{@tv_panel.tv_size.size}\"" %>

<div class="mx-auto max-w-4xl px-4 py-8 space-y-6">
  <!-- Header & Back Link -->
  <div>
    <%= link_to "← Rudi kwenye Mabango", tv_panels_path, class: "text-sm font-medium text-slate-500 hover:text-slate-900" %>
    <h1 class="mt-2 text-2xl font-semibold text-slate-900">
      <%= @tv_panel.tv_brand.name %> <%= @tv_panel.tv_size.size %>"
    </h1>
    <p class="text-sm text-slate-500">Muuzaji: <%= @tv_panel.customer.name %></p>
  </div>

  <div class="grid gap-6 md:grid-cols-2">
    <!-- Maelezo -->
    <div class="rounded-xl border border-slate-200 bg-white p-6 shadow-sm space-y-4">
      <h2 class="text-sm font-semibold text-slate-900 border-b border-slate-100 pb-2">Maelezo ya Bango</h2>
      
      <dl class="grid grid-cols-2 gap-4 text-sm">
        <div>
          <dt class="text-slate-500">Bei ya Kununua</dt>
          <dd class="font-medium text-slate-900"><%= number_to_currency(@tv_panel.buy_price, unit: "TSh ", precision: 0) %></dd>
        </div>
        <div>
          <dt class="text-slate-500">Bei ya Kuuza</dt>
          <dd class="font-medium text-slate-900"><%= number_to_currency(@tv_panel.sell_price, unit: "TSh ", precision: 0) %></dd>
        </div>
        <div>
          <dt class="text-slate-500">Hali</dt>
          <dd>
            <span class="inline-flex items-center rounded-full px-2.5 py-1 text-xs font-medium <%= @tv_panel.sold? ? 'bg-emerald-50 text-emerald-700' : 'bg-amber-50 text-amber-700' %>">
              <%= @tv_panel.status&.humanize %>
            </span>
          </dd>
        </div>
        <div>
          <dt class="text-slate-500">Faida</dt>
          <dd class="font-semibold <%= @tv_panel.sold? ? 'text-emerald-600' : 'text-slate-400' %>">
            <%= @tv_panel.sold? ? number_to_currency(@tv_panel.profit, unit: "TSh ", precision: 0) : "—" %>
          </dd>
        </div>
      </dl>

      <% if @tv_panel.remarks.present? %>
        <div class="border-t border-slate-100 pt-4">
          <dt class="text-slate-500 text-sm mb-1">Remarks</dt>
          <dd class="text-sm text-slate-800 bg-slate-50 p-3 rounded-lg"><%= simple_format(@tv_panel.remarks) %></dd>
        </div>
      <% end %>
    </div>

    <!-- Picha -->
    <div class="rounded-xl border border-slate-200 bg-white p-6 shadow-sm space-y-4">
      <h2 class="text-sm font-semibold text-slate-900 border-b border-slate-100 pb-2">Picha za Bango</h2>
      
      <div class="grid grid-cols-2 gap-4">
        <!-- Picha ya Mbele -->
        <div>
          <p class="text-xs font-semibold uppercase text-slate-500 mb-2">Mbele</p>
          <% if @tv_panel.front_image.attached? %>
            <%= image_tag @tv_panel.front_image, class: "rounded-lg border object-cover w-full h-40 cursor-pointer hover:opacity-90" %>
          <% else %>
            <div class="flex items-center justify-center h-40 bg-slate-50 rounded-lg border border-dashed text-slate-400 text-xs">Hakuna Picha</div>
          <% end %>
        </div>

        <!-- Picha ya Nyuma -->
        <div>
          <p class="text-xs font-semibold uppercase text-slate-500 mb-2">Nyuma</p>
          <% if @tv_panel.back_image.attached? %>
            <%= image_tag @tv_panel.back_image, class: "rounded-lg border object-cover w-full h-40 cursor-pointer hover:opacity-90" %>
          <% else %>
            <div class="flex items-center justify-center h-40 bg-slate-50 rounded-lg border border-dashed text-slate-400 text-xs">Hakuna Picha</div>
          <% end %>
        </div>
      </div>
    </div>
  </div>
</div>