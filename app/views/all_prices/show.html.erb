<% content_for :title, "Price Details" %>

<div class="mx-auto max-w-3xl px-4 sm:px-6 lg:px-8 py-8 space-y-6">
  
  <% if notice.present? %>
    <div class="flex items-center gap-2 rounded-lg border border-emerald-200 bg-emerald-50 px-4 py-3 text-sm font-medium text-emerald-700 shadow-sm" id="notice">
      <svg class="h-5 w-5 text-emerald-500" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor">
        <path stroke-linecap="round" stroke-linejoin="round" d="M9 12.75 11.25 15 15 9.75M21 12a9 9 0 1 1-18 0 9 9 0 0 1 18 0Z" />
      </svg>
      <%= notice %>
    </div>
  <% end %>

  <!-- Back link -->
  <div>
    <%= link_to all_prices_path, class: "inline-flex items-center gap-1.5 text-sm font-medium text-slate-500 transition hover:text-slate-900" do %>
      <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor">
        <path stroke-linecap="round" stroke-linejoin="round" d="M15.75 19.5 8.25 12l7.5-7.5" />
      </svg>
      Back to prices
    <% end %>
  </div>

  <!-- Header -->
  <div class="flex flex-wrap items-start justify-between gap-4">
    <div class="flex items-start gap-4">
      <div class="flex h-12 w-12 shrink-0 items-center justify-center rounded-xl bg-indigo-100 text-indigo-700">
        <svg class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke-width="1.8" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" d="M2.25 18.75a60.07 60.07 0 0 1 15.797 2.101c.727.198 1.453-.342 1.453-1.096V18.75M3.75 4.5v.75A.75.75 0 0 1 3 6h-.75m0 0v-.375c0-.621.504-1.125 1.125-1.125H20.25M2.25 6v9m18-10.5v.75c0 .414.336.75.75.75h.75m-1.5-1.5h.375c.621 0 1.125.504 1.125 1.125v9.75c0 .621-.504 1.125-1.125 1.125h-.375m1.5-1.5H21a.75.75 0 0 0-.75.75v.75m0 0H3.75m0 0h-.375a1.125 1.125 0 0 1-1.125-1.125V15m1.5 1.5v-.75A.75.75 0 0 0 3 15h-.75M15 10.5a3 3 0 1 1-6 0 3 3 0 0 1 6 0Zm3 0h.008v.008H18V10.5Zm-12 0h.008v.008H6V10.5Z" />
        </svg>
      </div>
      <div>
        <h1 class="text-2xl font-semibold tracking-tight text-slate-900">
          <%= @all_price.tv_size&.size ? "#{@all_price.tv_size.size} inch TV" : "Price Details" %>
        </h1>
        <p class="mt-1 text-sm text-slate-500">
          Price configuration for repairs of this TV size.
        </p>
      </div>
    </div>

    <div class="flex flex-wrap items-center gap-2">
      <%= link_to edit_all_price_path(@all_price),
          class: "inline-flex items-center gap-1.5 rounded-lg border border-slate-200 bg-white px-4 py-2.5 text-sm font-medium text-slate-700 shadow-sm transition hover:bg-slate-50" do %>
        <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke-width="1.8" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" d="m16.862 4.487 1.687-1.688a1.875 1.875 0 1 1 2.652 2.652L10.582 16.07a4.5 4.5 0 0 1-1.897 1.13L6 18l.8-2.685a4.5 4.5 0 0 1 1.13-1.897l8.932-8.931Z" />
        </svg>
        Edit
      <% end %>
    </div>
  </div>

  <%# ============================================================
      KPI CARDS
      ============================================================ %>
  <div class="grid gap-4 sm:grid-cols-3">
    
    <!-- TV Size -->
    <div class="rounded-xl border border-slate-200 bg-white p-5 shadow-sm">
      <div class="flex items-center justify-between">
        <p class="text-xs font-medium uppercase tracking-wider text-slate-500">TV Size</p>
        <div class="flex h-8 w-8 items-center justify-center rounded-lg bg-indigo-50 text-indigo-600">
          <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke-width="1.8" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" d="M6 20.25h12m-7.5-3v3m3-3v3m-10.125-3h17.25c.621 0 1.125-.504 1.125-1.125V4.875c0-.621-.504-1.125-1.125-1.125H3.375c-.621 0-1.125.504-1.125 1.125v11.25c0 .621.504 1.125 1.125 1.125Z" />
          </svg>
        </div>
      </div>
      <p class="mt-3 text-2xl font-semibold tabular-nums text-slate-900">
        <%= @all_price.tv_size&.size ? "#{@all_price.tv_size.size}\"" : "—" %>
      </p>
      <p class="mt-1 text-xs text-slate-400">Screen size</p>
    </div>

    <!-- Number of COF -->
    <div class="rounded-xl border border-slate-200 bg-white p-5 shadow-sm">
      <div class="flex items-center justify-between">
        <p class="text-xs font-medium uppercase tracking-wider text-slate-500">Idadi ya COF</p>
        <div class="flex h-8 w-8 items-center justify-center rounded-lg bg-blue-50 text-blue-600">
          <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke-width="1.8" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" d="M3.75 6A2.25 2.25 0 0 1 6 3.75h2.25A2.25 2.25 0 0 1 10.5 6v2.25a2.25 2.25 0 0 1-2.25 2.25H6a2.25 2.25 0 0 1-2.25-2.25V6ZM3.75 15.75A2.25 2.25 0 0 1 6 13.5h2.25a2.25 2.25 0 0 1 2.25 2.25V18a2.25 2.25 0 0 1-2.25 2.25H6A2.25 2.25 0 0 1 3.75 18v-2.25ZM13.5 6a2.25 2.25 0 0 1 2.25-2.25H18A2.25 2.25 0 0 1 20.25 6v2.25A2.25 2.25 0 0 1 18 10.5h-2.25a2.25 2.25 0 0 1-2.25-2.25V6ZM13.5 15.75a2.25 2.25 0 0 1 2.25-2.25H18a2.25 2.25 0 0 1 2.25 2.25V18A2.25 2.25 0 0 1 18 20.25h-2.25A2.25 2.25 0 0 1 13.5 18v-2.25Z" />
          </svg>
        </div>
      </div>
      <p class="mt-3 text-2xl font-semibold tabular-nums text-slate-900">
        <%= @all_price.idadiyacof.presence || "—" %>
      </p>
      <p class="mt-1 text-xs text-slate-400">COF count</p>
    </div>

    <!-- Profit Margin -->
    <% technician = @all_price.technician_price.to_f %>
    <% customer = @all_price.customer_price.to_f %>
    <% margin = customer - technician %>
    <div class="rounded-xl border p-5 shadow-sm <%= margin.positive? ? 'border-emerald-200 bg-emerald-50/40' : 'border-slate-200 bg-white' %>">
      <div class="flex items-center justify-between">
        <p class="text-xs font-medium uppercase tracking-wider <%= margin.positive? ? 'text-emerald-700' : 'text-slate-500' %>">
          Profit Margin
        </p>
        <div class="flex h-8 w-8 items-center justify-center rounded-lg <%= margin.positive? ? 'bg-emerald-100 text-emerald-600' : 'bg-slate-100 text-slate-600' %>">
          <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke-width="1.8" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" d="M2.25 18 9 11.25l4.306 4.306a11.95 11.95 0 0 1 5.814-5.518l2.74-1.22m0 0-5.94-2.281m5.94 2.28-2.28 5.941" />
          </svg>
        </div>
      </div>
      <p class="mt-3 text-2xl font-semibold tabular-nums tracking-tight <%= margin.positive? ? 'text-emerald-700' : 'text-slate-900' %>">
        <%= number_to_currency(margin, unit: "TSh ", precision: 0) %>
      </p>
      <p class="mt-1 text-xs <%= margin.positive? ? 'text-emerald-600' : 'text-slate-400' %>">
        Customer − Technician
      </p>
    </div>
  </div>

  <%# ============================================================
      DETAILS
      ============================================================ %>
  <section class="overflow-hidden rounded-xl border border-slate-200 bg-white shadow-sm">
    <header class="flex items-center gap-3 border-b border-slate-100 px-6 py-4">
      <div class="flex h-8 w-8 items-center justify-center rounded-lg bg-slate-100 text-slate-600">
        <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke-width="1.8" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" d="M8.25 6.75h12M8.25 12h12m-12 5.25h12M3.75 6.75h.007v.008H3.75V6.75Zm.375 0a.375.375 0 1 1-.75 0 .375.375 0 0 1 .75 0ZM3.75 12h.007v.008H3.75V12Zm.375 0a.375.375 0 1 1-.75 0 .375.375 0 0 1 .75 0Zm-.375 5.25h.007v.008H3.75v-.008Zm.375 0a.375.375 0 1 1-.75 0 .375.375 0 0 1 .75 0Z" />
        </svg>
      </div>
      <div>
        <h2 class="text-sm font-semibold text-slate-900">Pricing Details</h2>
        <p class="text-xs text-slate-500">Technician and customer pricing breakdown.</p>
      </div>
    </header>

    <dl class="divide-y divide-slate-100">
      <div class="flex items-center justify-between px-6 py-3.5 text-sm">
        <dt class="text-slate-500">TV Size</dt>
        <dd class="font-medium text-slate-900">
          <%= @all_price.tv_size&.size ? "#{@all_price.tv_size.size} in" : "—" %>
        </dd>
      </div>
      <div class="flex items-center justify-between px-6 py-3.5 text-sm">
        <dt class="text-slate-500">Idadi ya COF</dt>
        <dd class="font-medium text-slate-900"><%= @all_price.idadiyacof.presence || "—" %></dd>
      </div>
      <div class="flex items-center justify-between px-6 py-3.5 text-sm">
        <dt class="text-slate-500">Technician Price</dt>
        <dd class="font-medium tabular-nums text-slate-900">
          <%= number_to_currency(@all_price.technician_price, unit: "TSh ", precision: 0) %>
        </dd>
      </div>
      <div class="flex items-center justify-between px-6 py-3.5 text-sm">
        <dt class="text-slate-500">Customer Price</dt>
        <dd class="font-semibold tabular-nums text-slate-900">
          <%= number_to_currency(@all_price.customer_price, unit: "TSh ", precision: 0) %>
        </dd>
      </div>
      <div class="flex items-center justify-between px-6 py-3.5 text-sm bg-slate-50/50">
        <dt class="font-medium text-slate-700">Gross Margin</dt>
        <dd class="font-bold tabular-nums <%= margin.positive? ? 'text-emerald-700' : 'text-rose-700' %>">
          <%= number_to_currency(margin, unit: "TSh ", precision: 0) %>
        </dd>
      </div>
    </dl>
  </section>

  <%# ============================================================
      DANGER ZONE
      ============================================================ %>
  <% if current_user&.super_admin? %>
    <div class="rounded-xl border border-rose-200 bg-rose-50/40 p-6 shadow-sm">
      <div class="flex flex-wrap items-center justify-between gap-4">
        <div>
          <h2 class="text-sm font-semibold text-rose-800">Delete this price</h2>
          <p class="mt-1 text-xs text-rose-600">This pricing configuration will be permanently removed.</p>
        </div>

        <%= button_to @all_price, method: :delete,
            data: { turbo_confirm: "Are you sure you want to delete this price?", turbo_frame: "_top" },
            class: "inline-flex items-center gap-1.5 rounded-lg bg-rose-600 px-4 py-2.5 text-sm font-semibold text-white shadow-sm transition hover:bg-rose-500 cursor-pointer" do %>
          <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke-width="1.8" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" d="m14.74 9-.346 9m-4.788 0L9.26 9m9.968-3.21c.342.052.682.107 1.022.166m-1.022-.165L18.16 19.673a2.25 2.25 0 0 1-2.244 2.077H8.084a2.25 2.25 0 0 1-2.244-2.077L4.772 5.79m14.456 0a48.108 48.108 0 0 0-3.478-.397m-12 .562c.34-.059.68-.114 1.022-.165m0 0a48.11 48.11 0 0 1 3.478-.397m7.5 0v-.916c0-1.18-.91-2.164-2.09-2.201a51.964 51.964 0 0 0-3.32 0c-1.18.037-2.09 1.022-2.09 2.201v.916m7.5 0a48.667 48.667 0 0 0-7.5 0" />
          </svg>
          Delete Price
        <% end %>
      </div>
    </div>
  <% end %>

</div>