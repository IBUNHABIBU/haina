<div class="mx-auto max-w-4xl"><h1 class="mb-6 text-2xl font-bold">Spare Categories</h1><div class="grid gap-6 md:grid-cols-2"><section class="rounded-xl border bg-white p-6"><h2 class="mb-4 font-semibold">Add category</h2><%= form_with model: @spare_category, class: "space-y-4" do |form| %><%= form.text_field :name, placeholder: "e.g. T-Con", class: "field" %><%= form.text_field :code, placeholder: "e.g. TCON", class: "field" %><%= form.text_area :description, placeholder: "Description", class: "field" %><%= form.submit "Add category", class: "rounded-lg bg-blue-600 px-4 py-2 font-medium text-white" %><% end %></section><section class="rounded-xl border bg-white p-6"><h2 class="mb-4 font-semibold">Categories</h2><div class="space-y-3"><% @spare_categories.each do |category| %><div class="flex items-center justify-between border-b pb-3"><div><p class="font-medium"><%= category.name %></p><p class="text-xs text-slate-500"><%= category.code %> · <%= category.spares.count %> spares</p></div><%= link_to "Edit", edit_spare_category_path(category), class: "text-blue-600" %></div><% end %></div></section></div></div>
