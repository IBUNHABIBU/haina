<div class="mx-auto max-w-2xl"><h1 class="mb-6 text-2xl font-bold">Edit Spare Category</h1><%= form_with model: @spare_category, class: "space-y-4" do |form| %><%= form.text_field :name, class: "field" %><%= form.text_field :code, class: "field" %><%= form.text_area :description, class: "field" %><%= form.submit class: "rounded-lg bg-blue-600 px-4 py-2 text-white" %><% end %></div>
