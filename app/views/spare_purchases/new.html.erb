<div class="mx-auto max-w-3xl"><h1 class="mb-2 text-2xl font-bold">Purchase Spare Stock</h1><p class="mb-6 text-slate-500"><%= @spare.name %></p><%= form_with model: [@spare, @purchase], class: "space-y-5" do |form| %><% if @purchase.errors.any? %><div class="rounded-lg bg-red-50 p-4 text-red-700"><%= @purchase.errors.full_messages.to_sentence %></div><% end %><div class="grid gap-5 md:grid-cols-2"><div><%= form.label :quantity, class: "label" %><%= form.number_field :quantity, min: 1, class: "field" %></div><div><%= form.label :unit_cost, "Unit cost (TSh)", class: "label" %><%= form.number_field :unit_cost, step: 0.01, min: 0, class: "field" %></div><div><%= form.label :supplier, class: "label" %><%= form.text_field :supplier, class: "field" %></div><div><%= form.label :purchased_on, class: "label" %><%= form.date_field :purchased_on, class: "field" %></div><div><%= form.label :reference, class: "label" %><%= form.text_field :reference, class: "field" %></div></div><div><%= form.label :notes, class: "label" %><%= form.text_area :notes, rows: 3, class: "field" %></div><%= form.submit "Record purchase", class: "rounded-lg bg-blue-600 px-5 py-2.5 font-medium text-white" %><% end %></div>
