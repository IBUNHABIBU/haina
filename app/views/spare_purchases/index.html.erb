<div class="mx-auto max-w-5xl"><div class="mb-6 flex items-center justify-between"><div><h1 class="text-2xl font-bold">Purchases: <%= @spare.name %></h1><p class="text-slate-500">Stock purchases are also recorded as spare expenses.</p></div><%= link_to "Record Purchase", new_spare_spare_purchase_path(@spare), class: "rounded-lg bg-blue-600 px-4 py-2.5 text-white" %></div><div class="overflow-x-auto rounded-xl border bg-white"><table class="min-w-full divide-y"><thead class="bg-slate-50"><tr><th class="px-4 py-3 text-left">Date</th><th class="px-4 py-3 text-left">Supplier</th><th class="px-4 py-3 text-right">Qty</th><th class="px-4 py-3 text-right">Unit cost</th><th class="px-4 py-3 text-right">Total</th></tr></thead><tbody class="divide-y"><% @purchases.each do |purchase| %><tr><td class="px-4 py-3"><%= purchase.purchased_on %></td><td class="px-4 py-3"><%= purchase.supplier.presence || "—" %></td><td class="px-4 py-3 text-right"><%= purchase.quantity %></td><td class="px-4 py-3 text-right"><%= number_to_currency(purchase.unit_cost, unit: "TSh ", precision: 0) %></td><td class="px-4 py-3 text-right font-semibold"><%= number_to_currency(purchase.total_cost, unit: "TSh ", precision: 0) %></td></tr><% end %></tbody></table></div></div>
